diff --git a/node/collector_test.go b/node/collector_test.go
new file mode 100644
index 0000000..e288a5b
--- /dev/null
+++ b/node/collector_test.go
@@ -0,0 +1,35 @@
+package node
+
+import (
+	"testing"
+
+	"github.com/coroot/coroot-node-agent/node/metadata"
+)
+
+func TestResolveInstanceMetadataSkipsDiscoveryForDeclaredProvider(t *testing.T) {
+	discoveryCalled := false
+	md := resolveInstanceMetadata(metadata.Overrides{Provider: "Hetzner"}, func() *metadata.CloudMetadata {
+		discoveryCalled = true
+		return &metadata.CloudMetadata{Provider: metadata.CloudProviderAWS}
+	})
+	if discoveryCalled {
+		t.Fatal("metadata discovery must be skipped when the provider is declared")
+	}
+	if md.Provider != metadata.CloudProviderHetzner {
+		t.Fatalf("provider = %q, want %q", md.Provider, metadata.CloudProviderHetzner)
+	}
+}
+
+func TestResolveInstanceMetadataDiscoversWhenProviderIsUnknown(t *testing.T) {
+	discoveryCalled := false
+	md := resolveInstanceMetadata(metadata.Overrides{}, func() *metadata.CloudMetadata {
+		discoveryCalled = true
+		return &metadata.CloudMetadata{Provider: metadata.CloudProviderAWS}
+	})
+	if !discoveryCalled {
+		t.Fatal("metadata discovery must run when the provider is not declared")
+	}
+	if md.Provider != metadata.CloudProviderAWS {
+		t.Fatalf("provider = %q, want %q", md.Provider, metadata.CloudProviderAWS)
+	}
+}
diff --git a/node/net_dump_linux_test.go b/node/net_dump_linux_test.go
new file mode 100644
index 0000000..10a0bff
--- /dev/null
+++ b/node/net_dump_linux_test.go
@@ -0,0 +1,120 @@
+package node
+
+import (
+	"errors"
+	"net"
+	"testing"
+
+	"github.com/vishvananda/netlink"
+	"github.com/vishvananda/netlink/nl"
+	"golang.org/x/sys/unix"
+)
+
+// scriptedNetlinkDump supplies partial and complete kernel responses without
+// changing the host network namespace or requiring elevated test permissions.
+type scriptedNetlinkDump struct {
+	links     func() ([]netlink.Link, error)
+	addresses func(netlink.Link, int) ([]netlink.Addr, error)
+}
+
+func (s scriptedNetlinkDump) LinkList() ([]netlink.Link, error) {
+	return s.links()
+}
+
+func (s scriptedNetlinkDump) AddrList(link netlink.Link, family int) ([]netlink.Addr, error) {
+	return s.addresses(link, family)
+}
+
+// TestNetDeviceDumpRecovery exercises both production API call sites and proves
+// partial interface or address data never escapes a failed dump.
+func TestNetDeviceDumpRecovery(t *testing.T) {
+	permission := errors.New("permission denied")
+	for _, tc := range []struct {
+		name     string
+		stage    string
+		failures int
+		err      error
+		wantErr  error
+	}{
+		{name: "links recover", stage: "links", failures: 1, err: nl.ErrDumpInterrupted},
+		{name: "addresses recover", stage: "addresses", failures: 1, err: nl.ErrDumpInterrupted},
+		{name: "links exhausted", stage: "links", failures: 3, err: nl.ErrDumpInterrupted, wantErr: nl.ErrDumpInterrupted},
+		{name: "addresses exhausted", stage: "addresses", failures: 3, err: nl.ErrDumpInterrupted, wantErr: nl.ErrDumpInterrupted},
+		{name: "links refuse unrelated", stage: "links", failures: 1, err: permission, wantErr: permission},
+		{name: "addresses refuse unrelated", stage: "addresses", failures: 1, err: permission, wantErr: permission},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			linkCalls, addressCalls := 0, 0
+			goodLink := &netlink.Dummy{LinkAttrs: netlink.LinkAttrs{
+				Name: "eth0", OperState: netlink.OperUp,
+				Statistics: &netlink.LinkStatistics{RxBytes: 12, TxBytes: 34, RxPackets: 5, TxPackets: 6},
+			}}
+			partialLink := &netlink.Dummy{LinkAttrs: netlink.LinkAttrs{Name: "eth99"}}
+			handle := scriptedNetlinkDump{
+				links: func() ([]netlink.Link, error) {
+					linkCalls++
+					if tc.stage == "links" && linkCalls <= tc.failures {
+						return []netlink.Link{partialLink}, tc.err
+					}
+					return []netlink.Link{goodLink}, nil
+				},
+				addresses: func(link netlink.Link, _ int) ([]netlink.Addr, error) {
+					addressCalls++
+					if link != goodLink {
+						t.Fatal("address lookup consumed a partial link response")
+					}
+					if tc.stage == "addresses" && addressCalls <= tc.failures {
+						return []netlink.Addr{{IPNet: &net.IPNet{IP: net.ParseIP("203.0.113.9").To4(), Mask: net.CIDRMask(24, 32)}}}, tc.err
+					}
+					return []netlink.Addr{{IPNet: &net.IPNet{IP: net.ParseIP("192.0.2.3").To4(), Mask: net.CIDRMask(24, 32)}}}, nil
+				},
+			}
+			got, err := netDevicesFromHandle(handle)
+			if !errors.Is(err, tc.wantErr) {
+				t.Fatalf("error = %v, want %v", err, tc.wantErr)
+			}
+			if tc.wantErr != nil {
+				if got != nil {
+					t.Fatalf("partial network snapshot escaped with error: %v", got)
+				}
+			} else if len(got) != 1 || got[0].Name != "eth0" || got[0].Up != 1 || got[0].RxBytes != 12 || len(got[0].IPPrefixes) != 1 || got[0].IPPrefixes[0].IP().String() != "192.0.2.3" {
+				t.Fatalf("not the complete final network snapshot: %v", got)
+			}
+			calls := linkCalls
+			if tc.stage == "addresses" {
+				calls = addressCalls
+			}
+			wantCalls := tc.failures
+			if tc.wantErr == nil {
+				wantCalls++
+			}
+			if calls != wantCalls {
+				t.Fatalf("API calls = %d, want %d", calls, wantCalls)
+			}
+		})
+	}
+}
+
+// TestNetDeviceDumpReadsRealKernel runs the production collection path against
+// read-only route-netlink queries in the test process's existing namespace.
+func TestNetDeviceDumpReadsRealKernel(t *testing.T) {
+	handle, err := netlink.NewHandle(unix.NETLINK_ROUTE)
+	if err != nil {
+		t.Fatal("cannot open the read-only route-netlink handle:", err)
+	}
+	defer handle.Delete()
+	devices, err := netDevicesFromHandle(handle)
+	if err != nil {
+		t.Fatal("cannot collect a complete real-kernel network snapshot:", err)
+	}
+	if len(devices) == 0 {
+		t.Fatal("the Linux validation runner returned no supported network interface")
+	}
+	seen := make(map[string]bool)
+	for _, device := range devices {
+		if device.Name == "" || seen[device.Name] {
+			t.Fatal("the real-kernel snapshot contains an empty or duplicate interface")
+		}
+		seen[device.Name] = true
+	}
+}
diff --git a/node/net_dump_retry.go b/node/net_dump_retry.go
new file mode 100644
index 0000000..f2a1e95
--- /dev/null
+++ b/node/net_dump_retry.go
@@ -0,0 +1,21 @@
+package node
+
+import "errors"
+
+// retryNetlinkDump reads one complete kernel dump. Interrupted snapshots must
+// never contribute data to a later successful attempt.
+func retryNetlinkDump[T any](read func() (T, error), interrupted error) (T, error) {
+	var zero T
+	var err error
+	for attempt := 0; attempt < 3; attempt++ {
+		var result T
+		result, err = read()
+		if err == nil {
+			return result, nil
+		}
+		if !errors.Is(err, interrupted) {
+			return zero, err
+		}
+	}
+	return zero, err
+}
diff --git a/node/net_dump_retry_test.go b/node/net_dump_retry_test.go
new file mode 100644
index 0000000..765deda
--- /dev/null
+++ b/node/net_dump_retry_test.go
@@ -0,0 +1,55 @@
+package node
+
+import (
+	"errors"
+	"fmt"
+	"reflect"
+	"testing"
+)
+
+// TestRetryNetlinkDump requires a complete result, a bounded recovery attempt,
+// and immediate propagation of errors unrelated to interrupted kernel dumps.
+func TestRetryNetlinkDump(t *testing.T) {
+	interrupted := errors.New("interrupted kernel dump")
+	permission := errors.New("permission denied")
+	lookalike := errors.New(interrupted.Error())
+	for _, tc := range []struct {
+		name      string
+		failures  []error
+		wantCalls int
+		wantError error
+	}{
+		{name: "complete first result", wantCalls: 1},
+		{name: "recover one interruption", failures: []error{interrupted}, wantCalls: 2},
+		{name: "recover wrapped interruption", failures: []error{fmt.Errorf("dump: %w", interrupted)}, wantCalls: 2},
+		{name: "recover final bounded attempt", failures: []error{interrupted, interrupted}, wantCalls: 3},
+		{name: "exhausted interruption", failures: []error{interrupted, interrupted, interrupted}, wantCalls: 3, wantError: interrupted},
+		{name: "unrelated error", failures: []error{permission}, wantCalls: 1, wantError: permission},
+		{name: "unrelated error after interruption", failures: []error{interrupted, permission}, wantCalls: 2, wantError: permission},
+		{name: "text alone is not interruption", failures: []error{lookalike}, wantCalls: 1, wantError: lookalike},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			calls := 0
+			got, err := retryNetlinkDump(func() ([]int, error) {
+				calls++
+				if calls <= len(tc.failures) {
+					return []int{99}, tc.failures[calls-1]
+				}
+				return []int{1, 2}, nil
+			}, interrupted)
+			if calls != tc.wantCalls {
+				t.Errorf("read calls = %d, want %d", calls, tc.wantCalls)
+			}
+			if !errors.Is(err, tc.wantError) {
+				t.Errorf("error = %v, want %v", err, tc.wantError)
+			}
+			if tc.wantError != nil {
+				if got != nil {
+					t.Errorf("partial data escaped with error: %v", got)
+				}
+			} else if !reflect.DeepEqual(got, []int{1, 2}) {
+				t.Errorf("result = %v, want complete snapshot [1 2]", got)
+			}
+		})
+	}
+}
