+func TestCheckAlertRetiresWhenReportNoLongerApplies(t *testing.T) {
+	for _, suppressed := range []bool{false, true} {
+		t.Run(map[bool]string{false: "active", true: "suppressed"}[suppressed], func(t *testing.T) {
+			database, project, watcher, world, app, rule, alert := firingPostgresAlert(t)
+			if suppressed {
+				require.NoError(t, database.SuppressAlerts(project.Id, []string{alert.Id}, "test"))
+			}
+			// The application keeps running and stays observed, but is no longer a database.
+			addInstance(world, app, true, true)
+			app.Reports = nil
+			auditor.Audit(world, project, nil, nil)
+			for _, r := range app.Reports {
+				require.NotEqual(t, model.AuditReportPostgres, r.Name)
+			}
+			watcher.Check(project, world, world.Ctx.From, world.Ctx.To, world.Ctx.Step)
+			after, err := database.GetAlert(project.Id, alert.Id)
+			require.NoError(t, err)
+			require.NotZero(t, after.ResolvedAt, "an observed application without the report no longer has the condition")
+			require.False(t, after.Suppressed, "a retired alert must not stay suppressed")
+			resolvedAt := after.ResolvedAt
+
+			// Repeated evaluation leaves the retirement untouched.
+			watcher.Check(project, world, world.Ctx.From, world.Ctx.To, world.Ctx.Step)
+			after, err = database.GetAlert(project.Id, alert.Id)
+			require.NoError(t, err)
+			require.Equal(t, resolvedAt, after.ResolvedAt)
+
+			// A returning report that fails opens a new alert without an intervening OK.
+			app.Reports = []*model.AuditReport{{Name: model.AuditReportPostgres, Checks: []*model.Check{{Id: rule.Source.Check.CheckId, Status: model.WARNING, Message: "synthetic failure"}}}}
+			watcher.Check(project, world, world.Ctx.From, world.Ctx.To, world.Ctx.Step)
+			reopened, err := database.GetActiveOrSuppressedAlertByFingerprint(project.Id, alert.Fingerprint)
+			require.NoError(t, err)
+			require.NotNil(t, reopened)
+			require.NotEqual(t, alert.Id, reopened.Id)
+			require.Zero(t, reopened.ResolvedAt)
+		})
+	}
+}
