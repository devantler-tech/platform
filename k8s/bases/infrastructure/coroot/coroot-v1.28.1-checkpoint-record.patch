+func firingCheckAlert(t *testing.T, checkId model.CheckId, report model.AuditReportName) (*db.DB, *db.Project, *Alerts, *model.World, *model.Application, *model.AlertingRule, *model.Alert) {
+	t.Helper()
+	database, project, watcher, world, app, rule := checkAlertFixture(t)
+	rule.Source.Check.CheckId = checkId
+	require.NoError(t, database.UpdateAlertingRule(project.Id, rule))
+	app.Reports = []*model.AuditReport{{Name: report, Checks: []*model.Check{{Id: checkId, Status: model.WARNING, Message: "synthetic failure"}}}}
+	watcher.Check(project, world, world.Ctx.From, world.Ctx.To, world.Ctx.Step)
+	alerts, err := database.GetLatestAlertsByRule(project.Id, string(rule.Id))
+	require.NoError(t, err)
+	require.Len(t, alerts, 1)
+	require.Equal(t, report, alerts[0].Report)
+	return database, project, watcher, world, app, rule, alerts[0]
+}
