+// retireInapplicableCheckAlert resolves a check alert whose report no longer applies to the
+// application. Absence alone is not evidence: a check can also be missing because its telemetry
+// is. The alert is retired only when it records the report that produced it, that report is one
+// whose absence establishes non-applicability (see absenceMeansNotApplicable), a fresh audit no
+// longer creates it, and at least one current instance is observed running on a node whose agent
+// is reporting. Applications without observed instances, and collector outages, keep the alert.
+func (w *Alerts) retireInapplicableCheckAlert(project *db.Project, rule *model.AlertingRule, app *model.Application, now timeseries.Time) {
+	fingerprint := calcFingerprint(string(rule.Id), app.Id.String(), nil)
+	alert, err := w.db.GetActiveOrSuppressedAlertByFingerprint(project.Id, fingerprint)
+	if err != nil {
+		klog.Errorln("failed to get alert:", err)
+		return
+	}
+	if alert == nil || !reportNoLongerApplies(app, alert.Report) {
+		return
+	}
+	if alert.ResolvedAt == 0 {
+		alert.ResolvedAt = now
+		if err := w.db.ResolveAlert(project.Id, alert.Id, now); err != nil {
+			klog.Errorln("failed to resolve inapplicable alert:", err)
+			return
+		}
+		w.notifier.Enqueue(project, app, alert, rule, now)
+	}
+	// A retired alert must not stay suppressed: the fingerprint lookup would keep returning it,
+	// and a later failure of a returning report would be swallowed instead of opening an alert.
+	if alert.Suppressed {
+		if err := w.db.ClearSuppression(project.Id, fingerprint); err != nil {
+			klog.Errorln("failed to clear suppression:", err)
+		}
+	}
+}
+
+// absenceMeansNotApplicable lists the reports whose auditor keeps an UNKNOWN report while the
+// application type is still detected without instrumentation, so a missing report means the type
+// itself is gone. Reports built only from their own instrumentation (for example JVM) disappear
+// when that instrumentation does, and are deliberately absent from this list.
+var absenceMeansNotApplicable = map[model.AuditReportName]bool{
+	model.AuditReportPostgres:  true,
+	model.AuditReportMysql:     true,
+	model.AuditReportRedis:     true,
+	model.AuditReportMongodb:   true,
+	model.AuditReportMemcached: true,
+}
+
+func reportNoLongerApplies(app *model.Application, report model.AuditReportName) bool {
+	if !absenceMeansNotApplicable[report] {
+		return false
+	}
+	for _, r := range app.Reports {
+		if r.Name == report {
+			return false
+		}
+	}
+	for _, i := range app.Instances {
+		if i.IsObsolete() {
+			continue
+		}
+		if i.IsUp() && i.Node != nil && i.Node.IsUp() {
+			return true
+		}
+	}
+	return false
+}
