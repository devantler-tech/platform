+// observedSeries is a synthetic series whose recent points are present, so TailIsEmpty is false.
+func observedSeries(world *model.World) *timeseries.TimeSeries {
+	points := int((world.Ctx.To - world.Ctx.From) / timeseries.Time(world.Ctx.Step))
+	data := make([]float32, points)
+	for i := range data {
+		data[i] = 1
+	}
+	return timeseries.NewWithData(world.Ctx.From, world.Ctx.Step, data)
+}
+
+// addInstance gives the application one instance whose container and node agent may each be observed.
+func addInstance(world *model.World, app *model.Application, containerObserved, agentObserved bool, types ...model.ApplicationType) {
+	node := model.NewNode("test-cluster", model.NewNodeId("machine-1", "uuid-1"))
+	if agentObserved {
+		series := observedSeries(world)
+		node.Name.Update(series, "node-1")
+		node.CpuUsagePercent = series
+	}
+	instance := app.GetOrCreateInstance("service-1", node)
+	container := instance.GetOrCreateContainer("container-1", "service")
+	if containerObserved {
+		container.MemoryRss = observedSeries(world)
+	}
+	for _, t := range types {
+		container.ApplicationTypes[t] = true
+	}
+}
