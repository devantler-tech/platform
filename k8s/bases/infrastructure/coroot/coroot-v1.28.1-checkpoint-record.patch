+func TestCheckAlertMissingDataIsNotRetirement(t *testing.T) {
+	for _, tc := range []struct {
+		name              string
+		check             model.CheckId
+		report            model.AuditReportName
+		containerObserved bool
+		agentObserved     bool
+		types             []model.ApplicationType
+		forgetReport      bool
+	}{
+		{name: "no instances"},
+		{name: "collector outage on the node", containerObserved: true},
+		{name: "container not observed", agentObserved: true},
+		{name: "database without its instrumentation (UNKNOWN report)", containerObserved: true, agentObserved: true, types: []model.ApplicationType{model.ApplicationTypePostgres}},
+		{name: "alert without a recorded report", containerObserved: true, agentObserved: true, forgetReport: true},
+		{name: "JVM metrics missing from an observed application", check: model.Checks.JvmAvailability.Id, report: model.AuditReportJvm, containerObserved: true, agentObserved: true},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			check, report := tc.check, tc.report
+			if check == "" {
+				check, report = model.Checks.PostgresAvailability.Id, model.AuditReportPostgres
+			}
+			database, project, watcher, world, app, _, alert := firingCheckAlert(t, check, report)
+			if tc.forgetReport {
+				_, err := database.Exec("UPDATE alert SET report = '' WHERE id = $1", alert.Id)
+				require.NoError(t, err)
+			}
+			if tc.containerObserved || tc.agentObserved {
+				addInstance(world, app, tc.containerObserved, tc.agentObserved, tc.types...)
+			}
+			app.Reports = nil
+			auditor.Audit(world, project, nil, nil)
+			missing, _ := app.GetCheckWithReport(check)
+			require.Nil(t, missing)
+			if len(tc.types) > 0 {
+				var kept *model.AuditReport
+				for _, r := range app.Reports {
+					if r.Name == report {
+						kept = r
+					}
+				}
+				require.NotNil(t, kept, "the auditor keeps the report for an uninstrumented database")
+				require.Equal(t, model.UNKNOWN, kept.Status)
+			}
+			watcher.Check(project, world, world.Ctx.From, world.Ctx.To, world.Ctx.Step)
+			after, err := database.GetAlert(project.Id, alert.Id)
+			require.NoError(t, err)
+			require.Zero(t, after.ResolvedAt, "missing data must keep the alert visible")
+		})
+	}
