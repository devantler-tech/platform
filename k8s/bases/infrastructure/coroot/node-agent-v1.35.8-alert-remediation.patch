@@ -0,0 +1,24 @@
+package ebpftracer
+
+import (
+	"errors"
+	"testing"
+)
+
+func TestExpectedCapabilityErrors(t *testing.T) {
+	tests := []struct {
+		name string
+		err  error
+		want bool
+	}{
+		{name: "stripped Go binary", err: errors.New("no symbols found"), want: true},
+		{name: "unexpected attach failure", err: errors.New("operation not permitted"), want: false},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			if got := isExpectedCapabilityError(tt.err); got != tt.want {
+				t.Fatalf("isExpectedCapabilityError(%q) = %t, want %t", tt.err, got, tt.want)
+			}
+		})
+	}
+}
