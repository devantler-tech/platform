@@ -0,0 +1,55 @@
+package node
+
+import (
+	"errors"
+	"fmt"
+	"reflect"
+	"testing"
+)
+
+// TestRetryNetlinkDump requires a complete result, a bounded recovery attempt,
+// and immediate propagation of errors unrelated to interrupted kernel dumps.
+func TestRetryNetlinkDump(t *testing.T) {
+	interrupted := errors.New("interrupted kernel dump")
+	permission := errors.New("permission denied")
+	lookalike := errors.New(interrupted.Error())
+	for _, tc := range []struct {
+		name      string
+		failures  []error
+		wantCalls int
+		wantError error
+	}{
+		{name: "complete first result", wantCalls: 1},
+		{name: "recover one interruption", failures: []error{interrupted}, wantCalls: 2},
+		{name: "recover wrapped interruption", failures: []error{fmt.Errorf("dump: %w", interrupted)}, wantCalls: 2},
+		{name: "recover final bounded attempt", failures: []error{interrupted, interrupted}, wantCalls: 3},
+		{name: "exhausted interruption", failures: []error{interrupted, interrupted, interrupted}, wantCalls: 3, wantError: interrupted},
+		{name: "unrelated error", failures: []error{permission}, wantCalls: 1, wantError: permission},
+		{name: "unrelated error after interruption", failures: []error{interrupted, permission}, wantCalls: 2, wantError: permission},
+		{name: "text alone is not interruption", failures: []error{lookalike}, wantCalls: 1, wantError: lookalike},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			calls := 0
+			got, err := retryNetlinkDump(func() ([]int, error) {
+				calls++
+				if calls <= len(tc.failures) {
+					return []int{99}, tc.failures[calls-1]
+				}
+				return []int{1, 2}, nil
+			}, interrupted)
+			if calls != tc.wantCalls {
+				t.Errorf("read calls = %d, want %d", calls, tc.wantCalls)
+			}
+			if !errors.Is(err, tc.wantError) {
+				t.Errorf("error = %v, want %v", err, tc.wantError)
+			}
+			if tc.wantError != nil {
+				if got != nil {
+					t.Errorf("partial data escaped with error: %v", got)
+				}
+			} else if !reflect.DeepEqual(got, []int{1, 2}) {
+				t.Errorf("result = %v, want complete snapshot [1 2]", got)
+			}
+		})
+	}
+}
