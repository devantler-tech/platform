@@ -0,0 +1,28 @@
+//go:build linux
+
+package logs
+
+import (
+	"errors"
+	"os"
+	"testing"
+)
+
+func TestJournalOpenSeverityBoundary(t *testing.T) {
+	tests := []struct {
+		name string
+		err  error
+		want bool
+	}{
+		{name: "Talos journal path absent", err: os.ErrNotExist, want: true},
+		{name: "journal permission denied", err: os.ErrPermission, want: false},
+		{name: "unexpected journal corruption", err: errors.New("journal header is corrupt"), want: false},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			if got := os.IsNotExist(tt.err); got != tt.want {
+				t.Fatalf("os.IsNotExist(%q) = %t, want %t", tt.err, got, tt.want)
+			}
+		})
+	}
+}
