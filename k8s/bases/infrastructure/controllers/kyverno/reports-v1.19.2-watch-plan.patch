+func TestWatchPlanDoesNotGuessKindFromOtherExpressions(t *testing.T) {
+	t.Parallel()
+	for _, expression := range []string{
+		"object.kind == 'HelmRelease' || true",
+		"object.kind != 'Pod'",
+		"object.metadata.name == 'HelmRelease'",
+	} {
+		t.Run(expression, func(t *testing.T) {
+			t.Parallel()
+			c, _ := newWatchPlanController(t)
+			var policy policiesv1beta1.MutatingPolicy
+			require.NoError(t, json.Unmarshal([]byte(`{"metadata":{"name":"unbounded","resourceVersion":"1"},"spec":{"matchConstraints":{"resourceRules":[{"apiGroups":["*"],"apiVersions":["*"],"operations":["CREATE"],"resources":["*"]}]}}}`), &policy))
+			policy.Spec.MatchConditions = []admissionregistrationv1.MatchCondition{{Name: "condition", Expression: expression}}
+			indexer := cache.NewIndexer(cache.MetaNamespaceKeyFunc, cache.Indexers{})
+			require.NoError(t, indexer.Add(&policy))
+			c.mpolLister = policiesv1beta1listers.NewMutatingPolicyLister(indexer)
+			ctx, cancel := context.WithCancel(t.Context())
+			defer cancel()
+			require.Error(t, c.Warmup(ctx), "an unbounded eligible policy still requires denied resources and must remain incomplete")
+		})
+	}
+}
