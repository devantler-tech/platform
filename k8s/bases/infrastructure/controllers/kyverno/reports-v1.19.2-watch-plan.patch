+	require.NoError(t, json.Unmarshal([]byte(`{"metadata":{"name":"background-helm","resourceVersion":"1"},"spec":{"matchConditions":[{"name":"helm-kind","expression":"object.kind == 'HelmRelease'"}],"matchConstraints":{"resourceRules":[{"apiGroups":["*"],"apiVersions":["*"],"operations":["CREATE","UPDATE"],"resources":["*"]}]}}}`), &policy))
