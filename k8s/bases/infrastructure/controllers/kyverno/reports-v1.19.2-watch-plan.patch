+func TestWatchPlanFailureRetainsSuccessfulCoverage(t *testing.T) {
+	t.Parallel()
+	c, _ := newWatchPlanController(t,
+		classicWatchPolicy(t, "background-pods", "Pod", true),
+		classicWatchPolicy(t, "background-secret", "Secret", true),
