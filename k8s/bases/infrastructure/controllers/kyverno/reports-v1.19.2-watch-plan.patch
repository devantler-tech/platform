+	require.Error(t, c.Warmup(ctx))
+	require.Len(t, c.dynamicWatchers, 1)
+	_, _, _, exists := c.GetResourceHash("sample-uid")
+	require.True(t, exists, "a denied sibling must not discard an established eligible watcher")
+}
+
+func TestWatchPlanStopsRemovedPolicyWatcher(t *testing.T) {
+	t.Parallel()
+	c, _ := newWatchPlanController(t, classicWatchPolicy(t, "background-pods", "Pod", true))
+	ctx, cancel := context.WithCancel(t.Context())
+	defer cancel()
+	require.NoError(t, c.Warmup(ctx))
+	c.cpolLister = kyvernov1listers.NewClusterPolicyLister(cache.NewIndexer(cache.MetaNamespaceKeyFunc, cache.Indexers{}))
+	stopped := make(chan types.UID, 1)
+	c.AddEventHandler(func(event EventType, uid types.UID, _ schema.GroupVersionKind, _ Resource) {
+		if event == Stopped {
+			stopped <- uid
+		}
+	})
+	require.NoError(t, c.Warmup(ctx))
+	require.Empty(t, c.dynamicWatchers)
+	require.Empty(t, c.GetAllResourceKeys())
+	select {
+	case uid := <-stopped:
+		require.EqualValues(t, "sample-uid", uid)
+	default:
+		t.Fatal("removed policy watcher did not emit its lifecycle event")
+	}
+}
+
+func TestWatchPlanDiscoveryFailureReconcilesHealthyCoverage(t *testing.T) {
+	t.Parallel()
+	c, _ := newWatchPlanController(t, classicWatchPolicy(t, "removed-helm", "helm.toolkit.fluxcd.io/v2/HelmRelease", true))
+	require.NoError(t, c.Warmup(t.Context()))
+	_, _, _, existed := c.GetResourceHash("helm-uid")
+	require.True(t, existed)
+	indexer := cache.NewIndexer(cache.MetaNamespaceKeyFunc, cache.Indexers{})
+	require.NoError(t, indexer.Add(classicWatchPolicy(t, "healthy-pods", "Pod", true)))
+	require.NoError(t, indexer.Add(classicWatchPolicy(t, "unavailable-kind", "NotRegistered", true)))
+	c.cpolLister = kyvernov1listers.NewClusterPolicyLister(indexer)
+	require.Error(t, c.Warmup(t.Context()), "incomplete discovery must remain an error")
+	_, _, _, present := c.GetResourceHash("sample-uid")
+	require.True(t, present, "healthy policies must still start their watchers")
+	_, _, _, retained := c.GetResourceHash("helm-uid")
+	require.False(t, retained, "removed policies must still release obsolete watchers")
+	require.Len(t, c.dynamicWatchers, 1)
+}
+
+func TestWatchPlanMixedPolicyKeepsResolvedResources(t *testing.T) {
+	t.Parallel()
+	c, _ := newWatchPlanController(t)
+	var policy policiesv1beta1.ValidatingPolicy
+	require.NoError(t, json.Unmarshal([]byte(`{"metadata":{"name":"mixed-policy","resourceVersion":"1"},"spec":{"evaluation":{"background":{"enabled":true}},"matchConstraints":{"resourceRules":[{"apiGroups":[""],"apiVersions":["v1"],"operations":["CREATE"],"resources":["notregistered","pods"]}]}}}`), &policy))
+	indexer := cache.NewIndexer(cache.MetaNamespaceKeyFunc, cache.Indexers{})
+	require.NoError(t, indexer.Add(&policy))
+	c.vpolLister = policiesv1beta1listers.NewValidatingPolicyLister(indexer)
+	require.Error(t, c.Warmup(t.Context()), "the unresolved resource must remain an error")
+	_, _, _, present := c.GetResourceHash("sample-uid")
