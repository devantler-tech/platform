--- /dev/null
+++ b/third_party/docker-credential-acr-env/pkg/credhelper/host_boundary_test.go
@@ -0,0 +1,25 @@
+package credhelper
+
+import "testing"
+
+func TestRegistryHostBoundary(t *testing.T) {
+	for _, suffix := range []string{"io", "cn", "de", "us"} {
+		for _, host := range []string{"registry.azurecr." + suffix, "registry.azurecr." + suffix + ":443"} {
+			if !isACRRegistry(host) {
+				t.Errorf("valid registry %q rejected", host)
+			}
+		}
+		for _, host := range []string{"registry.azurecr." + suffix + ".attacker.example", "registry.azurecr." + suffix + "evil", "registryazurecr." + suffix} {
+			if isACRRegistry(host) {
+				t.Errorf("untrusted registry %q accepted", host)
+				continue // Never enter credential acquisition with a vulnerable control.
+			}
+			// Get must reject the host before trying to obtain credentials. This
+			// branch must return the exact rejection even with no Azure settings.
+			user, secret, err := (&ACRCredHelper{}).Get(host)
+			if err == nil || err.Error() != "serverURL does not refer to Azure Container Registry" || user != "" || secret != "" {
+				t.Errorf("Get(%q) did not stop at host validation", host)
+			}
+		}
+	}
+}
