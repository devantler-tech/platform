diff --git a/cmd/internal/registry_security_test.go b/cmd/internal/registry_security_test.go
new file mode 100644
index 0000000..5bd8143
--- /dev/null
+++ b/cmd/internal/registry_security_test.go
@@ -0,0 +1,51 @@
+package internal
+
+import (
+	"testing"
+
+	"github.com/google/go-containerregistry/pkg/authn"
+	"github.com/kyverno/sdk/extensions/regcreds"
+)
+
+// An invalid reference exercises provider selection without contacting Azure or
+// reading credentials. Rejected hosts must never reach reference parsing.
+type registryBoundaryResource struct {
+	host  string
+	reads int
+}
+
+func (r *registryBoundaryResource) RegistryStr() string { return r.host }
+func (r *registryBoundaryResource) String() string {
+	r.reads++
+	return "%invalid-reference"
+}
+
+func TestAzureRegistryCredentialBoundary(t *testing.T) {
+	providers := regcreds.KeychainsForProviders("azure")
+	if len(providers) != 1 {
+		t.Fatalf("Azure provider count = %d, want 1", len(providers))
+	}
+	for source, keychain := range map[string]authn.Keychain{
+		"exported":   regcreds.AzureKeychain,
+		"configured": providers[0],
+	} {
+		t.Run(source, func(t *testing.T) {
+			for _, suffix := range []string{"io", "cn", "de", "us"} {
+				for _, host := range []string{"registry.azurecr." + suffix, "REGISTRY.AZURECR." + suffix + ".:443"} {
+					r := &registryBoundaryResource{host: host}
+					_, err := keychain.Resolve(r)
+					if err == nil || r.reads == 0 {
+						t.Errorf("valid Azure host %q did not reach reference validation", host)
+					}
+				}
+				for _, host := range []string{"registry.azurecr." + suffix + ".attacker.example", "registry.azurecr." + suffix + "evil"} {
+					r := &registryBoundaryResource{host: host}
+					auth, err := keychain.Resolve(r)
+					if err != nil || auth != authn.Anonymous || r.reads != 0 {
+						t.Errorf("non-Azure host %q reached credential provider: reads=%d err=%v", host, r.reads, err)
+					}
+				}
+			}
+		})
+	}
+}
