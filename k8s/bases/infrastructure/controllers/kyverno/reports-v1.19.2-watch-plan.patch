+	require.NoError(t, json.Unmarshal([]byte(`{"metadata":{"name":"background-pods","resourceVersion":"1"},"spec":{"evaluation":{"background":{"enabled":true}},"matchConstraints":{"resourceRules":[{"apiGroups":[""],"apiVersions":["*"],"operations":["CREATE"],"resources":["pods"]}]}}}`), &policy))
+	policy.Spec.MatchConditions = []admissionregistrationv1.MatchCondition{{Name: "optional-label", Expression: "object.metadata.?labels[?'checked'].orValue('') != 'exempt'"}}
