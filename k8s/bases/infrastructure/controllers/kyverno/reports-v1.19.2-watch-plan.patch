diff --git a/pkg/controllers/report/resource/watch_kinds.go b/pkg/controllers/report/resource/watch_kinds.go
new file mode 100644
index 0000000..a484da5
--- /dev/null
+++ b/pkg/controllers/report/resource/watch_kinds.go
@@ -0,0 +1,164 @@
+package resource
+
+import (
+	"errors"
+	"fmt"
+	"strings"
+
+	"github.com/google/cel-go/cel"
+	"github.com/google/cel-go/common/operators"
+	exprpb "google.golang.org/genproto/googleapis/api/expr/v1alpha1"
+	admissionregistrationv1 "k8s.io/api/admissionregistration/v1"
+	admissionregistrationv1alpha1 "k8s.io/api/admissionregistration/v1alpha1"
+	admissionregistrationv1beta1 "k8s.io/api/admissionregistration/v1beta1"
+	"k8s.io/apimachinery/pkg/api/meta"
+	"k8s.io/apimachinery/pkg/runtime/schema"
+	"k8s.io/apimachinery/pkg/util/sets"
+)
+
+// requiredWatchKind recognizes only an entire equality between object.kind and
+// a string constant. Match conditions are conjunctive, so this is a necessary
+// condition for a resource to match. Arbitrary CEL is never guessed at or run.
+func requiredWatchKind(expressions []string) (string, bool, bool, error) {
+	if len(expressions) == 0 {
+		return "", false, true, nil
+	}
+	env, err := cel.NewEnv(cel.OptionalTypes())
+	if err != nil {
+		return "", false, false, err
+	}
+	var required string
+	constrained := false
+	for _, expression := range expressions {
+		parsed, issues := env.Parse(expression)
+		if issues.Err() != nil {
+			return "", false, false, issues.Err()
+		}
+		call := parsed.Expr().GetCallExpr()
+		if call.GetFunction() != operators.Equals || call.GetTarget() != nil || len(call.GetArgs()) != 2 {
+			continue
+		}
+		for _, pair := range [][2]*exprpb.Expr{{call.Args[0], call.Args[1]}, {call.Args[1], call.Args[0]}} {
+			selected := pair[0].GetSelectExpr()
+			constant := pair[1].GetConstExpr()
+			if selected.GetField() != "kind" || selected.GetTestOnly() ||
+				selected.GetOperand().GetIdentExpr().GetName() != "object" || constant == nil {
+				continue
+			}
+			literal, ok := constant.ConstantKind.(*exprpb.Constant_StringValue)
+			if !ok {
+				continue
+			}
+			if constrained && required != literal.StringValue {
+				return "", true, false, nil
+			}
+			required, constrained = literal.StringValue, true
+		}
+	}
+	if constrained && strings.ContainsAny(required, "*/?[]") {
+		return "", false, false, fmt.Errorf("kind equality is not a literal discovery kind")
+	}
+	return required, constrained, true, nil
+}
+
+func watchKindSelector(group, version, kind, subresource string) string {
+	// Four components avoid the legacy selector parser's ambiguity between a
+	// wildcard group and version. Keep the empty core group and root subresource.
+	return strings.Join([]string{group, version, kind, subresource}, "/")
+}
+
+// getWatchKinds resolves wildcard API versions through the RESTMapper's partial
+// lookup, retaining exact core-group and resource constraints. Whole-resource
+// wildcards remain discovery selectors, optionally bounded by a proven kind
+// equality. Discovery and permission errors are handled by the caller, never
+// converted into successful empty coverage.
+func getWatchKinds(match *admissionregistrationv1.MatchResources, mapper meta.RESTMapper, expressions ...string) ([]string, error) {
+	if match == nil {
+		return nil, nil
+	}
+	required, constrained, possible, err := requiredWatchKind(expressions)
+	if err != nil {
+		return nil, err
+	}
+	if !possible || constrained && required == "" {
+		return nil, nil
+	}
+	kinds := sets.New[string]()
+	var planningErrors []error
+	for _, rule := range match.ResourceRules {
+		if len(rule.APIGroups) == 0 || len(rule.APIVersions) == 0 || len(rule.Resources) == 0 {
+			planningErrors = append(planningErrors, fmt.Errorf("incomplete resource rule in background watch plan"))
+			continue
+		}
+		for _, group := range rule.APIGroups {
+			for _, version := range rule.APIVersions {
+				for _, resource := range rule.Resources {
+					parent, subresource, _ := strings.Cut(resource, "/")
+					if parent == "*" {
+						kind := "*"
+						if constrained {
+							kind = required
+						}
+						kinds.Insert(watchKindSelector(group, version, kind, subresource))
+						continue
+					}
+					lookup := schema.GroupVersionResource{Group: group, Version: version, Resource: parent}
+					if group == "*" {
+						lookup.Group = ""
+					}
+					if version == "*" {
+						lookup.Version = ""
+					}
+					resources, err := mapper.ResourcesFor(lookup)
+					if err != nil {
+						planningErrors = append(planningErrors, fmt.Errorf("resolve background resource %s/%s/%s: %w", group, version, resource, err))
+						continue
+					}
+					matched := false
+					for _, resolved := range resources {
+						if group != "*" && resolved.Group != group || version != "*" && resolved.Version != version || resolved.Resource != parent {
+							continue
+						}
+						matched = true
+						gvk, err := mapper.KindFor(resolved)
+						if err != nil {
+							planningErrors = append(planningErrors, err)
+							continue
+						}
+						if !constrained || gvk.Kind == required {
+							kinds.Insert(watchKindSelector(gvk.Group, gvk.Version, gvk.Kind, subresource))
+						}
+					}
+					if !matched {
+						planningErrors = append(planningErrors, fmt.Errorf("no exact discovery match for background resource %s/%s/%s", group, version, resource))
+					}
+				}
+			}
+		}
+	}
+	return sets.List(kinds), errors.Join(planningErrors...)
+}
+
+func matchConditionExpressions(conditions []admissionregistrationv1.MatchCondition) []string {
+	expressions := make([]string, 0, len(conditions))
+	for _, condition := range conditions {
+		expressions = append(expressions, condition.Expression)
+	}
+	return expressions
+}
+
+func betaMatchConditionExpressions(conditions []admissionregistrationv1beta1.MatchCondition) []string {
+	expressions := make([]string, 0, len(conditions))
+	for _, condition := range conditions {
+		expressions = append(expressions, condition.Expression)
+	}
+	return expressions
+}
+
+func alphaMatchConditionExpressions(conditions []admissionregistrationv1alpha1.MatchCondition) []string {
+	expressions := make([]string, 0, len(conditions))
+	for _, condition := range conditions {
+		expressions = append(expressions, condition.Expression)
+	}
+	return expressions
+}
