+func TestWatchPlanExcludesAdmissionOnlyWildcard(t *testing.T) {
+	t.Parallel()
+	c, dynamic := newWatchPlanController(t,
+		classicWatchPolicy(t, "admission-fence", "*", false),
+		classicWatchPolicy(t, "background-pods", "Pod", true),
+	)
+	ctx, cancel := context.WithCancel(t.Context())
+	defer cancel()
+	require.NoError(t, c.Warmup(ctx))
+	for _, action := range dynamic.Actions() {
+		require.Equal(t, "pods", action.GetResource().Resource, "admission-only policy must not cause a resource read")
+	}
+	require.Len(t, c.dynamicWatchers, 1)
+	resource, _, _, exists := c.GetResourceHash("sample-uid")
+	require.True(t, exists, "eligible background resources must remain in the cache")
+	require.Equal(t, "sample", resource.Name)
+}
