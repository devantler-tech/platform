+type watchPlanDiscovery struct{ dclient.IDiscovery }
+
+func (d watchPlanDiscovery) FindResources(group, version, kind, subresource string) (map[dclient.TopLevelApiDescription]metav1.APIResource, error) {
+	resources, err := d.IDiscovery.FindResources(group, version, kind, subresource)
+	for key, resource := range resources {
+		resource.Verbs = metav1.Verbs{"get", "list", "watch"}
+		resources[key] = resource
+	}
+	return resources, err
+}
+
+func classicWatchPolicy(t *testing.T, name, kind string, background bool) *kyvernov1.ClusterPolicy {
+	t.Helper()
+	operation := "CREATE"
+	if !background {
+		operation = "DELETE"
+	}
+	data := fmt.Sprintf(`{"apiVersion":"kyverno.io/v1","kind":"ClusterPolicy","metadata":{"name":%q,"resourceVersion":"1","annotations":{"pod-policies.kyverno.io/autogen-controllers":"none"}},"spec":{"background":%t,"rules":[{"name":"check","match":{"any":[{"resources":{"kinds":[%q],"operations":[%q]}}]},"validate":{"message":"A checked label is required.","pattern":{"metadata":{"labels":{"checked":"yes"}}}}}]}}`, name, background, kind, operation)
+	var policy kyvernov1.ClusterPolicy
+	require.NoError(t, json.Unmarshal([]byte(data), &policy))
+	return &policy
+}
+
+func newWatchPlanController(t *testing.T, policies ...*kyvernov1.ClusterPolicy) (*controller, *dynamicfake.FakeDynamicClient) {
+	t.Helper()
+	return newWatchPlanControllerWithResources(t, nil, policies...)
+}
+
+func newWatchPlanControllerWithResources(t *testing.T, additional map[schema.GroupVersionResource]string, policies ...*kyvernov1.ClusterPolicy) (*controller, *dynamicfake.FakeDynamicClient) {
+	t.Helper()
+	pods := schema.GroupVersionResource{Version: "v1", Resource: "pods"}
+	helmReleases := schema.GroupVersionResource{Group: "helm.toolkit.fluxcd.io", Version: "v2", Resource: "helmreleases"}
+	listKinds := map[schema.GroupVersionResource]string{
+		pods:                                                     "PodList",
+		helmReleases:                                             "HelmReleaseList",
+		{Version: "v1", Resource: "configmaps"}:                  "ConfigMapList",
+		{Version: "v1", Resource: "endpoints"}:                   "EndpointsList",
+		{Version: "v1", Resource: "namespaces"}:                  "NamespaceList",
+		{Version: "v1", Resource: "resourcequotas"}:              "ResourceQuotaList",
+		{Version: "v1", Resource: "secrets"}:                     "SecretList",
+		{Version: "v1", Resource: "serviceaccounts"}:             "ServiceAccountList",
+		{Group: "apps", Version: "v1", Resource: "daemonsets"}:   "DaemonSetList",
+		{Group: "apps", Version: "v1", Resource: "deployments"}:  "DeploymentList",
+		{Group: "apps", Version: "v1", Resource: "statefulsets"}: "StatefulSetList",
+	}
+	allowed := map[schema.GroupVersionResource]string{pods: "Pod", helmReleases: "HelmRelease"}
+	for gvr, kind := range additional {
+		allowed[gvr] = kind
+		listKinds[gvr] = kind + "List"
+	}
+	dynamic := dynamicfake.NewSimpleDynamicClientWithCustomListKinds(runtime.NewScheme(), listKinds)
+	dynamic.PrependReactor("list", "*", func(action clienttesting.Action) (bool, runtime.Object, error) {
+		kind, ok := allowed[action.GetResource()]
+		if !ok {
+			return true, nil, apierrors.NewForbidden(action.GetResource().GroupResource(), "", errors.New("fixture read denied"))
+		}
+		uid := action.GetResource().Group + "-" + action.GetResource().Resource + "-uid"
+		if action.GetResource() == pods {
+			uid = "sample-uid"
+		} else if action.GetResource() == helmReleases {
+			uid = "helm-uid"
+		}
+		return true, &unstructured.UnstructuredList{
+			Object: map[string]any{"metadata": map[string]any{"resourceVersion": "1"}},
+			Items: []unstructured.Unstructured{{Object: map[string]any{
+				"apiVersion": action.GetResource().GroupVersion().String(), "kind": kind,
+				"metadata": map[string]any{"name": "sample", "namespace": "sample", "uid": uid, "resourceVersion": "1"},
+			}}},
+		}, nil
+	})
+	dynamic.PrependWatchReactor("*", func(clienttesting.Action) (bool, watch.Interface, error) {
+		return true, watch.NewRaceFreeFake(), nil
+	})
+	registrations := make([]schema.GroupVersionResource, 0, len(allowed))
+	for gvr := range allowed {
+		registrations = append(registrations, gvr)
+	}
+	discovery := dclient.NewFakeDiscoveryClient(registrations)
+	for gvr, kind := range allowed {
+		discovery.AddGVRToGVKMapping(gvr, schema.GroupVersionKind{Group: gvr.Group, Version: gvr.Version, Kind: kind})
+	}
+	clusterIndexer := cache.NewIndexer(cache.MetaNamespaceKeyFunc, cache.Indexers{})
+	for _, policy := range policies {
+		require.NoError(t, clusterIndexer.Add(policy))
+	}
+	c := &controller{
+		client:          dclient.NewFakeClientWithDisco(dynamic, kubefake.NewSimpleClientset(), watchPlanDiscovery{discovery}),
+		cpolLister:      kyvernov1listers.NewClusterPolicyLister(clusterIndexer),
+		polLister:       kyvernov1listers.NewPolicyLister(cache.NewIndexer(cache.MetaNamespaceKeyFunc, cache.Indexers{cache.NamespaceIndex: cache.MetaNamespaceIndexFunc})),
+		dynamicWatchers: map[schema.GroupVersionResource]*watcher{},
+		watchDeathChan:  make(chan schema.GroupVersionResource, 100),
+	}
+	t.Cleanup(c.stopDynamicWatchers)
+	return c, dynamic
+}
