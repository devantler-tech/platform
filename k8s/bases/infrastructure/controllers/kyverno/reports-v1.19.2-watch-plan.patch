+func TestWatchPlanStopsRemovedPolicyWatcher(t *testing.T) {
+	t.Parallel()
+	c, _ := newWatchPlanController(t, classicWatchPolicy(t, "background-pods", "Pod", true))
+	ctx, cancel := context.WithCancel(t.Context())
+	defer cancel()
+	require.NoError(t, c.Warmup(ctx))
+	c.cpolLister = kyvernov1listers.NewClusterPolicyLister(cache.NewIndexer(cache.MetaNamespaceKeyFunc, cache.Indexers{}))
+	stopped := make(chan types.UID, 1)
+	c.AddEventHandler(func(event EventType, uid types.UID, _ schema.GroupVersionKind, _ Resource) {
+		if event == Stopped {
+			stopped <- uid
+		}
+	})
+	require.NoError(t, c.Warmup(ctx))
+	require.Empty(t, c.dynamicWatchers)
+	require.Empty(t, c.GetAllResourceKeys())
+	select {
+	case uid := <-stopped:
+		require.EqualValues(t, "sample-uid", uid)
+	default:
+		t.Fatal("removed policy watcher did not emit its lifecycle event")
+	}
+}
