diff --git a/cmd/platform-migrate/main.go b/cmd/platform-migrate/main.go
new file mode 100644
index 0000000..fc5b9c2
--- /dev/null
+++ b/cmd/platform-migrate/main.go
@@ -0,0 +1,33 @@
+// The maintenance image exposes only the released migration command. It does
+// not expose policy evaluation or other interactive CLI entry points.
+package main
+
+import (
+	"fmt"
+	"os"
+
+	"github.com/kyverno/kyverno/cmd/cli/kubectl-kyverno/commands/migrate"
+	"github.com/spf13/cobra"
+)
+
+var buildVersion = "development"
+
+func newRootCommand() *cobra.Command {
+	root := &cobra.Command{
+		Use:               "kubectl-kyverno",
+		Version:           buildVersion,
+		Short:             "Kyverno maintenance migration runtime",
+		SilenceUsage:      true,
+		SilenceErrors:     true,
+		CompletionOptions: cobra.CompletionOptions{DisableDefaultCmd: true},
+	}
+	root.AddCommand(migrate.Command())
+	return root
+}
+
+func main() {
+	if err := newRootCommand().Execute(); err != nil {
+		fmt.Fprintln(os.Stderr, err)
+		os.Exit(1)
+	}
+}
