+++ b/cmd/platform-migrate/main_test.go
@@ -0,0 +1,229 @@
+package main
+
+import (
+	"bytes"
+	"crypto/ecdsa"
+	"crypto/elliptic"
+	"crypto/rand"
+	"crypto/x509"
+	"crypto/x509/pkix"
+	"encoding/json"
+	"encoding/pem"
+	"io"
+	"log"
+	"math/big"
+	"net/http"
+	"net/http/httptest"
+	"path/filepath"
+	"strings"
+	"sync"
+	"testing"
+	"time"
+
+	apiextensionsv1 "k8s.io/apiextensions-apiserver/pkg/apis/apiextensions/v1"
+	apiextensionsscheme "k8s.io/apiextensions-apiserver/pkg/client/clientset/clientset/scheme"
+	clientcmd "k8s.io/client-go/tools/clientcmd"
+	clientcmdapi "k8s.io/client-go/tools/clientcmd/api"
+)
+
+func TestMigrationCommandBoundary(t *testing.T) {
+	for _, tc := range []struct {
+		name                  string
+		args                  []string
+		wantError, wantOutput string
+	}{
+		{"help", []string{"migrate", "--help"}, "", "--resource"},
+		{"version", []string{"--version"}, "", buildVersion},
+		{"other-command", []string{"apply", "--help"}, "unknown command", ""},
+		{"missing-resource", []string{"migrate"}, "required flag", ""},
+		{"empty-resource", []string{"migrate", "--resource", "   "}, "resource cannot be empty", ""},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			cmd := newRootCommand()
+			var output bytes.Buffer
+			cmd.SetOut(&output)
+			cmd.SetErr(io.Discard)
+			cmd.SetArgs(tc.args)
+			err := cmd.Execute()
+			if tc.wantError == "" {
+				if err != nil || !strings.Contains(output.String(), tc.wantOutput) {
+					t.Fatalf("runtime command output unavailable: %v", err)
+				}
+			} else if err == nil || !strings.Contains(err.Error(), tc.wantError) {
+				t.Fatalf("command boundary error = %v, want %q", err, tc.wantError)
+			}
+		})
+	}
+}
+
+// Exercise the released command through its real TLS Kubernetes clients. The
+// closed loopback API admits one fixed CRD/resource and fails every other route.
+func TestReleasedMigrationThroughTLSAPI(t *testing.T) {
+	for _, tc := range []struct {
+		name, fault    string
+		current, badCA bool
+	}{
+		{name: "already-current", current: true},
+		{name: "migrate-retained-object"},
+		{name: "list-refused", fault: "list"},
+		{name: "object-update-refused", fault: "object"},
+		{name: "status-update-refused", fault: "status"},
+		{name: "untrusted-api-certificate", badCA: true},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			const crdName = "widgets.migration.fixture.invalid"
+			const crdPath = "/apis/apiextensions.k8s.io/v1/customresourcedefinitions/" + crdName
+			const listPath = "/apis/migration.fixture.invalid/v1/widgets"
+			const objectPath = "/apis/migration.fixture.invalid/v1/namespaces/fixture-one/widgets/retained"
+			requests, objectUpdates, statusUpdates := 0, 0, 0
+			faultReached := false
+			var stateMu sync.Mutex
+			crd := map[string]any{
+				"apiVersion": "apiextensions.k8s.io/v1", "kind": "CustomResourceDefinition",
+				"metadata": map[string]any{"name": crdName, "uid": "retained-crd", "resourceVersion": "1"},
+				"spec": map[string]any{
+					"group": "migration.fixture.invalid", "scope": "Namespaced",
+					"names":    map[string]any{"plural": "widgets", "kind": "Widget"},
+					"versions": []any{map[string]any{"name": "v1", "served": true, "storage": true}},
+				},
+				"status": map[string]any{"storedVersions": []string{"v1beta1", "v1"}},
+			}
+			if tc.current {
+				crd["status"] = map[string]any{"storedVersions": []string{"v1"}}
+			}
+			object := map[string]any{
+				"apiVersion": "migration.fixture.invalid/v1", "kind": "Widget",
+				"metadata": map[string]any{"name": "retained", "namespace": "fixture-one", "uid": "retained-widget", "resourceVersion": "1"},
+				"spec":     map[string]any{"value": "preserved"},
+			}
+			server := httptest.NewUnstartedServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+				stateMu.Lock()
+				defer stateMu.Unlock()
+				requests++
+				w.Header().Set("Content-Type", "application/json")
+				if r.Header.Get("Authorization") != "Bearer fixture-only-token" {
+					t.Error("released client lost its selected fixture identity")
+					w.WriteHeader(http.StatusUnauthorized)
+					return
+				}
+				stage := ""
+				switch {
+				case r.Method == http.MethodGet && r.URL.Path == crdPath:
+					_ = json.NewEncoder(w).Encode(crd)
+					return
+				case r.Method == http.MethodGet && r.URL.Path == listPath:
+					stage = "list"
+				case r.Method == http.MethodPut && r.URL.Path == objectPath:
+					stage = "object"
+				case r.Method == http.MethodPut && r.URL.Path == crdPath+"/status":
+					stage = "status"
+				default:
+					t.Errorf("unexpected API operation: %s %s", r.Method, r.URL.Path)
+					w.WriteHeader(http.StatusNotFound)
+					return
+				}
+				if stage == tc.fault {
+					faultReached = true
+					w.WriteHeader(http.StatusForbidden)
+					_ = json.NewEncoder(w).Encode(map[string]any{"apiVersion": "v1", "kind": "Status", "status": "Failure", "reason": "Forbidden", "message": "fixture operation refused", "code": 403})
+					return
+				}
+				switch stage {
+				case "list":
+					_ = json.NewEncoder(w).Encode(map[string]any{"apiVersion": "migration.fixture.invalid/v1", "kind": "WidgetList", "metadata": map[string]any{"resourceVersion": "1"}, "items": []any{object}})
+				case "object":
+					var updated map[string]any
+					if err := json.NewDecoder(r.Body).Decode(&updated); err != nil {
+						t.Error(err)
+						return
+					}
+					before, _ := json.Marshal(object)
+					after, _ := json.Marshal(updated)
+					if !bytes.Equal(before, after) {
+						t.Error("migration changed the retained object's identity or data")
+					}
+					objectUpdates++
+					_ = json.NewEncoder(w).Encode(updated)
+				case "status":
+					body, err := io.ReadAll(io.LimitReader(r.Body, 1024*1024))
+					if err != nil {
+						t.Error(err)
+						return
+					}
+					decoded, _, err := apiextensionsscheme.Codecs.UniversalDeserializer().Decode(body, nil, nil)
+					if err != nil {
+						t.Error(err)
+						return
+					}
+					updated, ok := decoded.(*apiextensionsv1.CustomResourceDefinition)
+					if !ok {
+						t.Errorf("unexpected status object %T", decoded)
+						return
+					}
+					if strings.Join(updated.Status.StoredVersions, ",") != "v1" {
+						t.Error("migration did not converge the stored version")
+					}
+					statusUpdates++
+					crd["status"] = map[string]any{"storedVersions": []string{"v1"}}
+					_ = json.NewEncoder(w).Encode(crd)
+				}
+			}))
+			server.Config.ErrorLog = log.New(io.Discard, "", 0)
+			server.StartTLS()
+			defer server.Close()
+			certificate := server.Certificate().Raw
+			if tc.badCA {
+				key, err := ecdsa.GenerateKey(elliptic.P256(), rand.Reader)
+				if err != nil {
+					t.Fatal(err)
+				}
+				ca := &x509.Certificate{SerialNumber: big.NewInt(1), Subject: pkix.Name{CommonName: "unrelated fixture CA"}, IsCA: true, BasicConstraintsValid: true, KeyUsage: x509.KeyUsageCertSign, NotBefore: time.Now().Add(-time.Hour), NotAfter: time.Now().Add(time.Hour)}
+				certificate, err = x509.CreateCertificate(rand.Reader, ca, ca, &key.PublicKey, key)
+				if err != nil {
+					t.Fatal(err)
+				}
+			}
+			config := clientcmdapi.Config{
+				Clusters:  map[string]*clientcmdapi.Cluster{"fixture": {Server: server.URL, CertificateAuthorityData: pem.EncodeToMemory(&pem.Block{Type: "CERTIFICATE", Bytes: certificate})}},
+				AuthInfos: map[string]*clientcmdapi.AuthInfo{"fixture": {Token: "fixture-only-token"}},
+				Contexts:  map[string]*clientcmdapi.Context{"fixture": {Cluster: "fixture", AuthInfo: "fixture"}}, CurrentContext: "fixture",
+			}
+			configPath := filepath.Join(t.TempDir(), "config")
+			if err := clientcmd.WriteToFile(config, configPath); err != nil {
+				t.Fatal(err)
+			}
+			cmd := newRootCommand()
+			cmd.SetOut(io.Discard)
+			cmd.SetErr(io.Discard)
+			cmd.SetArgs([]string{"migrate", "--kubeconfig", configPath, "--resource", crdName})
+			err := cmd.Execute()
+			stateMu.Lock()
+			defer stateMu.Unlock()
+			if tc.badCA {
+				if err == nil || !strings.Contains(err.Error(), "certificate") || requests != 0 {
+					t.Fatalf("untrusted API certificate was not refused: %v requests=%d", err, requests)
+				}
+				return
+			}
+			if tc.fault != "" {
+				if err == nil || !faultReached {
+					t.Fatalf("real API refusal was not propagated: %v reached=%t", err, faultReached)
+				}
+				if tc.fault != "status" && statusUpdates != 0 {
+					t.Fatal("CRD status advanced after an earlier failure")
+				}
+				return
+			}
+			if err != nil {
+				t.Fatal(err)
+			}
+			if tc.current {
+				if requests != 1 || objectUpdates != 0 || statusUpdates != 0 {
+					t.Fatal("an already-current resource was mutated")
+				}
+			} else if objectUpdates != 1 || statusUpdates != 1 {
+				t.Fatalf("migration did not complete: object=%d status=%d", objectUpdates, statusUpdates)
+			}
+		})
+	}
+}
