+// isDownstreamAbsent requires the API's named-object response. A generic route
+// or resource-type 404 does not establish that the cached downstream is absent.
+func isDownstreamAbsent(err error, resource *unstructured.Unstructured) bool {
+	if resource == nil || resource.GetName() == "" || !apierrors.IsNotFound(err) {
+		return false
+	}
+	var status apierrors.APIStatus
+	if !errors.As(err, &status) {
+		return false
+	}
+	details := status.Status().Details
+	return details != nil && details.Name == resource.GetName() &&
+		details.Group == resource.GroupVersionKind().Group && details.Kind != ""
+}
