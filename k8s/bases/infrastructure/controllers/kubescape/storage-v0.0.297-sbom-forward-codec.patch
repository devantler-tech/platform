--- /dev/null
+++ b/pkg/apis/softwarecomposition/packagemetadata/forward.go
@@ -0,0 +1,30 @@
+package packagemetadata
+
+import (
+	"bytes"
+	"encoding/json"
+)
+
+// MarshalPreservingFields retains metadata added by newer scanners after the
+// caller validates recognized fields with its existing metadata type.
+func MarshalPreservingFields(original json.RawMessage, decoded any) (json.RawMessage, error) {
+	known, err := json.Marshal(decoded)
+	if err != nil {
+		return nil, err
+	}
+	original = bytes.TrimSpace(original)
+	if len(original) == 0 || original[0] != '{' || len(known) == 0 || known[0] != '{' {
+		return known, nil
+	}
+	var fields, canonical map[string]json.RawMessage
+	if err := json.Unmarshal(original, &fields); err != nil {
+		return nil, err
+	}
+	if err := json.Unmarshal(known, &canonical); err != nil {
+		return nil, err
+	}
+	for key, value := range canonical {
+		fields[key] = value
+	}
+	return json.Marshal(fields)
+}
