--- /dev/null
+++ b/pkg/container-collection/namespace_descriptor_test.go
@@ -0,0 +1,146 @@
+package containercollection
+
+import (
+	"os"
+	"sync"
+	"testing"
+
+	"github.com/inspektor-gadget/inspektor-gadget/pkg/types"
+	"github.com/inspektor-gadget/inspektor-gadget/pkg/utils/host"
+	"golang.org/x/sys/unix"
+)
+
+// These tests open real namespace descriptors, of this test process's own
+// /proc/self/ns/{mnt,net}. They create no namespace or mount and need no
+// privilege. An open namespace descriptor keeps that namespace, and every
+// mount in it, alive, which is how a leaked one can keep an encrypted volume's
+// device busy after its container exits (devantler-tech/platform#6327).
+
+type noopTracer struct{}
+
+func (noopTracer) TracerMapsUpdater() FuncNotify { return func(PubSubEvent) {} }
+
+func openDescriptors(t *testing.T) int {
+	t.Helper()
+	entries, err := os.ReadDir("/proc/self/fd")
+	if err != nil {
+		t.Fatal(err)
+	}
+	return len(entries)
+}
+
+func isOpen(fd int) bool {
+	if fd <= 0 {
+		return false
+	}
+	_, err := unix.FcntlInt(uintptr(fd), unix.F_GETFD, 0)
+	return err == nil
+}
+
+func newCollection(t *testing.T) *ContainerCollection {
+	t.Helper()
+	original := host.HostProcFs
+	host.HostProcFs = "/proc"
+	t.Cleanup(func() { host.HostProcFs = original })
+	cc := &ContainerCollection{}
+	if err := cc.Initialize(WithTracerCollection(noopTracer{})); err != nil {
+		t.Fatal(err)
+	}
+	return cc
+}
+
+func candidate(id string) *Container {
+	return &Container{
+		Runtime: RuntimeMetadata{BasicRuntimeMetadata: types.BasicRuntimeMetadata{ContainerID: id, ContainerPID: uint32(os.Getpid())}},
+		Mntns:   1,
+		Netns:   2,
+	}
+}
+
+// After any sequence of adds for one ID, exactly the registered container's
+// two descriptors are open, and they are still valid.
+func assertOnlyRegisteredOpen(t *testing.T, cc *ContainerCollection, id string, baseline int) *Container {
+	t.Helper()
+	value, ok := cc.containers.Load(id)
+	if !ok {
+		t.Fatal("no container was registered")
+	}
+	registered := value.(*Container)
+	if !isOpen(registered.mntNsFd) || !isOpen(registered.netNsFd) {
+		t.Fatalf("the registered container lost its namespace descriptors: mnt=%d net=%d", registered.mntNsFd, registered.netNsFd)
+	}
+	if open := openDescriptors(t) - baseline; open != 2 {
+		t.Fatalf("%d namespace descriptors are open, want only the registered container's 2", open)
+	}
+	return registered
+}
+
+func TestDistinctDuplicateReleasesItsDescriptors(t *testing.T) {
+	cc := newCollection(t)
+	baseline := openDescriptors(t)
+	first := candidate("same-container")
+	cc.AddContainer(first)
+	mnt, net := first.mntNsFd, first.netNsFd
+	cc.AddContainer(candidate("same-container"))
+	registered := assertOnlyRegisteredOpen(t, cc, "same-container", baseline)
+	if registered != first || first.mntNsFd != mnt || first.netNsFd != net {
+		t.Fatal("a duplicate replaced the registered container or its descriptors")
+	}
+	first.close()
+}
+
+func TestSameObjectReAddKeepsItsDescriptors(t *testing.T) {
+	cc := newCollection(t)
+	baseline := openDescriptors(t)
+	first := candidate("same-container")
+	cc.AddContainer(first)
+	mnt, net := first.mntNsFd, first.netNsFd
+	cc.AddContainer(first)
+	assertOnlyRegisteredOpen(t, cc, "same-container", baseline)
+	if first.mntNsFd != mnt || first.netNsFd != net {
+		t.Fatalf("re-adding the registered object replaced its descriptors: before=%d,%d after=%d,%d", mnt, net, first.mntNsFd, first.netNsFd)
+	}
+	first.close()
+}
+
+func TestConcurrentDistinctCandidatesLeaveOnlyTheWinnerOpen(t *testing.T) {
+	cc := newCollection(t)
+	baseline := openDescriptors(t)
+	candidates := make([]*Container, 16)
+	var wg sync.WaitGroup
+	for i := range candidates {
+		candidates[i] = candidate("concurrent-container")
+		wg.Add(1)
+		go func(c *Container) {
+			defer wg.Done()
+			cc.AddContainer(c)
+		}(candidates[i])
+	}
+	wg.Wait()
+	registered := assertOnlyRegisteredOpen(t, cc, "concurrent-container", baseline)
+	for _, c := range candidates {
+		if c != registered && (c.mntNsFd != 0 || c.netNsFd != 0) {
+			t.Fatalf("a discarded candidate still records descriptors %d,%d", c.mntNsFd, c.netNsFd)
+		}
+	}
+	registered.close()
+}
+
+func TestConcurrentSameObjectAddsLeaveOneValidPair(t *testing.T) {
+	cc := newCollection(t)
+	baseline := openDescriptors(t)
+	shared := candidate("shared-container")
+	var wg sync.WaitGroup
+	for range 16 {
+		wg.Add(1)
+		go func() {
+			defer wg.Done()
+			cc.AddContainer(shared)
+		}()
+	}
+	wg.Wait()
+	if registered := assertOnlyRegisteredOpen(t, cc, "shared-container", baseline); registered != shared {
+		t.Fatal("the shared object was not the registered container")
+	}
+	shared.close()
+}
