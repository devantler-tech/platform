+func TestSummaryMetadataRepairInternalStorageCodec(t *testing.T) {
+	for _, test := range []struct {
+		name                        string
+		coherent                    bool
+		repaired, unchanged         int
+		beforeVersion, afterVersion string
+	}{
+		{"split native metadata", false, 1, 0, "2", "3"},
+		{"coherent native metadata", true, 0, 1, "3", "4"},
+	} {
+		t.Run(test.name, func(t *testing.T) {
+			// The API registry's NewFunc returns the internal type. Its ObjectMeta
+			// is flattened in SQLite JSON, unlike the versioned API's wrapper.
+			obj := &softwarecomposition.VulnerabilityManifestSummary{ObjectMeta: metav1.ObjectMeta{
+				Name: "deployment-example-app", Namespace: "example", UID: types.UID("retained-identity"),
+				CreationTimestamp: metav1.NewTime(time.Date(2026, 9, 1, 0, 0, 0, 0, time.UTC)),
+				Annotations:       map[string]string{"kubescape.io/timestamp": "1788220800", "kubescape.io/tool-version": "v1.32.0"},
+			}}
+			f := newSplitSummaryObject(t, obj)
+			if test.coherent {
+				require.NoError(t, f.store.saveObject(f.conn, summaryRepairKey, obj, nil, ""))
+			}
+			before, err := ReadMetadata(f.conn, summaryRepairKey)
+			require.NoError(t, err)
+			var shape map[string]json.RawMessage
+			require.NoError(t, json.Unmarshal(before, &shape))
+			require.Contains(t, shape, "name")
+			require.NotContains(t, shape, "metadata")
+			payload, err := afero.ReadFile(f.fs, filepath.Join(f.root, summaryRepairKey)+GobExt)
+			require.NoError(t, err)
+			report, err := ReconcileVulnerabilitySummaryMetadata(context.Background(), f.fs, f.root, f.pool)
+			require.NoError(t, err)
+			require.Equal(t, SummaryMetadataRepairReport{Examined: 1, Repaired: test.repaired, Unchanged: test.unchanged}, report)
+			after, err := ReadMetadata(f.conn, summaryRepairKey)
+			require.NoError(t, err)
+			var listed softwarecomposition.VulnerabilityManifestSummary
+			require.NoError(t, json.Unmarshal(after, &listed))
+			require.Equal(t, test.beforeVersion, listed.ResourceVersion)
+			require.Equal(t, types.UID("retained-identity"), listed.UID)
+			require.Equal(t, "1788307200", listed.Annotations["kubescape.io/timestamp"])
+			retained, err := afero.ReadFile(f.fs, filepath.Join(f.root, summaryRepairKey)+GobExt)
+			require.NoError(t, err)
+			require.Equal(t, payload, retained, "reconciliation must preserve the native payload")
+			out := &softwarecomposition.VulnerabilityManifestSummary{}
+			require.NoError(t, f.store.GuaranteedUpdate(context.Background(), summaryRepairKey, out, false, nil,
+				func(input runtime.Object, _ storage.ResponseMeta) (runtime.Object, *uint64, error) {
+					current := input.(*softwarecomposition.VulnerabilityManifestSummary).DeepCopy()
+					current.Annotations["kubescape.io/timestamp"] = "1788393600"
+					return current, nil, nil
+				}, &listed))
+			require.Equal(t, test.afterVersion, out.ResourceVersion)
+		})
+	}
+}
