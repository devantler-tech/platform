+// Metadata JSON and retained Gob payloads must agree at Kubernetes' wire precision.
+// saveObject preserves fractional seconds in Gob but metav1.Time JSON emits whole seconds.
+func TestSummaryMetadataRepairCreationTimestampWirePrecision(t *testing.T) {
+	for _, native := range []bool{false, true} {
+		for _, coherent := range []bool{false, true} {
+			t.Run(fmt.Sprintf("native=%t/coherent=%t", native, coherent), func(t *testing.T) {
+				meta := metav1.ObjectMeta{
+					Name: "deployment-example-app", Namespace: "example", UID: types.UID("retained-identity"),
+					CreationTimestamp: metav1.NewTime(time.Date(2026, 9, 1, 0, 0, 0, 123456789, time.UTC)),
+					Annotations:       map[string]string{"kubescape.io/timestamp": "1788220800"},
+				}
+				var obj runtime.Object = &v1beta1.VulnerabilityManifestSummary{ObjectMeta: meta}
+				if native {
+					obj = &softwarecomposition.VulnerabilityManifestSummary{ObjectMeta: meta}
+				}
+				f := newSplitSummaryObject(t, obj)
+				if coherent {
+					require.NoError(t, f.store.saveObject(f.conn, summaryRepairKey, obj, nil, ""))
+				}
+				payload, err := afero.ReadFile(f.fs, filepath.Join(f.root, summaryRepairKey)+GobExt)
+				require.NoError(t, err)
+				report, err := ReconcileVulnerabilitySummaryMetadata(context.Background(), f.fs, f.root, f.pool)
+				require.NoError(t, err)
+				if coherent {
+					require.Equal(t, SummaryMetadataRepairReport{Examined: 1, Unchanged: 1}, report)
+				} else {
+					require.Equal(t, SummaryMetadataRepairReport{Examined: 1, Repaired: 1}, report)
+				}
+				retained, err := afero.ReadFile(f.fs, filepath.Join(f.root, summaryRepairKey)+GobExt)
+				require.NoError(t, err)
+				require.Equal(t, payload, retained, "the fractional timestamp in the retained payload must stay intact")
+				metadata, err := ReadMetadata(f.conn, summaryRepairKey)
+				require.NoError(t, err)
+				var listed metav1.Object
+				if native {
+					listed = &softwarecomposition.VulnerabilityManifestSummary{}
+				} else {
+					listed = &v1beta1.VulnerabilityManifestSummary{}
+				}
+				require.NoError(t, json.Unmarshal(metadata, listed))
+				require.Equal(t, types.UID("retained-identity"), listed.GetUID())
+				require.Equal(t, "2026-09-01T00:00:00Z", listed.GetCreationTimestamp().UTC().Format(time.RFC3339Nano))
+				out := obj.DeepCopyObject()
+				require.NoError(t, f.store.GuaranteedUpdate(context.Background(), summaryRepairKey, out, false, nil,
+					func(input runtime.Object, _ storage.ResponseMeta) (runtime.Object, *uint64, error) {
+						current := input.DeepCopyObject()
+						current.(metav1.Object).GetAnnotations()["kubescape.io/timestamp"] = "1788393600"
+						return current, nil, nil
+					}, listed.(runtime.Object)))
+				if coherent {
+					require.Equal(t, "4", out.(metav1.Object).GetResourceVersion())
+				} else {
+					require.Equal(t, "3", out.(metav1.Object).GetResourceVersion())
+				}
+			})
+		}
+	}
+}
