+func TestSummaryMetadataRepairRefusesUnprovenInternalRecords(t *testing.T) {
+	for _, change := range []string{"replacement UID", "creation time", "metadata ahead", "backward scan", "future scan"} {
+		t.Run(change, func(t *testing.T) {
+			obj := &softwarecomposition.VulnerabilityManifestSummary{ObjectMeta: metav1.ObjectMeta{
+				Name: "deployment-example-app", Namespace: "example", UID: types.UID("retained-identity"),
+				CreationTimestamp: metav1.NewTime(time.Date(2026, 9, 1, 0, 0, 0, 0, time.UTC)),
+				Annotations:       map[string]string{"kubescape.io/timestamp": "1788220800"},
+			}}
+			f := newSplitSummaryObject(t, obj)
+			var listed softwarecomposition.VulnerabilityManifestSummary
+			require.NoError(t, json.Unmarshal(f.oldMetadata, &listed))
+			switch change {
+			case "replacement UID":
+				listed.UID = "replacement"
+			case "creation time":
+				listed.CreationTimestamp = metav1.Now()
+			case "metadata ahead":
+				listed.ResourceVersion = "3"
+			case "backward scan":
+				listed.Annotations["kubescape.io/timestamp"] = "1788393600"
+			case "future scan":
+				obj.Annotations["kubescape.io/timestamp"] = fmt.Sprint(time.Now().Add(time.Hour).Unix())
+				// Preserve the one-version split with a future-dated payload.
+				var buf bytes.Buffer
+				require.NoError(t, gob.NewEncoder(&buf).Encode(obj))
+				require.NoError(t, afero.WriteFile(f.fs, filepath.Join(f.root, summaryRepairKey)+GobExt, buf.Bytes(), 0600))
+			}
+			require.NoError(t, writeMetadata(f.conn, summaryRepairKey, &listed))
+			before, err := ReadMetadata(f.conn, summaryRepairKey)
+			require.NoError(t, err)
+			path := filepath.Join(f.root, summaryRepairKey) + GobExt
+			payload, err := afero.ReadFile(f.fs, path)
+			require.NoError(t, err)
+			report, err := ReconcileVulnerabilitySummaryMetadata(context.Background(), f.fs, f.root, f.pool)
+			require.Error(t, err)
+			require.Equal(t, SummaryMetadataRepairReport{Examined: 1, Refused: 1}, report)
+			after, err := ReadMetadata(f.conn, summaryRepairKey)
+			require.NoError(t, err)
+			require.Equal(t, before, after)
+			retained, err := afero.ReadFile(f.fs, path)
+			require.NoError(t, err)
+			require.Equal(t, payload, retained)
+		})
+	}
+}
