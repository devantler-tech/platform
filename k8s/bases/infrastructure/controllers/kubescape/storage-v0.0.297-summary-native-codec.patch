+func TestSummaryMetadataRetryPublishesInternalWatchObject(t *testing.T) {
+	obj := &softwarecomposition.VulnerabilityManifestSummary{ObjectMeta: metav1.ObjectMeta{
+		Name: "deployment-example-app", Namespace: "example", UID: types.UID("retained-identity"),
+		CreationTimestamp: metav1.NewTime(time.Date(2026, 9, 1, 0, 0, 0, 0, time.UTC)),
+		Annotations:       map[string]string{"kubescape.io/timestamp": "1788220800"},
+	}}
+	f := newSplitSummaryObject(t, obj)
+	w, err := f.store.Watch(context.Background(), "/spdx.softwarecomposition.kubescape.io/vulnerabilitymanifestsummaries", storage.ListOptions{ResourceVersion: softwarecomposition.ResourceVersionFullSpec})
+	require.NoError(t, err)
+	defer w.Stop()
+	out := &softwarecomposition.VulnerabilityManifestSummary{}
+	err = f.store.GuaranteedUpdate(context.Background(), summaryRepairKey, out, false, nil,
+		func(input runtime.Object, _ storage.ResponseMeta) (runtime.Object, *uint64, error) {
+			current := input.(*softwarecomposition.VulnerabilityManifestSummary)
+			require.Equal(t, "2", current.ResourceVersion)
+			return nil, nil, apierrors.NewConflict(schema.GroupResource{Resource: "vulnerabilitymanifestsummaries"}, current.Name, fmt.Errorf("stale scanner version"))
+		}, nil)
+	require.True(t, apierrors.IsConflict(err), "repair must not accept a stale scanner write")
+	select {
+	case event := <-w.ResultChan():
+		current, ok := event.Object.(*softwarecomposition.VulnerabilityManifestSummary)
+		require.True(t, ok, "the API watch must retain its internal runtime type")
+		require.Equal(t, "2", current.ResourceVersion)
+		require.Equal(t, types.UID("retained-identity"), current.UID)
+	case <-time.After(5 * time.Second):
+		t.Fatal("the repaired summary was not published to existing watches")
+	}
+}
