+func TestSummaryMetadataRepairRefusesAmbiguousCodec(t *testing.T) {
+	f := newSplitSummary(t)
+	var shape map[string]json.RawMessage
+	require.NoError(t, json.Unmarshal(f.oldMetadata, &shape))
+	shape["uid"] = json.RawMessage(`"shadow-identity"`)
+	before, err := json.Marshal(shape)
+	require.NoError(t, err)
+	require.NoError(t, WriteJSON(f.conn, summaryRepairKey, before))
+	report, err := ReconcileVulnerabilitySummaryMetadata(context.Background(), f.fs, f.root, f.pool)
+	require.Error(t, err)
+	require.Equal(t, 1, report.Refused)
+	require.Zero(t, report.Repaired)
+	after, err := ReadMetadata(f.conn, summaryRepairKey)
+	require.NoError(t, err)
+	require.Equal(t, before, after)
+}
