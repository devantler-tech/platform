diff --git a/pkg/registry/file/object_presence.go b/pkg/registry/file/object_presence.go
new file mode 100644
index 00000000..0c81e757
--- /dev/null
+++ b/pkg/registry/file/object_presence.go
@@ -0,0 +1,329 @@
+package file
+
+import (
+	"context"
+	"fmt"
+	"strings"
+	"sync"
+	"time"
+
+	helpersv1 "github.com/kubescape/k8s-interface/instanceidhandler/v1/helpers"
+	apierrors "k8s.io/apimachinery/pkg/api/errors"
+	"k8s.io/apimachinery/pkg/api/meta"
+	metav1 "k8s.io/apimachinery/pkg/apis/meta/v1"
+	"k8s.io/apimachinery/pkg/runtime/schema"
+	"k8s.io/client-go/discovery"
+	"k8s.io/client-go/discovery/cached/memory"
+	"k8s.io/client-go/metadata"
+	"k8s.io/client-go/rest"
+	"k8s.io/client-go/restmapper"
+)
+
+// ObjectPresence is the outcome of asking the cluster whether one scanned object still exists.
+// The zero value is ObjectPresenceUnknown, so an unset, failed or partial lookup can never be
+// read as proof of absence.
+type ObjectPresence int
+
+const (
+	// ObjectPresenceUnknown means the lookup proved nothing: the record must be kept.
+	ObjectPresenceUnknown ObjectPresence = iota
+	// ObjectPresencePresent means the object was read back from the cluster.
+	ObjectPresencePresent
+	// ObjectPresenceAbsent means the cluster positively answered that the named object does not exist.
+	ObjectPresenceAbsent
+)
+
+// ObjectRef identifies one scanned Kubernetes object.
+type ObjectRef struct {
+	Group     string
+	Version   string
+	Kind      string
+	Namespace string
+	Name      string
+}
+
+// ObjectPresenceFunc looks up one object. A nil func means the lookup is not available.
+type ObjectPresenceFunc func(ref ObjectRef) ObjectPresence
+
+// ObjectPresenceChecker is optionally implemented by a ResourcesFetcher that can look up
+// individual objects of kinds the workload discovery does not list.
+type ObjectPresenceChecker interface {
+	ObjectPresence(ctx context.Context, ref ObjectRef) ObjectPresence
+}
+
+const objectPresenceLookupTimeout = 10 * time.Second
+
+// objectPresenceDeniedFor is how long a refused resource is not asked for again. It is shorter
+// than a cleanup interval, so each pass spends one request finding out whether access changed.
+const objectPresenceDeniedFor = time.Hour
+
+// The lookups are single-object reads made once per cleanup pass.
+const (
+	objectPresenceQPS   = 50
+	objectPresenceBurst = 100
+)
+
+// objectPresencePassBudget bounds the lookups of one cleanup pass. Records not reached within it
+// are kept and looked at again on the next pass.
+const objectPresencePassBudget = 10 * time.Minute
+
+// MetadataObjectPresenceChecker answers ObjectPresence with metadata-only GET requests.
+type MetadataObjectPresenceChecker struct {
+	client metadata.Interface
+	mapper meta.RESTMapper
+
+	mu     sync.Mutex
+	denied map[deniedLookup]time.Time
+}
+
+// deniedLookup is a resource and namespace the checker was refused access to.
+type deniedLookup struct {
+	resource  schema.GroupVersionResource
+	namespace string
+}
+
+var _ ObjectPresenceChecker = (*MetadataObjectPresenceChecker)(nil)
+
+func NewMetadataObjectPresenceChecker(client metadata.Interface, mapper meta.RESTMapper) *MetadataObjectPresenceChecker {
+	return &MetadataObjectPresenceChecker{client: client, mapper: mapper, denied: map[deniedLookup]time.Time{}}
+}
+
+// NewInClusterObjectPresenceChecker builds the checker from the same cluster config as the
+// cleanup client.
+func NewInClusterObjectPresenceChecker() (*MetadataObjectPresenceChecker, error) {
+	clusterConfig, err := getConfig()
+	if err != nil {
+		return nil, fmt.Errorf("failed to get cluster config: %w", err)
+	}
+	clusterConfig = rest.CopyConfig(clusterConfig)
+	clusterConfig.QPS = objectPresenceQPS
+	clusterConfig.Burst = objectPresenceBurst
+	metadataClient, err := metadata.NewForConfig(clusterConfig)
+	if err != nil {
+		return nil, fmt.Errorf("failed to create metadata client: %w", err)
+	}
+	discoveryClient, err := discovery.NewDiscoveryClientForConfig(clusterConfig)
+	if err != nil {
+		return nil, fmt.Errorf("failed to create discovery client: %w", err)
+	}
+	mapper := restmapper.NewDeferredDiscoveryRESTMapper(memory.NewMemCacheClient(discoveryClient))
+	return NewMetadataObjectPresenceChecker(metadataClient, mapper), nil
+}
+
+// ObjectPresence reports Absent only when the API server answered a GET for exactly this object
+// with NotFound. Every other outcome that is not a successful read is Unknown: an unmapped kind,
+// a namespaced kind without a namespace, a denied request, a timeout, a server error, and a
+// NotFound that is about the resource type rather than the named object.
+func (c *MetadataObjectPresenceChecker) ObjectPresence(ctx context.Context, ref ObjectRef) ObjectPresence {
+	if c == nil || c.client == nil || c.mapper == nil {
+		return ObjectPresenceUnknown
+	}
+	if ref.Kind == "" || ref.Version == "" || ref.Name == "" {
+		return ObjectPresenceUnknown
+	}
+	mapping, err := c.mapper.RESTMapping(schema.GroupKind{Group: ref.Group, Kind: ref.Kind}, ref.Version)
+	if err != nil || mapping == nil || mapping.Scope == nil {
+		return ObjectPresenceUnknown
+	}
+
+	var getter metadata.ResourceInterface
+	switch mapping.Scope.Name() {
+	case meta.RESTScopeNameNamespace:
+		if ref.Namespace == "" {
+			return ObjectPresenceUnknown
+		}
+		getter = c.client.Resource(mapping.Resource).Namespace(ref.Namespace)
+	case meta.RESTScopeNameRoot:
+		if ref.Namespace != "" {
+			return ObjectPresenceUnknown
+		}
+		getter = c.client.Resource(mapping.Resource)
+	default:
+		return ObjectPresenceUnknown
+	}
+
+	deniedKey := deniedLookup{resource: mapping.Resource, namespace: ref.Namespace}
+	if c.recentlyDenied(deniedKey) {
+		return ObjectPresenceUnknown
+	}
+
+	ctx, cancel := context.WithTimeout(ctx, objectPresenceLookupTimeout)
+	defer cancel()
+	found, err := getter.Get(ctx, ref.Name, metav1.GetOptions{})
+	if apierrors.IsForbidden(err) {
+		c.rememberDenied(deniedKey)
+	}
+	return classifyObjectLookup(ref, mapping.Resource, found, err)
+}
+
+func (c *MetadataObjectPresenceChecker) recentlyDenied(key deniedLookup) bool {
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	until, ok := c.denied[key]
+	if !ok {
+		return false
+	}
+	if time.Now().Before(until) {
+		return true
+	}
+	delete(c.denied, key)
+	return false
+}
+
+func (c *MetadataObjectPresenceChecker) rememberDenied(key deniedLookup) {
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	if c.denied == nil {
+		c.denied = map[deniedLookup]time.Time{}
+	}
+	c.denied[key] = time.Now().Add(objectPresenceDeniedFor)
+}
+
+func classifyObjectLookup(ref ObjectRef, resource schema.GroupVersionResource, found *metav1.PartialObjectMetadata, err error) ObjectPresence {
+	if err == nil {
+		if found == nil || found.Name != ref.Name || found.Namespace != ref.Namespace {
+			return ObjectPresenceUnknown
+		}
+		return ObjectPresencePresent
+	}
+	if !apierrors.IsNotFound(err) {
+		return ObjectPresenceUnknown
+	}
+	// A NotFound for an unserved resource type carries no object name. Only the object-level
+	// answer, which names the object and its resource, proves absence.
+	status, ok := err.(apierrors.APIStatus)
+	if !ok {
+		return ObjectPresenceUnknown
+	}
+	details := status.Status().Details
+	if details == nil || details.Name != ref.Name || details.Kind != resource.Resource || details.Group != resource.Group {
+		return ObjectPresenceUnknown
+	}
+	// a response the client could not decode is described with the request it made, not by the server
+	for _, cause := range details.Causes {
+		if cause.Type == metav1.CauseTypeUnexpectedServerResponse {
+			return ObjectPresenceUnknown
+		}
+	}
+	return ObjectPresenceAbsent
+}
+
+// memoizeObjectPresence answers repeated lookups of one object within a single cleanup pass
+// from the first answer, so a scan record and its summary cost one request. After the deadline
+// it stops asking, so a slow or unreachable API server cannot hold the pass open.
+func memoizeObjectPresence(lookup ObjectPresenceFunc, deadline time.Time) ObjectPresenceFunc {
+	if lookup == nil {
+		return nil
+	}
+	var mu sync.Mutex
+	seen := map[ObjectRef]ObjectPresence{}
+	return func(ref ObjectRef) ObjectPresence {
+		mu.Lock()
+		defer mu.Unlock()
+		if presence, ok := seen[ref]; ok {
+			return presence
+		}
+		if !time.Now().Before(deadline) {
+			return ObjectPresenceUnknown
+		}
+		presence := lookup(ref)
+		seen[ref] = presence
+		return presence
+	}
+}
+
+// bindingKinds are the scan subjects a relation record (a subject, its role and the binding
+// that joins them) is filed under. Such a record cannot outlive its binding.
+var bindingKinds = map[string]ObjectRef{
+	"rolebinding":        {Group: "rbac.authorization.k8s.io", Version: "v1", Kind: "RoleBinding"},
+	"clusterrolebinding": {Group: "rbac.authorization.k8s.io", Version: "v1", Kind: "ClusterRoleBinding"},
+}
+
+// scannedObjectRef derives the object a scan record describes, or reports false when the
+// record's own metadata does not identify exactly one object.
+//
+// The workload id carries the full object name, while the name label is capped at the label
+// length limit. A record is therefore resolved from its labels only when the workload id
+// spells the same kind and name, which a truncated label never does. A relation record whose
+// workload id names a binding is resolved to that binding.
+func scannedObjectRef(metadata *metav1.ObjectMeta) (ObjectRef, bool) {
+	if metadata == nil {
+		return ObjectRef{}, false
+	}
+	namespace, tail, ok := splitWlid(metadata.Annotations[helpersv1.WlidMetadataKey])
+	if !ok {
+		return ObjectRef{}, false
+	}
+	labelKind := metadata.Labels[helpersv1.RelatedKindMetadataKey]
+	labelName := metadata.Labels[helpersv1.RelatedNameMetadataKey]
+	labelNamespace, hasLabelNamespace := metadata.Labels[helpersv1.RelatedNamespaceMetadataKey]
+
+	if labelKind != "" && labelName != "" && tail == strings.ToLower(labelKind)+"-"+labelName {
+		if hasLabelNamespace && labelNamespace != namespace {
+			return ObjectRef{}, false
+		}
+		version := metadata.Labels[helpersv1.ApiVersionMetadataKey]
+		if version == "" {
+			return ObjectRef{}, false
+		}
+		return ObjectRef{
+			Group:     metadata.Labels[helpersv1.ApiGroupMetadataKey],
+			Version:   version,
+			Kind:      labelKind,
+			Namespace: namespace,
+			Name:      labelName,
+		}, true
+	}
+
+	kind, name, found := strings.Cut(tail, "-")
+	if !found || name == "" {
+		return ObjectRef{}, false
+	}
+	ref, isBinding := bindingKinds[kind]
+	if !isBinding || !recordIsAboutBinding(metadata, kind, namespace, ref.Group) {
+		return ObjectRef{}, false
+	}
+	ref.Namespace = namespace
+	ref.Name = name
+	return ref, true
+}
+
+// recordIsAboutBinding reports whether the record itself says its workload id names an RBAC
+// binding: either it describes that binding, or it is a relation record filed under one. A
+// kind that merely shares the name in another API group is neither.
+func recordIsAboutBinding(metadata *metav1.ObjectMeta, wlidKind, wlidNamespace, rbacGroup string) bool {
+	if strings.ToLower(metadata.Labels[helpersv1.RelatedKindMetadataKey]) == wlidKind {
+		labelNamespace, hasLabelNamespace := metadata.Labels[helpersv1.RelatedNamespaceMetadataKey]
+		if hasLabelNamespace && labelNamespace != wlidNamespace {
+			return false
+		}
+		return metadata.Labels[helpersv1.ApiGroupMetadataKey] == rbacGroup
+	}
+	if metadata.Labels[helpersv1.RbacResourceMetadataKey] != "true" {
+		return false
+	}
+	if wlidKind == "clusterrolebinding" {
+		return metadata.Labels[helpersv1.ClusterRoleBindingNameMetadataKey] != ""
+	}
+	// the subject may live elsewhere, so the binding namespace has its own label
+	bindingNamespace, hasBindingNamespace := metadata.Labels[helpersv1.RoleBindingNamespaceMetadataKey]
+	return hasBindingNamespace && bindingNamespace == wlidNamespace && metadata.Labels[helpersv1.RoleBindingNameMetadataKey] != ""
+}
+
+// splitWlid returns the namespace and the "<kind>-<name>" tail of
+// wlid://cluster-<cluster>/namespace-<namespace>/<kind>-<name>.
+func splitWlid(wlid string) (namespace, tail string, ok bool) {
+	rest, found := strings.CutPrefix(wlid, "wlid://")
+	if !found {
+		return "", "", false
+	}
+	parts := strings.Split(rest, "/")
+	if len(parts) != 3 || !strings.HasPrefix(parts[0], "cluster-") || parts[2] == "" {
+		return "", "", false
+	}
+	namespace, found = strings.CutPrefix(parts[1], "namespace-")
+	if !found {
+		return "", "", false
+	}
+	return namespace, parts[2], true
+}
