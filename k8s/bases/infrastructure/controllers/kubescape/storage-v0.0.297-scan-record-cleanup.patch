@@ -0,0 +1,521 @@
+package file
+
+import (
+	"context"
+	"errors"
+	"net/http"
+	"net/http/httptest"
+	"strings"
+	"testing"
+	"time"
+
+	mapset "github.com/deckarep/golang-set/v2"
+	"github.com/goradd/maps"
+	helpersv1 "github.com/kubescape/k8s-interface/instanceidhandler/v1/helpers"
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+	apierrors "k8s.io/apimachinery/pkg/api/errors"
+	"k8s.io/apimachinery/pkg/api/meta"
+	metav1 "k8s.io/apimachinery/pkg/apis/meta/v1"
+	"k8s.io/apimachinery/pkg/runtime"
+	"k8s.io/apimachinery/pkg/runtime/schema"
+	"k8s.io/client-go/metadata"
+	metadatafake "k8s.io/client-go/metadata/fake"
+	"k8s.io/client-go/rest"
+	clienttesting "k8s.io/client-go/testing"
+	"zombiezen.com/go/sqlite"
+)
+
+type skippedKind struct {
+	group      string
+	kind       string
+	resource   string
+	namespaced bool
+}
+
+// The kinds the upstream cleanup always kept, as observed in production scan records.
+var skippedKinds = []skippedKind{
+	{"rbac.authorization.k8s.io", "Role", "roles", true},
+	{"rbac.authorization.k8s.io", "RoleBinding", "rolebindings", true},
+	{"rbac.authorization.k8s.io", "ClusterRoleBinding", "clusterrolebindings", false},
+	{"", "ServiceAccount", "serviceaccounts", true},
+	{"", "Secret", "secrets", true},
+	{"", "ConfigMap", "configmaps", true},
+	{"", "PersistentVolume", "persistentvolumes", false},
+}
+
+func testMapper() meta.RESTMapper {
+	mapper := meta.NewDefaultRESTMapper(nil)
+	for _, k := range skippedKinds {
+		scope := meta.RESTScopeRoot
+		if k.namespaced {
+			scope = meta.RESTScopeNamespace
+		}
+		mapper.AddSpecific(
+			schema.GroupVersionKind{Group: k.group, Version: "v1", Kind: k.kind},
+			schema.GroupVersionResource{Group: k.group, Version: "v1", Resource: k.resource},
+			schema.GroupVersionResource{Group: k.group, Version: "v1", Resource: strings.TrimSuffix(k.resource, "s")},
+			scope,
+		)
+	}
+	return mapper
+}
+
+func liveObject(k skippedKind, namespace, name string) *metav1.PartialObjectMetadata {
+	apiVersion := "v1"
+	if k.group != "" {
+		apiVersion = k.group + "/v1"
+	}
+	return &metav1.PartialObjectMetadata{
+		TypeMeta:   metav1.TypeMeta{APIVersion: apiVersion, Kind: k.kind},
+		ObjectMeta: metav1.ObjectMeta{Namespace: namespace, Name: name},
+	}
+}
+
+func testChecker(objects ...runtime.Object) (*MetadataObjectPresenceChecker, *metadatafake.FakeMetadataClient) {
+	scheme := runtime.NewScheme()
+	if err := metav1.AddMetaToScheme(scheme); err != nil {
+		panic(err)
+	}
+	client := metadatafake.NewSimpleMetadataClient(scheme, objects...)
+	return NewMetadataObjectPresenceChecker(client, testMapper()), client
+}
+
+func refFor(k skippedKind, name string) ObjectRef {
+	ref := ObjectRef{Group: k.group, Version: "v1", Kind: k.kind, Name: name}
+	if k.namespaced {
+		ref.Namespace = "unifi"
+	}
+	return ref
+}
+
+func TestObjectPresenceForEverySkippedKind(t *testing.T) {
+	for _, k := range skippedKinds {
+		t.Run(k.kind, func(t *testing.T) {
+			live := refFor(k, "still-here")
+			checker, _ := testChecker(liveObject(k, live.Namespace, live.Name))
+
+			// negative control: the object exists, so nothing may read as absent
+			assert.Equal(t, ObjectPresencePresent, checker.ObjectPresence(context.Background(), live))
+			assert.Equal(t, ObjectPresenceAbsent, checker.ObjectPresence(context.Background(), refFor(k, "tf-runner")))
+		})
+	}
+}
+
+func TestObjectPresenceIsUnknownWhenTheLookupProvesNothing(t *testing.T) {
+	role := skippedKinds[0]
+	ref := refFor(role, "tf-runner")
+
+	failures := map[string]error{
+		"denied":            apierrors.NewForbidden(schema.GroupResource{Group: role.group, Resource: role.resource}, ref.Name, errors.New("denied")),
+		"timeout":           apierrors.NewTimeoutError("slow", 1),
+		"server error":      apierrors.NewInternalError(errors.New("boom")),
+		"unavailable":       apierrors.NewServiceUnavailable("down"),
+		"too many requests": apierrors.NewTooManyRequests("busy", 1),
+		"transport":         errors.New("connection refused"),
+		// the API server answers like this when the resource type itself is not served
+		"resource type not found":        &apierrors.StatusError{ErrStatus: metav1.Status{Status: metav1.StatusFailure, Code: 404, Reason: metav1.StatusReasonNotFound, Message: "the server could not find the requested resource"}},
+		"not found for another object":   apierrors.NewNotFound(schema.GroupResource{Group: role.group, Resource: role.resource}, "someone-else"),
+		"not found for another resource": apierrors.NewNotFound(schema.GroupResource{Group: role.group, Resource: "rolebindings"}, ref.Name),
+		"not found in another group":     apierrors.NewNotFound(schema.GroupResource{Group: "iam.example.io", Resource: role.resource}, ref.Name),
+		"not found built from an undecodable response": func() error {
+			notFound := apierrors.NewNotFound(schema.GroupResource{Group: role.group, Resource: role.resource}, ref.Name)
+			notFound.ErrStatus.Details.Causes = []metav1.StatusCause{{Type: metav1.CauseTypeUnexpectedServerResponse, Message: "404 page not found"}}
+			return notFound
+		}(),
+	}
+	for name, failure := range failures {
+		t.Run(name, func(t *testing.T) {
+			checker, client := testChecker()
+			client.PrependReactor("get", "*", func(clienttesting.Action) (bool, runtime.Object, error) {
+				return true, nil, failure
+			})
+			assert.Equal(t, ObjectPresenceUnknown, checker.ObjectPresence(context.Background(), ref))
+		})
+	}
+
+	t.Run("positive control: the same request with an object-level not found is absent", func(t *testing.T) {
+		checker, client := testChecker()
+		client.PrependReactor("get", "*", func(clienttesting.Action) (bool, runtime.Object, error) {
+			return true, nil, apierrors.NewNotFound(schema.GroupResource{Group: role.group, Resource: role.resource}, ref.Name)
+		})
+		assert.Equal(t, ObjectPresenceAbsent, checker.ObjectPresence(context.Background(), ref))
+	})
+
+	checker, _ := testChecker()
+	unresolvable := map[string]ObjectRef{
+		"kind the cluster does not serve":    {Group: "hostdata.kubescape.cloud", Version: "v1beta0", Kind: "KubeletInfo", Name: "node-1"},
+		"version the cluster does not serve": {Group: role.group, Version: "v1beta1", Kind: role.kind, Namespace: "unifi", Name: "tf-runner"},
+		"namespaced kind without namespace":  {Group: role.group, Version: "v1", Kind: role.kind, Name: "tf-runner"},
+		"cluster kind with a namespace":      {Group: role.group, Version: "v1", Kind: "ClusterRoleBinding", Namespace: "unifi", Name: "tf-runner"},
+		"no name":                            {Group: role.group, Version: "v1", Kind: role.kind, Namespace: "unifi"},
+		"no version":                         {Group: role.group, Kind: role.kind, Namespace: "unifi", Name: "tf-runner"},
+		"no kind":                            {Group: role.group, Version: "v1", Namespace: "unifi", Name: "tf-runner"},
+	}
+	for name, ref := range unresolvable {
+		t.Run(name, func(t *testing.T) {
+			assert.Equal(t, ObjectPresenceUnknown, checker.ObjectPresence(context.Background(), ref))
+		})
+	}
+
+	t.Run("checker without a client", func(t *testing.T) {
+		var missing *MetadataObjectPresenceChecker
+		assert.Equal(t, ObjectPresenceUnknown, missing.ObjectPresence(context.Background(), ref))
+		assert.Equal(t, ObjectPresenceUnknown, (&MetadataObjectPresenceChecker{}).ObjectPresence(context.Background(), ref))
+		assert.Equal(t, ObjectPresenceUnknown, (&KubernetesAPI{}).ObjectPresence(context.Background(), ref))
+	})
+
+	t.Run("a read that returns a different object", func(t *testing.T) {
+		resource := schema.GroupVersionResource{Group: role.group, Version: "v1", Resource: role.resource}
+		assert.Equal(t, ObjectPresenceUnknown, classifyObjectLookup(ref, resource, liveObject(role, "unifi", "other"), nil))
+		assert.Equal(t, ObjectPresenceUnknown, classifyObjectLookup(ref, resource, nil, nil))
+		assert.Equal(t, ObjectPresenceUnknown, classifyObjectLookup(ref, resource, liveObject(role, "elsewhere", ref.Name), nil))
+		assert.Equal(t, ObjectPresencePresent, classifyObjectLookup(ref, resource, liveObject(role, ref.Namespace, ref.Name), nil))
+	})
