+func TestMemoizeObjectPresence(t *testing.T) {
+	assert.Nil(t, memoizeObjectPresence(nil, time.Now().Add(time.Hour)))
+
+	calls := map[ObjectRef]int{}
+	lookup := memoizeObjectPresence(func(ref ObjectRef) ObjectPresence {
+		calls[ref]++
+		if ref.Name == "gone" {
+			return ObjectPresenceAbsent
+		}
+		return ObjectPresencePresent
+	}, time.Now().Add(time.Hour))
+	gone := ObjectRef{Version: "v1", Kind: "Secret", Namespace: "unifi", Name: "gone"}
+	here := ObjectRef{Version: "v1", Kind: "Secret", Namespace: "unifi", Name: "here"}
+	for range 3 {
+		assert.Equal(t, ObjectPresenceAbsent, lookup(gone))
+		assert.Equal(t, ObjectPresencePresent, lookup(here))
+	}
+	assert.Equal(t, map[ObjectRef]int{gone: 1, here: 1}, calls)
+
+	t.Run("after the pass budget nothing is asked and nothing is absent", func(t *testing.T) {
+		expired := memoizeObjectPresence(func(ObjectRef) ObjectPresence {
+			t.Fatal("no lookup may be made after the pass budget")
+			return ObjectPresenceAbsent
+		}, time.Now())
+		assert.Equal(t, ObjectPresenceUnknown, expired(gone))
+	})
+}
