+func TestObjectPresenceAgainstRealServerAnswers(t *testing.T) {
+	role := skippedKinds[0]
+	ref := refFor(role, "tf-runner")
+	objectNotFound := `{"kind":"Status","apiVersion":"v1","status":"Failure","reason":"NotFound","code":404,` +
+		`"message":"roles.rbac.authorization.k8s.io \"tf-runner\" not found",` +
+		`"details":{"name":"tf-runner","group":"rbac.authorization.k8s.io","kind":"roles"}}`
+	live := `{"kind":"PartialObjectMetadata","apiVersion":"meta.k8s.io/v1","metadata":{"name":"tf-runner","namespace":"unifi"}}`
+
+	answers := map[string]struct {
+		code        int
+		contentType string
+		body        string
+		want        ObjectPresence
+	}{
+		"object-level not found":          {http.StatusNotFound, "application/json", objectNotFound, ObjectPresenceAbsent},
+		"object read back":                {http.StatusOK, "application/json", live, ObjectPresencePresent},
+		"plain text not found":            {http.StatusNotFound, "text/plain", "404 page not found\n", ObjectPresenceUnknown},
+		"empty not found":                 {http.StatusNotFound, "", "", ObjectPresenceUnknown},
+		"status not found without detail": {http.StatusNotFound, "application/json", `{"kind":"Status","apiVersion":"v1","status":"Failure","reason":"NotFound","code":404}`, ObjectPresenceUnknown},
+		"gone":                            {http.StatusGone, "text/plain", "gone", ObjectPresenceUnknown},
+		"forbidden":                       {http.StatusForbidden, "text/plain", "forbidden", ObjectPresenceUnknown},
+		"bad gateway":                     {http.StatusBadGateway, "text/html", "<html>bad gateway</html>", ObjectPresenceUnknown},
+	}
+	for name, answer := range answers {
+		t.Run(name, func(t *testing.T) {
+			var requested string
+			server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+				requested = r.Method + " " + r.URL.Path
+				if answer.contentType != "" {
+					w.Header().Set("Content-Type", answer.contentType)
+				}
+				w.WriteHeader(answer.code)
+				_, _ = w.Write([]byte(answer.body))
+			}))
+			defer server.Close()
+
+			client, err := metadata.NewForConfig(&rest.Config{Host: server.URL})
+			require.NoError(t, err)
+			checker := NewMetadataObjectPresenceChecker(client, testMapper())
+
+			assert.Equal(t, answer.want, checker.ObjectPresence(context.Background(), ref))
+			assert.Equal(t, "GET /apis/rbac.authorization.k8s.io/v1/namespaces/unifi/roles/tf-runner", requested, "exactly one object is read, nothing is listed or written")
+		})
+	}
+}
