+func scanRecord(wlid string, labels map[string]string) *metav1.ObjectMeta {
+	return &metav1.ObjectMeta{
+		Labels:      labels,
+		Annotations: map[string]string{helpersv1.WlidMetadataKey: wlid},
+	}
+}
+
+func objectLabels(group, version, kind, name, namespace string) map[string]string {
+	labels := map[string]string{
+		helpersv1.ApiGroupMetadataKey:    group,
+		helpersv1.ApiVersionMetadataKey:  version,
+		helpersv1.RelatedKindMetadataKey: kind,
+		helpersv1.RelatedNameMetadataKey: name,
+	}
+	if namespace != "" {
+		labels[helpersv1.RelatedNamespaceMetadataKey] = namespace
+	}
+	return labels
+}
+
+func withLabel(labels map[string]string, key, value string) map[string]string {
+	labels[key] = value
+	return labels
+}
+
+func relationLabels(labels map[string]string, bindingNameKey, bindingName string) map[string]string {
+	labels[helpersv1.RbacResourceMetadataKey] = "true"
+	labels[bindingNameKey] = bindingName
+	return labels
+}
