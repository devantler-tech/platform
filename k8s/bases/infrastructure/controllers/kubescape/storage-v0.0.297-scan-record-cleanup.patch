+// deleteScanRecordByWlid is deleteByWlid for configuration scan records. Those also describe
+// objects the workload discovery does not list, so such an object is looked up by itself and
+// its record removed only on a positive absent answer.
+func deleteScanRecordByWlid(kind, path string, metadata *metav1.ObjectMeta, resourceMaps ResourceMaps) bool {
+	wlidKind := strings.ToLower(wlidPkg.GetKindFromWlid(metadata.Annotations[helpersv1.WlidMetadataKey]))
+	if wlidKind == "" || isCleanableWlidKind(wlidKind) {
+		return deleteByWlid(kind, path, metadata, resourceMaps)
+	}
+	return scannedObjectIsAbsent(metadata, resourceMaps)
