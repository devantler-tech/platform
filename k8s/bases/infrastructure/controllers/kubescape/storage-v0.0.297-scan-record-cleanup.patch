+func TestDeleteScanRecordByWlidRemovesOnlyPositivelyAbsentObjects(t *testing.T) {
+	const rbac = "rbac.authorization.k8s.io"
+	record := scanRecord("wlid://cluster-prod/namespace-unifi/role-tf-runner", objectLabels(rbac, "v1", "Role", "tf-runner", "unifi"))
+	want := ObjectRef{Group: rbac, Version: "v1", Kind: "Role", Namespace: "unifi", Name: "tf-runner"}
+
+	answer := func(presence ObjectPresence) ResourceMaps {
+		resources := emptyResourceMaps()
+		resources.ObjectPresence = func(ref ObjectRef) ObjectPresence {
+			assert.Equal(t, want, ref)
+			return presence
+		}
+		return resources
+	}
+
+	assert.True(t, deleteScanRecordByWlid("", "", record, answer(ObjectPresenceAbsent)))
+	assert.False(t, deleteScanRecordByWlid("", "", record, answer(ObjectPresencePresent)))
+	assert.False(t, deleteScanRecordByWlid("", "", record, answer(ObjectPresenceUnknown)))
+	assert.False(t, deleteScanRecordByWlid("", "", record, emptyResourceMaps()), "no lookup available keeps the record")
+
+	t.Run("a record that does not identify one object is kept without a lookup", func(t *testing.T) {
+		resources := emptyResourceMaps()
+		resources.ObjectPresence = func(ObjectRef) ObjectPresence {
+			t.Fatal("no lookup may be made for an unidentified object")
+			return ObjectPresenceAbsent
+		}
+		truncated := scanRecord("wlid://cluster-prod/namespace-unifi/role-tf-runner-with-a-longer-name", objectLabels(rbac, "v1", "Role", "tf-runner", "unifi"))
+		assert.False(t, deleteScanRecordByWlid("", "", truncated, resources))
+	})
+
+	t.Run("other record types keep the upstream rule and are never looked up", func(t *testing.T) {
+		resources := emptyResourceMaps()
+		resources.ObjectPresence = func(ObjectRef) ObjectPresence {
+			t.Fatal("only configuration scan records may be looked up")
+			return ObjectPresenceAbsent
+		}
+		assert.False(t, deleteByWlid("", "", record, resources))
+		assert.False(t, deleteByTemplateHashOrWlid("", "", record, resources))
+		handlers := initResourceToKindHandler(true)
+		for resourceKind, registered := range handlers {
+			scanRecords := resourceKind == "workloadconfigurationscans" || resourceKind == "workloadconfigurationscansummaries"
+			if scanRecords {
+				continue
+			}
+			for _, handler := range registered {
+				handler(resourceKind, "", record.DeepCopy(), resources)
+			}
+		}
+		for _, resourceKind := range []string{"workloadconfigurationscans", "workloadconfigurationscansummaries"} {
+			require.Len(t, handlers[resourceKind], 1)
+			assert.True(t, handlers[resourceKind][0](resourceKind, "", record, answer(ObjectPresenceAbsent)))
+		}
+	})
+
+	t.Run("workload kinds keep using the workload discovery", func(t *testing.T) {
+		resources := emptyResourceMaps()
+		resources.ObjectPresence = func(ObjectRef) ObjectPresence {
+			t.Fatal("workload kinds must not be looked up one by one")
+			return ObjectPresencePresent
+		}
+		deployment := scanRecord("wlid://cluster-prod/namespace-unifi/deployment-web", objectLabels("apps", "v1", "Deployment", "web", "unifi"))
+		assert.True(t, deleteScanRecordByWlid("", "", deployment, resources))
+		resources.RunningWlidsToContainerNames.Set("namespace-unifi/deployment-web", mapset.NewSet[string]("web"))
+		assert.False(t, deleteScanRecordByWlid("", "", deployment, resources))
+	})
+}
