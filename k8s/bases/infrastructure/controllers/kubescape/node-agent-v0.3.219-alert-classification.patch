index 00000000..a9e23b0b
--- /dev/null
+++ b/pkg/rulemanager/rule_manager_alerts_test.go
@@ -0,0 +1,16 @@
+package rulemanager
+
+import "testing"
+
+func TestContainerExited(t *testing.T) {
+	running := make(chan struct{})
+	if containerExited(running) {
+		t.Fatal("an open lifecycle channel must represent a running container")
+	}
+
+	closed := make(chan struct{})
+	close(closed)
+	if !containerExited(closed) {
+		t.Fatal("a closed lifecycle channel must represent an exited container")
+	}
+}
