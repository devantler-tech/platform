diff --git a/pkg/sbommanager/v1/sbom_manager_alerts_test.go b/pkg/sbommanager/v1/sbom_manager_alerts_test.go
new file mode 100644
index 00000000..26678b77
--- /dev/null
+++ b/pkg/sbommanager/v1/sbom_manager_alerts_test.go
@@ -0,0 +1,50 @@
+package v1
+
+import (
+	"errors"
+	"fmt"
+	"os"
+	"testing"
+
+	apierrors "k8s.io/apimachinery/pkg/api/errors"
+	"k8s.io/apimachinery/pkg/runtime/schema"
+)
+
+func TestShouldLogSBOMSaveError(t *testing.T) {
+	resource := schema.GroupResource{Group: "spdx.softwarecomposition.kubescape.io", Resource: "sbomsyfts"}
+	tests := []struct {
+		name string
+		err  error
+		want bool
+	}{
+		{name: "optimistic concurrency conflict", err: apierrors.NewConflict(resource, "example", errors.New("stale resource version")), want: false},
+		{name: "unexpected storage failure", err: errors.New("storage unavailable"), want: true},
+	}
+
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			if got := shouldLogSBOMSaveError(tt.err); got != tt.want {
+				t.Fatalf("shouldLogSBOMSaveError() = %v, want %v", got, tt.want)
+			}
+		})
+	}
+}
+
+func TestShouldLogSBOMGenerationError(t *testing.T) {
+	tests := []struct {
+		name string
+		err  error
+		want bool
+	}{
+		{name: "container filesystem disappeared", err: fmt.Errorf("stat overlay: %w", os.ErrNotExist), want: false},
+		{name: "unexpected scanner failure", err: errors.New("cataloger crashed"), want: true},
+	}
+
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			if got := shouldLogSBOMGenerationError(tt.err); got != tt.want {
+				t.Fatalf("shouldLogSBOMGenerationError() = %v, want %v", got, tt.want)
+			}
+		})
+	}
+}
