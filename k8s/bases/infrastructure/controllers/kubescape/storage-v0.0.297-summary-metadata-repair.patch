--- /dev/null
+++ b/pkg/registry/file/summary_metadata_repair.go
@@ -0,0 +1,211 @@
+package file
+
+import (
+	"context"
+	"encoding/gob"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"io"
+	"os"
+	"path/filepath"
+	"strconv"
+	"strings"
+	"time"
+
+	"github.com/kubescape/storage/pkg/apis/softwarecomposition/v1beta1"
+	"github.com/spf13/afero"
+	"k8s.io/apimachinery/pkg/util/validation"
+	"zombiezen.com/go/sqlite"
+	"zombiezen.com/go/sqlite/sqlitemigration"
+	"zombiezen.com/go/sqlite/sqlitex"
+)
+
+// SummaryMetadataRepairReport keeps refusals separate from coherent observations.
+type SummaryMetadataRepairReport struct {
+	Examined  int
+	Repaired  int
+	Unchanged int
+	Refused   int
+}
+
+type summaryMetadataRow struct{ namespace, name, metadata string }
+
+// ReconcileVulnerabilitySummaryMetadata runs before the API server and background
+// writers start, with exclusive ownership of the retained storage directory. It
+// repairs only the known payload-first failure: the same summary's intact payload
+// is exactly one version newer than its metadata row. It never calls Get (whose
+// missing-file path deletes metadata), writes a payload, or changes a scan time.
+// The SQL compare-and-update also refuses any intervening metadata change.
+func ReconcileVulnerabilitySummaryMetadata(ctx context.Context, fs afero.Fs, root string, pool *sqlitemigration.Pool) (SummaryMetadataRepairReport, error) {
+	var report SummaryMetadataRepairReport
+	if err := ctx.Err(); err != nil {
+		return report, err
+	}
+	if !filepath.IsAbs(root) || filepath.Clean(root) != root {
+		return report, fmt.Errorf("invalid storage root")
+	}
+	conn, err := pool.Take(ctx)
+	if err != nil {
+		return report, err
+	}
+	defer pool.Put(conn)
+	var rows []summaryMetadataRow
+	err = sqlitex.Execute(conn, `SELECT namespace, name, metadata FROM metadata WHERE kind = 'vulnerabilitymanifestsummaries' LIMIT 10001`, &sqlitex.ExecOptions{
+		ResultFunc: func(stmt *sqlite.Stmt) error {
+			rows = append(rows, summaryMetadataRow{stmt.ColumnText(0), stmt.ColumnText(1), stmt.ColumnText(2)})
+			return nil
+		},
+	})
+	if err != nil {
+		return report, err
+	}
+	if len(rows) > 10000 {
+		return report, fmt.Errorf("summary reconciliation exceeds its bounded scope")
+	}
+	var failures []error
+	for _, row := range rows {
+		if err := ctx.Err(); err != nil {
+			return report, err
+		}
+		report.Examined++
+		changed, err := reconcileSummaryMetadataRow(ctx, fs, root, conn, row)
+		if err != nil {
+			report.Refused++
+			failures = append(failures, fmt.Errorf("%s/%s: %w", row.namespace, row.name, err))
+			continue
+		}
+		if changed != nil {
+			report.Repaired++
+		} else {
+			report.Unchanged++
+		}
+	}
+	if report.Refused != 0 {
+		return report, fmt.Errorf("summary metadata reconciliation incomplete: %w", errors.Join(failures...))
+	}
+	return report, nil
+}
+
+// The caller holds this key's write lock. Repairing metadata does not accept a
+// stale client's update: normal preconditions and version checks still run.
+func (s *StorageImpl) reconcileSummaryBeforeUpdate(ctx context.Context, conn *sqlite.Conn, key string) error {
+	parts := strings.Split(key, "/")
+	if len(parts) != 5 || parts[0] != "" || parts[1] != "spdx.softwarecomposition.kubescape.io" || parts[2] != "vulnerabilitymanifestsummaries" {
+		return nil
+	}
+	metadata, err := ReadMetadata(conn, key)
+	if errors.Is(err, ErrMetadataNotFound) {
+		return nil
+	}
+	if err != nil {
+		return err
+	}
+	changed, err := reconcileSummaryMetadataRow(ctx, s.appFs, s.root, conn, summaryMetadataRow{parts[3], parts[4], string(metadata)})
+	if err != nil {
+		return fmt.Errorf("summary metadata reconciliation refused: %w", err)
+	}
+	if changed == nil {
+		return nil
+	}
+	// Publish the restored current observation to existing watches without
+	// rewriting it or using Get's migration/deletion path.
+	s.watchDispatcher.Modified(key, extractFields(changed, []string{"ObjectMeta", "SchemaVersion"}), changed)
+	return nil
+}
+
+func reconcileSummaryMetadataRow(ctx context.Context, fs afero.Fs, root string, conn *sqlite.Conn, row summaryMetadataRow) (*v1beta1.VulnerabilityManifestSummary, error) {
+	if len(validation.IsDNS1123Label(row.namespace)) != 0 || len(validation.IsDNS1123Subdomain(row.name)) != 0 {
+		return nil, fmt.Errorf("invalid summary key")
+	}
+	var listed, stored v1beta1.VulnerabilityManifestSummary
+	if err := json.Unmarshal([]byte(row.metadata), &listed); err != nil {
+		return nil, err
+	}
+	if listed.Name != row.name || listed.Namespace != row.namespace || listed.UID == "" || listed.CreationTimestamp.IsZero() {
+		return nil, fmt.Errorf("unproven listed identity")
+	}
+	path := filepath.Join(root, "spdx.softwarecomposition.kubescape.io", "vulnerabilitymanifestsummaries", row.namespace, row.name) + GobExt
+	// Refuse links both at the payload and at every directory below the trusted
+	// storage root. No migration tool or cleanup-capable storage read is used.
+	lstater, ok := fs.(afero.Lstater)
+	if !ok {
+		return nil, fmt.Errorf("filesystem cannot prove link safety")
+	}
+	rel, err := filepath.Rel(root, path)
+	if err != nil {
+		return nil, err
+	}
+	current := root
+	parts := append([]string{""}, strings.Split(rel, string(filepath.Separator))...)
+	for i, part := range parts {
+		current = filepath.Join(current, part)
+		info, used, err := lstater.LstatIfPossible(current)
+		if err != nil {
+			return nil, err
+		}
+		if i == len(parts)-1 && (info.Size() < 1 || info.Size() > 8<<20) {
+			return nil, fmt.Errorf("invalid summary payload size")
+		}
+		if !used || info.Mode()&os.ModeSymlink != 0 || (i < len(parts)-1 && !info.IsDir()) || (i == len(parts)-1 && !info.Mode().IsRegular()) {
+			return nil, fmt.Errorf("unsafe summary payload path")
+		}
+	}
+	f, err := fs.Open(path)
+	if err != nil {
+		return nil, err
+	}
+	// Summaries are small metadata documents; malformed oversized payloads are
+	// refused rather than allocating without a bound during service startup.
+	err = gob.NewDecoder(io.LimitReader(f, 8<<20)).Decode(&stored)
+	closeErr := f.Close()
+	if err != nil {
+		return nil, err
+	}
+	if closeErr != nil {
+		return nil, closeErr
+	}
+	if stored.Name != row.name || stored.Namespace != row.namespace || stored.UID != listed.UID || !stored.CreationTimestamp.Equal(&listed.CreationTimestamp) {
+		return nil, fmt.Errorf("summary identity changed")
+	}
+	listedVersion, err := strconv.ParseUint(listed.ResourceVersion, 10, 64)
+	if err != nil || listedVersion == 0 || strconv.FormatUint(listedVersion, 10) != listed.ResourceVersion {
+		return nil, fmt.Errorf("invalid listed version")
+	}
+	storedVersion, err := strconv.ParseUint(stored.ResourceVersion, 10, 64)
+	if err != nil || storedVersion == 0 || strconv.FormatUint(storedVersion, 10) != stored.ResourceVersion {
+		return nil, fmt.Errorf("invalid stored version")
+	}
+	if storedVersion == listedVersion {
+		return nil, nil
+	}
+	if storedVersion < listedVersion || storedVersion-listedVersion != 1 {
+		return nil, fmt.Errorf("unproven version direction")
+	}
+	oldScan, err := strconv.ParseInt(listed.Annotations["kubescape.io/timestamp"], 10, 64)
+	if err != nil || oldScan <= 0 {
+		return nil, fmt.Errorf("invalid previous scan time")
+	}
+	newScan, err := strconv.ParseInt(stored.Annotations["kubescape.io/timestamp"], 10, 64)
+	if err != nil || newScan < oldScan || newScan > time.Now().Add(5*time.Minute).Unix() {
+		return nil, fmt.Errorf("invalid retained scan time")
+	}
+	metadata := extractFields(&stored, []string{"ObjectMeta", "SchemaVersion"})
+	encoded, err := json.Marshal(metadata)
+	if err != nil {
+		return nil, err
+	}
+	if err := ctx.Err(); err != nil {
+		return nil, err
+	}
+	err = sqlitex.Execute(conn, `UPDATE metadata SET metadata = ? WHERE kind = 'vulnerabilitymanifestsummaries' AND namespace = ? AND name = ? AND CAST(metadata AS TEXT) = ?`, &sqlitex.ExecOptions{
+		Args: []any{encoded, row.namespace, row.name, row.metadata},
+	})
+	if err != nil {
+		return nil, err
+	}
+	if conn.Changes() != 1 {
+		return nil, fmt.Errorf("metadata changed during reconciliation")
+	}
+	return &stored, nil
+}
