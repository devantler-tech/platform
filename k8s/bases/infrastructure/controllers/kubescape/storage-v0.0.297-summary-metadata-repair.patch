@@ -0,0 +1,243 @@
+package file
+
+import (
+	"bytes"
+	"context"
+	"encoding/gob"
+	"encoding/json"
+	"fmt"
+	"os"
+	"path/filepath"
+	"strings"
+	"testing"
+	"time"
+
+	"github.com/kubescape/storage/pkg/apis/softwarecomposition"
+	"github.com/kubescape/storage/pkg/apis/softwarecomposition/v1beta1"
+	"github.com/kubescape/storage/pkg/generated/clientset/versioned/scheme"
+	"github.com/spf13/afero"
+	"github.com/stretchr/testify/require"
+	apierrors "k8s.io/apimachinery/pkg/api/errors"
+	metav1 "k8s.io/apimachinery/pkg/apis/meta/v1"
+	"k8s.io/apimachinery/pkg/runtime"
+	"k8s.io/apimachinery/pkg/runtime/schema"
+	"k8s.io/apimachinery/pkg/types"
+	"k8s.io/apiserver/pkg/storage"
+	"zombiezen.com/go/sqlite"
+	"zombiezen.com/go/sqlite/sqlitemigration"
+	"zombiezen.com/go/sqlite/sqlitex"
+)
+
+const summaryRepairKey = "/spdx.softwarecomposition.kubescape.io/vulnerabilitymanifestsummaries/example/deployment-example-app"
+
+type summaryRepairFixture struct {
+	fs          afero.Fs
+	root        string
+	pool        *sqlitemigration.Pool
+	store       *StorageImpl
+	conn        *sqlite.Conn
+	oldMetadata []byte
+	payload     []byte
+}
+
+// Leave the real payload at version 2 and its SQLite metadata at version 1 by
+// rejecting the metadata write after saveObject has finished writing the payload.
+func newSplitSummary(t *testing.T) summaryRepairFixture {
+	t.Helper()
+	root := t.TempDir()
+	pool := NewPool(filepath.Join(root, "metadata.sq3"), 2)
+	t.Cleanup(func() { require.NoError(t, pool.Close()) })
+	conn, err := pool.Take(context.Background())
+	require.NoError(t, err)
+	t.Cleanup(func() { pool.Put(conn) })
+	fs := afero.NewOsFs()
+	require.NoError(t, softwarecomposition.AddToScheme(scheme.Scheme))
+	s := NewStorageImpl(fs, root, pool, nil, scheme.Scheme).(*StorageImpl)
+	obj := &v1beta1.VulnerabilityManifestSummary{ObjectMeta: metav1.ObjectMeta{
+		Name: "deployment-example-app", Namespace: "example", UID: types.UID("retained-identity"),
+		CreationTimestamp: metav1.NewTime(time.Date(2026, 9, 1, 0, 0, 0, 0, time.UTC)),
+		Annotations:       map[string]string{"kubescape.io/timestamp": "1788220800", "kubescape.io/tool-version": "v1.32.0"},
+	}}
+	require.NoError(t, s.saveObject(conn, summaryRepairKey, obj, nil, ""))
+	oldMetadata, err := ReadMetadata(conn, summaryRepairKey)
+	require.NoError(t, err)
+	require.NoError(t, sqlitex.Execute(conn, `CREATE TRIGGER reject_summary_write BEFORE INSERT ON metadata BEGIN SELECT RAISE(FAIL, 'injected metadata failure'); END;`, nil))
+	obj.Annotations["kubescape.io/timestamp"] = "1788307200"
+	require.ErrorContains(t, s.saveObject(conn, summaryRepairKey, obj, nil, ""), "injected metadata failure")
+	require.NoError(t, sqlitex.Execute(conn, `DROP TRIGGER reject_summary_write;`, nil))
+	payload, err := afero.ReadFile(fs, filepath.Join(root, summaryRepairKey)+GobExt)
+	require.NoError(t, err)
+	return summaryRepairFixture{fs, root, pool, s, conn, oldMetadata, payload}
+}
+
+func TestSummaryMetadataRepairPreservesPayloadAndAllowsScannerUpdate(t *testing.T) {
+	f := newSplitSummary(t)
+	report, err := ReconcileVulnerabilitySummaryMetadata(context.Background(), f.fs, f.root, f.pool)
+	require.NoError(t, err)
+	require.Equal(t, 1, report.Repaired)
+	require.Zero(t, report.Refused)
+	metadata, err := ReadMetadata(f.conn, summaryRepairKey)
+	require.NoError(t, err)
+	var listed v1beta1.VulnerabilityManifestSummary
+	require.NoError(t, json.Unmarshal(metadata, &listed))
+	require.Equal(t, "2", listed.ResourceVersion)
+	require.Equal(t, types.UID("retained-identity"), listed.UID)
+	require.Equal(t, "1788307200", listed.Annotations["kubescape.io/timestamp"])
+	bytes, err := afero.ReadFile(f.fs, filepath.Join(f.root, summaryRepairKey)+GobExt)
+	require.NoError(t, err)
+	require.Equal(t, f.payload, bytes, "repair must not rewrite the payload")
+	report, err = ReconcileVulnerabilitySummaryMetadata(context.Background(), f.fs, f.root, f.pool)
+	require.NoError(t, err)
+	require.Zero(t, report.Repaired, "reconciliation must be idempotent")
+	require.Equal(t, 1, report.Unchanged)
+
+	out := &v1beta1.VulnerabilityManifestSummary{}
+	require.NoError(t, f.store.GuaranteedUpdate(context.Background(), summaryRepairKey, out, false, nil,
+		func(input runtime.Object, _ storage.ResponseMeta) (runtime.Object, *uint64, error) {
+			obj := input.(*v1beta1.VulnerabilityManifestSummary).DeepCopy()
+			require.Equal(t, "2", obj.ResourceVersion)
+			obj.Annotations["kubescape.io/timestamp"] = "1788393600"
+			return obj, nil, nil
+		}, &listed))
+	require.Equal(t, "3", out.ResourceVersion)
+	metadata, err = ReadMetadata(f.conn, summaryRepairKey)
+	require.NoError(t, err)
+	require.NoError(t, json.Unmarshal(metadata, &listed))
+	require.Equal(t, "3", listed.ResourceVersion)
+}
+
+func TestSummaryMetadataRepairRefusesUnprovenRecords(t *testing.T) {
+	for _, change := range []string{"replacement UID", "creation time", "metadata ahead", "invalid version", "missing payload", "corrupt payload", "oversized payload", "payload identity", "unsafe name", "write interrupted", "symlink payload"} {
+		t.Run(change, func(t *testing.T) {
+			f := newSplitSummary(t)
+			var metadata v1beta1.VulnerabilityManifestSummary
+			require.NoError(t, json.Unmarshal(f.oldMetadata, &metadata))
+			path := filepath.Join(f.root, summaryRepairKey) + GobExt
+			switch change {
+			case "replacement UID":
+				metadata.UID = types.UID("replacement")
+			case "creation time":
+				metadata.CreationTimestamp = metav1.NewTime(time.Now())
+			case "metadata ahead":
+				metadata.ResourceVersion = "3"
+			case "invalid version":
+				metadata.ResourceVersion = "not-a-version"
+			case "missing payload":
+				require.NoError(t, f.fs.Remove(path))
+			case "corrupt payload":
+				require.NoError(t, afero.WriteFile(f.fs, path, []byte("not gob"), 0600))
+			case "oversized payload":
+				require.NoError(t, afero.WriteFile(f.fs, path, append(f.payload, make([]byte, 9<<20)...), 0600))
+			case "payload identity":
+				var obj v1beta1.VulnerabilityManifestSummary
+				require.NoError(t, gob.NewDecoder(bytes.NewReader(f.payload)).Decode(&obj))
+				obj.Namespace = "replacement"
+				var buf bytes.Buffer
+				require.NoError(t, gob.NewEncoder(&buf).Encode(&obj))
+				require.NoError(t, afero.WriteFile(f.fs, path, buf.Bytes(), 0600))
+			case "unsafe name":
+				metadata.Name = "../../outside"
+			case "write interrupted":
+				require.NoError(t, sqlitex.Execute(f.conn, `CREATE TRIGGER reject_repair BEFORE UPDATE ON metadata BEGIN SELECT RAISE(FAIL, 'interrupted repair'); END;`, nil))
+			case "symlink payload":
+				target := filepath.Join(t.TempDir(), "outside.g")
+				require.NoError(t, afero.WriteFile(f.fs, target, f.payload, 0600))
+				require.NoError(t, f.fs.Remove(path))
+				require.NoError(t, os.Symlink(target, path))
+			}
+			if change != "write interrupted" {
+				require.NoError(t, writeMetadata(f.conn, summaryRepairKey, &metadata))
+			}
+			before, err := ReadMetadata(f.conn, summaryRepairKey)
+			require.NoError(t, err)
+			payloadBefore, payloadErr := afero.ReadFile(f.fs, path)
+			report, err := ReconcileVulnerabilitySummaryMetadata(context.Background(), f.fs, f.root, f.pool)
+			require.Error(t, err)
+			require.Zero(t, report.Repaired)
+			require.Equal(t, 1, report.Refused)
+			after, err := ReadMetadata(f.conn, summaryRepairKey)
+			require.NoError(t, err)
+			require.Equal(t, before, after, "refusal must retain the exact metadata row")
+			payloadAfter, err := afero.ReadFile(f.fs, path)
+			require.Equal(t, payloadErr != nil, err != nil)
+			require.Equal(t, payloadBefore, payloadAfter, "refusal must retain available payload bytes")
+		})
+	}
+}
+
+type changeMetadataOnRead struct {
+	afero.Fs
+	change func()
+}
+
+func (f *changeMetadataOnRead) LstatIfPossible(name string) (os.FileInfo, bool, error) {
+	return f.Fs.(afero.Lstater).LstatIfPossible(name)
+}
+
+func (f *changeMetadataOnRead) Open(name string) (afero.File, error) {
+	if f.change != nil && strings.HasSuffix(name, GobExt) {
+		change := f.change
+		f.change = nil
+		change()
+	}
+	return f.Fs.Open(name)
+}
+
+func TestSummaryMetadataRepairRefusesConcurrentMetadataChange(t *testing.T) {
+	f := newSplitSummary(t)
+	var replacement v1beta1.VulnerabilityManifestSummary
+	require.NoError(t, json.Unmarshal(f.oldMetadata, &replacement))
+	replacement.ResourceVersion = "7"
+	fs := &changeMetadataOnRead{Fs: f.fs, change: func() {
+		require.NoError(t, writeMetadata(f.conn, summaryRepairKey, &replacement))
+	}}
+	report, err := ReconcileVulnerabilitySummaryMetadata(context.Background(), fs, f.root, f.pool)
+	require.Error(t, err)
+	require.Zero(t, report.Repaired)
+	metadata, err := ReadMetadata(f.conn, summaryRepairKey)
+	require.NoError(t, err)
+	var after v1beta1.VulnerabilityManifestSummary
+	require.NoError(t, json.Unmarshal(metadata, &after))
+	require.Equal(t, "7", after.ResourceVersion, "a compare-and-update must not replace a new observation")
+}
+
+func TestSummaryMetadataRepairLeavesOtherKindsAndCancelledWorkIntact(t *testing.T) {
+	f := newSplitSummary(t)
+	otherKey := strings.Replace(summaryRepairKey, "vulnerabilitymanifestsummaries", "workloadconfigurationscans", 1)
+	require.NoError(t, WriteJSON(f.conn, otherKey, []byte(`{"metadata":{"resourceVersion":"99"}}`)))
+	ctx, cancel := context.WithCancel(context.Background())
+	cancel()
+	report, err := ReconcileVulnerabilitySummaryMetadata(ctx, f.fs, f.root, f.pool)
+	require.ErrorIs(t, err, context.Canceled)
+	require.Zero(t, report.Repaired)
+	after, err := ReadMetadata(f.conn, summaryRepairKey)
+	require.NoError(t, err)
+	require.Equal(t, f.oldMetadata, after)
+	report, err = ReconcileVulnerabilitySummaryMetadata(context.Background(), f.fs, f.root, f.pool)
+	require.NoError(t, err)
+	require.Equal(t, 1, report.Examined)
+	other, err := ReadMetadata(f.conn, otherKey)
+	require.NoError(t, err)
+	require.Equal(t, `{"metadata":{"resourceVersion":"99"}}`, string(other))
+}
+
+func TestSummaryMetadataRetryRepairsSplitBeforeVersionConflict(t *testing.T) {
+	f := newSplitSummary(t)
+	var stale v1beta1.VulnerabilityManifestSummary
+	require.NoError(t, json.Unmarshal(f.oldMetadata, &stale))
+	out := &v1beta1.VulnerabilityManifestSummary{}
+	err := f.store.GuaranteedUpdate(context.Background(), summaryRepairKey, out, false, nil,
+		func(input runtime.Object, _ storage.ResponseMeta) (runtime.Object, *uint64, error) {
+			obj := input.(*v1beta1.VulnerabilityManifestSummary)
+			if obj.ResourceVersion != stale.ResourceVersion {
+				return nil, nil, apierrors.NewConflict(schema.GroupResource{Resource: "vulnerabilitymanifestsummaries"}, stale.Name, fmt.Errorf("stale scanner version"))
+			}
+			return obj.DeepCopy(), nil, nil
+		}, nil)
+	require.True(t, apierrors.IsConflict(err), "the stale client must still retry")
+	metadata, err := ReadMetadata(f.conn, summaryRepairKey)
+	require.NoError(t, err)
+	var current v1beta1.VulnerabilityManifestSummary
+	require.NoError(t, json.Unmarshal(metadata, &current))
+	require.Equal(t, "2", current.ResourceVersion, "the next list must expose a retryable current version")
+}
