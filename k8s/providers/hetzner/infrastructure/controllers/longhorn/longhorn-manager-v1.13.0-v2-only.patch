@@ -0,0 +1,65 @@
+package datastore
+
+import (
+	"testing"
+
+	metav1 "k8s.io/apimachinery/pkg/apis/meta/v1"
+
+	"github.com/longhorn/longhorn-manager/types"
+	"github.com/longhorn/longhorn-manager/util"
+
+	longhorn "github.com/longhorn/longhorn-manager/k8s/pkg/apis/longhorn/v1beta2"
+)
+
+func TestConstructedDataStoreCapabilityOverridesStaleSettings(t *testing.T) {
+	for _, nodeLocal := range []bool{false, true} {
+		for _, mode := range []types.DataEngineMode{"", types.DataEngineModeV1Capable, types.DataEngineModeV2Only} {
+			lh, kube := modeStateClients()
+			factories := util.NewInformerFactories("longhorn-system", kube, lh, 0)
+			var store *DataStore
+			if nodeLocal {
+				store = NewDataStoreForNodeLocal("longhorn-system", lh, kube, nil, factories, mode)
+			} else {
+				store = NewDataStoreForGlobal("longhorn-system", lh, kube, nil, factories, mode)
+			}
+			// The cache still says both engines are enabled. The process's
+			// immutable ceiling must prevail even before the informer catches up.
+			indexer := factories.LhInformerFactory.Longhorn().V1beta2().Settings().Informer().GetIndexer()
+			for _, name := range []types.SettingName{types.SettingNameV1DataEngine, types.SettingNameV2DataEngine} {
+				if err := indexer.Add(&longhorn.Setting{ObjectMeta: metav1.ObjectMeta{Name: string(name), Namespace: "longhorn-system"}, Value: "true"}); err != nil {
+					t.Fatal(err)
+				}
+			}
+			for _, engine := range []longhorn.DataEngineType{"", longhorn.DataEngineTypeV1, longhorn.DataEngineTypeV2, longhorn.DataEngineTypeAll} {
+				want := mode != types.DataEngineModeV2Only || engine == longhorn.DataEngineTypeV2
+				got, err := store.IsDataEngineEnabled(engine)
+				if err != nil || got != want {
+					t.Fatalf("node-local=%t mode=%q engine=%q ignored capability: got=%t err=%v", nodeLocal, mode, engine, got, err)
+				}
+			}
+			engines := store.GetDataEngines()
+			_, hasV1 := engines[longhorn.DataEngineTypeV1]
+			_, hasV2 := engines[longhorn.DataEngineTypeV2]
+			if hasV1 != (mode != types.DataEngineModeV2Only) || !hasV2 {
+				t.Fatal("mutable engine discovery widened the process capability")
+			}
+			setting := &longhorn.Setting{ObjectMeta: metav1.ObjectMeta{Name: string(types.SettingNameV2DataEngine), Namespace: "longhorn-system"}, Value: "false"}
+			if err := indexer.Update(setting); err != nil {
+				t.Fatal(err)
+			}
+			if enabled, err := store.IsDataEngineEnabled(longhorn.DataEngineTypeV2); err != nil || enabled {
+				t.Fatal("capability was mistaken for mutable engine enablement")
+			}
+			if _, enabled := store.GetDataEngines()[longhorn.DataEngineTypeV2]; enabled {
+				t.Fatal("engine discovery enabled a disabled engine")
+			}
+			setting.Value = "invalid"
+			if err := indexer.Update(setting); err != nil {
+				t.Fatal(err)
+			}
+			if enabled, err := store.IsDataEngineEnabled(longhorn.DataEngineTypeV2); err == nil || enabled != (mode != types.DataEngineModeV2Only) {
+				t.Fatal("setting read failure lost its error or changed the default error contract")
+			}
+		}
+	}
+}
diff --git a/datastore/data_engine_mode.go b/datastore/data_engine_mode.go
new file mode 100644
index 0000000000000000000000000000000000000000..84296666bf50b8931e80e039c70bf9b0bb9ddb94
--- /dev/null
+++ b/datastore/data_engine_mode.go
@@ -0,0 +1,273 @@
+package datastore
+
+import (
+	"context"
+	"strings"
+
+	"github.com/cockroachdb/errors"
+
+	"k8s.io/client-go/kubernetes"
+
+	apierrors "k8s.io/apimachinery/pkg/api/errors"
+	metav1 "k8s.io/apimachinery/pkg/apis/meta/v1"
+	k8stypes "k8s.io/apimachinery/pkg/types"
+
+	"github.com/longhorn/longhorn-manager/types"
+
+	longhorn "github.com/longhorn/longhorn-manager/k8s/pkg/apis/longhorn/v1beta2"
+	lhclientset "github.com/longhorn/longhorn-manager/k8s/pkg/client/clientset/versioned"
+)
+
+type dataEngineSettingIdentity struct {
+	uid             k8stypes.UID
+	resourceVersion string
+}
+
+func v2OnlyEngineSettingValue(name types.SettingName) string {
+	if name == types.SettingNameV2DataEngine {
+		return "true"
+	}
+	return "false"
+}
+
+func dataEngineModeSettingIdentity(setting *longhorn.Setting, name types.SettingName, namespace string) (dataEngineSettingIdentity, error) {
+	if setting == nil || setting.Name != string(name) || setting.Namespace != namespace || setting.UID == "" || setting.ResourceVersion == "" || setting.DeletionTimestamp != nil || setting.Value != v2OnlyEngineSettingValue(name) {
+		return dataEngineSettingIdentity{}, errors.New("v2-only mode requires explicit v1-data-engine=false and v2-data-engine=true Settings")
+	}
+	return dataEngineSettingIdentity{setting.UID, setting.ResourceVersion}, nil
+}
+
+func readDataEngineModeSettings(ctx context.Context, namespace string, lhClient lhclientset.Interface, allowMissing bool) ([2]dataEngineSettingIdentity, error) {
+	var result [2]dataEngineSettingIdentity
+	for index, name := range []types.SettingName{types.SettingNameV1DataEngine, types.SettingNameV2DataEngine} {
+		setting, err := lhClient.LonghornV1beta2().Settings(namespace).Get(ctx, string(name), metav1.GetOptions{})
+		if allowMissing && apierrors.IsNotFound(err) {
+			continue
+		}
+		if err != nil {
+			return result, errors.Wrapf(err, "failed to read explicit %s setting for v2-only validation", name)
+		}
+		identity, err := dataEngineModeSettingIdentity(setting, name, namespace)
+		if err != nil {
+			return result, err
+		}
+		result[index] = identity
+	}
+	return result, nil
+}
+
+// ValidateDataEngineModeState uses uncached clients so retained storage and
+// orphan runtime cannot disappear behind an empty or node-scoped informer.
+// Compatible Settings must already exist; admission/bootstrap is a separate
+// phase. This check neither changes Settings nor removes legacy resources.
+func ValidateDataEngineModeState(ctx context.Context, mode types.DataEngineMode, namespace string, lhClient lhclientset.Interface, kubeClient kubernetes.Interface) error {
+	return validateDataEngineModeState(ctx, mode, namespace, lhClient, kubeClient, false)
+}
+
+// ValidateDataEngineModeBootstrapState permits absent engine Settings only
+// before storage or instance-manager runtime exists. It never creates Settings.
+func ValidateDataEngineModeBootstrapState(ctx context.Context, mode types.DataEngineMode, namespace string, lhClient lhclientset.Interface, kubeClient kubernetes.Interface) error {
+	return validateDataEngineModeState(ctx, mode, namespace, lhClient, kubeClient, true)
+}
+
+func validateDataEngineModeState(ctx context.Context, mode types.DataEngineMode, namespace string, lhClient lhclientset.Interface, kubeClient kubernetes.Interface, allowMissing bool) error {
+	parsed, err := types.ParseDataEngineMode(string(mode))
+	if err != nil {
+		return err
+	}
+	if parsed != types.DataEngineModeV2Only {
+		return nil
+	}
+	if ctx == nil || namespace == "" || lhClient == nil || kubeClient == nil {
+		return errors.New("v2-only validation requires a context, namespace and both API clients")
+	}
+	if err := ctx.Err(); err != nil {
+		return err
+	}
+	before, err := readDataEngineModeSettings(ctx, namespace, lhClient, allowMissing)
+	if err != nil {
+		return err
+	}
+	checkList := func(kind, continuation string, err error) error {
+		if err != nil {
+			return errors.Wrapf(err, "failed to inventory %s for v2-only validation", kind)
+		}
+		if continuation != "" {
+			return errors.Errorf("incomplete %s inventory for v2-only validation", kind)
+		}
+		return nil
+	}
+	checkEngine := func(kind, name string, engine longhorn.DataEngineType) error {
+		if engine != longhorn.DataEngineTypeV2 {
+			return errors.Errorf("cannot use v2-only mode while %s %s has data engine %q", kind, name, engine)
+		}
+		return nil
+	}
+	volumes, err := lhClient.LonghornV1beta2().Volumes(namespace).List(ctx, metav1.ListOptions{})
+	if err != nil {
+		return checkList("volumes", "", err)
+	}
+	if err := checkList("volumes", volumes.Continue, nil); err != nil {
+		return err
+	}
+	storagePresent := len(volumes.Items) != 0
+	for _, volume := range volumes.Items {
+		if err := checkEngine("volume", volume.Name, volume.Spec.DataEngine); err != nil {
+			return err
+		}
+	}
+	engines, err := lhClient.LonghornV1beta2().Engines(namespace).List(ctx, metav1.ListOptions{})
+	if err != nil {
+		return checkList("engines", "", err)
+	}
+	if err := checkList("engines", engines.Continue, nil); err != nil {
+		return err
+	}
+	storagePresent = storagePresent || len(engines.Items) != 0
+	for _, engine := range engines.Items {
+		if err := checkEngine("engine", engine.Name, engine.Spec.DataEngine); err != nil {
+			return err
+		}
+	}
+	replicas, err := lhClient.LonghornV1beta2().Replicas(namespace).List(ctx, metav1.ListOptions{})
+	if err != nil {
+		return checkList("replicas", "", err)
+	}
+	if err := checkList("replicas", replicas.Continue, nil); err != nil {
+		return err
+	}
+	storagePresent = storagePresent || len(replicas.Items) != 0
+	for _, replica := range replicas.Items {
+		if err := checkEngine("replica", replica.Name, replica.Spec.DataEngine); err != nil {
+			return err
+		}
+	}
+	managers, err := lhClient.LonghornV1beta2().InstanceManagers(namespace).List(ctx, metav1.ListOptions{})
+	if err != nil {
+		return checkList("instance managers", "", err)
+	}
+	if err := checkList("instance managers", managers.Continue, nil); err != nil {
+		return err
+	}
+	storagePresent = storagePresent || len(managers.Items) != 0
+	names := map[string]longhorn.InstanceManager{}
+	for _, manager := range managers.Items {
+		if err := checkEngine("instance manager", manager.Name, manager.Spec.DataEngine); err != nil {
+			return err
+		}
+		for _, processes := range []map[string]longhorn.InstanceProcess{manager.Status.InstanceEngines, manager.Status.InstanceReplicas, manager.Status.InstanceEngineFrontends, manager.Status.InstanceShards, manager.Status.InstanceShardGroups} {
+			for name, process := range processes {
+				if err := checkEngine("observed instance process", name, process.Spec.DataEngine); err != nil {
+					return err
+				}
+			}
+		}
+		names[manager.Name] = manager
+	}
+	pods, err := kubeClient.CoreV1().Pods(namespace).List(ctx, metav1.ListOptions{})
+	if err != nil {
+		return checkList("pods", "", err)
+	}
+	if err := checkList("pods", pods.Continue, nil); err != nil {
+		return err
+	}
+	for _, pod := range pods.Items {
+		manager, matched := names[pod.Name]
+		instanceManager := matched || strings.HasPrefix(pod.Name, "instance-manager-") || pod.Labels[types.GetLonghornLabelComponentKey()] == types.LonghornLabelInstanceManager
+		for _, owner := range pod.OwnerReferences {
+			instanceManager = instanceManager || owner.Kind == "InstanceManager"
+		}
+		if instanceManager {
+			storagePresent = true
+			if err := checkEngine("instance-manager pod", pod.Name, longhorn.DataEngineType(pod.Labels[types.GetLonghornLabelKey(types.LonghornLabelDataEngine)])); err != nil {
+				return err
+			}
+			owner := metav1.GetControllerOf(&pod)
+			if !matched || manager.UID == "" || manager.Spec.NodeID == "" || manager.Spec.Image == "" || pod.UID == "" || pod.Namespace != namespace || pod.Spec.NodeName != manager.Spec.NodeID ||
+				len(pod.OwnerReferences) != 1 || owner == nil || owner.UID != manager.UID || owner.Name != manager.Name || owner.Kind != types.LonghornKindInstanceManager || owner.APIVersion != longhorn.SchemeGroupVersion.String() ||
+				len(pod.Spec.Containers) != 1 || len(pod.Spec.InitContainers) != 0 || len(pod.Spec.EphemeralContainers) != 0 {
+				return errors.New("instance-manager runtime has unresolved ownership or placement")
+			}
+			container := pod.Spec.Containers[0]
+			if container.Name != "instance-manager" || container.Image != manager.Spec.Image || len(container.Command) != 0 || len(container.EnvFrom) != 0 || !nativeV2InstanceManagerArgs(container.Args) {
+				return errors.New("instance-manager runtime does not use the native V2 launch profile")
+			}
+			modeEnvs := 0
+			for _, env := range container.Env {
+				if env.Name == types.EnvDataEngine {
+					modeEnvs++
+					if env.Value != string(longhorn.DataEngineTypeV2) || env.ValueFrom != nil {
+						return errors.New("instance-manager runtime has unresolved data-engine environment")
+					}
+				}
+			}
+			if modeEnvs != 1 {
+				return errors.New("instance-manager runtime lacks one explicit V2 data-engine environment")
+			}
+		}
+	}
+	after, err := readDataEngineModeSettings(ctx, namespace, lhClient, allowMissing)
+	if err != nil {
+		return err
+	}
+	if before != after {
+		return errors.New("data engine Settings changed during v2-only validation")
+	}
+	if storagePresent && (before[0].uid == "" || before[1].uid == "") {
+		return errors.New("cannot bootstrap missing engine Settings while storage or instance-manager runtime exists")
+	}
+	return ctx.Err()
+}
+
+// The controller's start-spdk-tgt branch selects V2; its instance-manager
+// branch selects V1. Parse option/value boundaries instead of finding flag
+// strings that could instead be another option's value. Unknown profiles hold
+// the opt-in transition, never silently reclassify runtime from mutable labels.
+func nativeV2InstanceManagerArgs(args []string) bool {
+	if len(args) == 0 || args[0] != "start-spdk-tgt" {
+		return false
+	}
+	seen := map[string]bool{}
+	daemon := false
+	for index := 1; index < len(args); index++ {
+		option := args[index]
+		if option == "daemon" && !daemon {
+			daemon = true
+			continue
+		}
+		if seen[option] {
+			return false
+		}
+		seen[option] = true
+		value, flag := false, false
+		if !daemon {
+			switch option {
+			case "--spdk-log", "--spdk-cpumask", "--spdk-core-number", "--spdk-memory-size", "--spdk-iobuf-large-pool-size", "--spdk-iobuf-small-pool-size", "--longhorn-control-path":
+				value = true
+			case "--enable-spdk", "--debug":
+				flag = true
+			}
+		} else {
+			switch option {
+			case "--listen":
+				value = true
+			case "--spdk-enabled", "--spdk-interrupt-mode", "--enable-irq-affinity", "--enable-workqueue-affinity", "--enable-rps", "--spdk-no-hugepage":
+				flag = true
+			}
+		}
+		if value {
+			index++
+			if index == len(args) {
+				return false
+			}
+		} else if !flag {
+			return false
+		}
+	}
+	for _, required := range []string{"--spdk-log", "--spdk-cpumask", "--spdk-core-number", "--spdk-memory-size", "--longhorn-control-path", "--enable-spdk", "--debug", "--spdk-enabled", "--listen"} {
+		if !seen[required] {
+			return false
+		}
+	}
+	return daemon
+}
diff --git a/datastore/data_engine_mode_restore.go b/datastore/data_engine_mode_restore.go
new file mode 100644
index 0000000000000000000000000000000000000000..f9664a7d5ac857b21d9fd97678c0b390c5d25ed6
--- /dev/null
+++ b/datastore/data_engine_mode_restore.go
@@ -0,0 +1,110 @@
+package datastore
+
+import (
+	"context"
+	"fmt"
+	"reflect"
+
+	apiextensionsv1 "k8s.io/apiextensions-apiserver/pkg/apis/apiextensions/v1"
+	metav1 "k8s.io/apimachinery/pkg/apis/meta/v1"
+
+	"github.com/longhorn/longhorn-manager/types"
+)
+
+func (s *DataStore) ValidateDataEngineModeRestoreCRDs(ctx context.Context, archive *apiextensionsv1.CustomResourceDefinitionList) error {
+	mode, err := types.ParseDataEngineMode(string(s.dataEngineMode))
+	if err != nil || mode != types.DataEngineModeV2Only {
+		return err
+	}
+	if ctx == nil || s.extensionsClient == nil || archive == nil || len(archive.Items) == 0 || archive.Continue != "" || (archive.RemainingItemCount != nil && *archive.RemainingItemCount != 0) {
+		return fmt.Errorf("v2-only restore requires a complete archived CRD inventory and live client")
+	}
+	if err := ctx.Err(); err != nil {
+		return err
+	}
+	live, err := s.extensionsClient.ApiextensionsV1().CustomResourceDefinitions().List(ctx, metav1.ListOptions{Limit: 1000})
+	if err != nil || live == nil || live.Continue != "" || (live.RemainingItemCount != nil && *live.RemainingItemCount != 0) || len(live.Items) > 1000 {
+		return fmt.Errorf("cannot obtain a complete current CRD inventory for v2-only restore")
+	}
+	current := map[string]*apiextensionsv1.CustomResourceDefinition{}
+	for index := range live.Items {
+		crd := &live.Items[index]
+		if crd.Spec.Group != "longhorn.io" {
+			continue
+		}
+		if _, duplicate := current[crd.Name]; duplicate {
+			return fmt.Errorf("duplicate current Longhorn CRD")
+		}
+		current[crd.Name] = crd
+	}
+	if len(current) != len(archive.Items) {
+		return fmt.Errorf("archived and current Longhorn CRD inventories differ")
+	}
+	for _, archived := range archive.Items {
+		live := current[archived.Name]
+		if err := validateV2OnlyRestoreCRD(live, &archived); err != nil {
+			return err
+		}
+		delete(current, archived.Name)
+	}
+	return ctx.Err()
+}
+
+// GetDataEngineModeRestoreCRD rebinds schema compatibility at the native
+// restore write boundary. Its ResourceVersion is used by the subsequent
+// update, so a concurrent schema change produces a conflict rather than a
+// downgrade. Missing CRDs are never recreated from an archive in v2-only mode.
+func (s *DataStore) GetDataEngineModeRestoreCRD(ctx context.Context, archive *apiextensionsv1.CustomResourceDefinition) (*apiextensionsv1.CustomResourceDefinition, error) {
+	if ctx == nil || s.extensionsClient == nil || archive == nil {
+		return nil, fmt.Errorf("missing v2-only restore CRD binding")
+	}
+	if err := ctx.Err(); err != nil {
+		return nil, err
+	}
+	live, err := s.extensionsClient.ApiextensionsV1().CustomResourceDefinitions().Get(ctx, archive.Name, metav1.GetOptions{})
+	if err != nil {
+		return nil, fmt.Errorf("cannot rebind current CRD for v2-only restore")
+	}
+	if err := validateV2OnlyRestoreCRD(live, archive); err != nil {
+		return nil, err
+	}
+	return live, ctx.Err()
+}
+
+func validateV2OnlyRestoreCRD(live, archive *apiextensionsv1.CustomResourceDefinition) error {
+	if live == nil || archive == nil || archive.Name == "" || live.Name != archive.Name || live.Namespace != "" || archive.Namespace != "" || archive.Spec.Group != "longhorn.io" || live.UID == "" || live.ResourceVersion == "" || live.DeletionTimestamp != nil || archive.DeletionTimestamp != nil || !reflect.DeepEqual(live.Spec, archive.Spec) {
+		return fmt.Errorf("archived CRD is missing or incompatible with the current V2 schema")
+	}
+	return nil
+}
+
+func (s *DataStore) UpdateDataEngineModeRestoreCRD(ctx context.Context, crd *apiextensionsv1.CustomResourceDefinition) (*apiextensionsv1.CustomResourceDefinition, error) {
+	if ctx == nil || s.dataEngineMode != types.DataEngineModeV2Only || s.extensionsClient == nil || crd == nil {
+		return nil, fmt.Errorf("missing bounded v2-only CRD update identity")
+	}
+	if err := ctx.Err(); err != nil {
+		return nil, err
+	}
+	live, err := s.GetDataEngineModeRestoreCRD(ctx, crd)
+	if err != nil {
+		return nil, err
+	}
+	if live.UID != crd.UID || live.ResourceVersion != crd.ResourceVersion {
+		return nil, fmt.Errorf("current CRD identity changed before v2-only restore update")
+	}
+	updated, err := s.extensionsClient.ApiextensionsV1().CustomResourceDefinitions().Update(ctx, crd, metav1.UpdateOptions{})
+	if err != nil {
+		return nil, fmt.Errorf("cannot update the bound CRD during v2-only restore")
+	}
+	if err := validateV2OnlyRestoreCRD(updated, crd); err != nil || updated.UID != live.UID || !reflect.DeepEqual(updated.Annotations, crd.Annotations) {
+		return nil, fmt.Errorf("v2-only CRD update response is unresolved")
+	}
+	observed, err := s.GetDataEngineModeRestoreCRD(ctx, crd)
+	if err != nil {
+		return nil, err
+	}
+	if observed.UID != updated.UID || observed.ResourceVersion != updated.ResourceVersion || !reflect.DeepEqual(observed.Annotations, updated.Annotations) {
+		return nil, fmt.Errorf("v2-only CRD update readback changed")
+	}
+	return observed, ctx.Err()
+}
diff --git a/datastore/data_engine_mode_restore_test.go b/datastore/data_engine_mode_restore_test.go
new file mode 100644
index 0000000000000000000000000000000000000000..8547f8fa61f27144fd568eea0e94ec8c60087347
--- /dev/null
+++ b/datastore/data_engine_mode_restore_test.go
@@ -0,0 +1,129 @@
+package datastore
+
+import (
+	"context"
+	"errors"
+	"testing"
+
+	"k8s.io/apimachinery/pkg/runtime"
+
+	apiextensionsv1 "k8s.io/apiextensions-apiserver/pkg/apis/apiextensions/v1"
+	extensionsfake "k8s.io/apiextensions-apiserver/pkg/client/clientset/clientset/fake"
+	metav1 "k8s.io/apimachinery/pkg/apis/meta/v1"
+	k8stesting "k8s.io/client-go/testing"
+
+	"github.com/longhorn/longhorn-manager/types"
+)
+
+func TestV2OnlyRestoreCRDsRequireCompleteCurrentCompatibleSchemas(t *testing.T) {
+	crd := apiextensionsv1.CustomResourceDefinition{
+		ObjectMeta: metav1.ObjectMeta{Name: "volumes.longhorn.io", UID: "live-crd", ResourceVersion: "7"},
+		Spec:       apiextensionsv1.CustomResourceDefinitionSpec{Group: "longhorn.io", Names: apiextensionsv1.CustomResourceDefinitionNames{Plural: "volumes"}, Versions: []apiextensionsv1.CustomResourceDefinitionVersion{{Name: "v1beta2", Served: true, Storage: true}}},
+	}
+	archive := &apiextensionsv1.CustomResourceDefinitionList{Items: []apiextensionsv1.CustomResourceDefinition{*crd.DeepCopy()}}
+	for _, test := range []string{"compatible", "missing", "changed-schema", "deleting", "missing-identity", "incomplete", "duplicate-archive", "foreign-archive", "extra-live", "empty-archive"} {
+		t.Run(test, func(t *testing.T) {
+			candidate, live := archive.DeepCopy(), crd.DeepCopy()
+			switch test {
+			case "missing":
+				live.Name = "other.longhorn.io"
+			case "changed-schema":
+				live.Spec.Versions[0].Served = false
+			case "deleting":
+				now := metav1.Now()
+				live.DeletionTimestamp = &now
+			case "missing-identity":
+				live.UID = ""
+			case "duplicate-archive":
+				candidate.Items = append(candidate.Items, crd)
+			case "foreign-archive":
+				candidate.Items[0].Spec.Group = "other.io"
+			case "empty-archive":
+				candidate.Items = nil
+			}
+			objects := []runtime.Object{live}
+			if test == "extra-live" {
+				extra := crd.DeepCopy()
+				extra.Name = "settings.longhorn.io"
+				extra.Spec.Names.Plural = "settings"
+				objects = append(objects, extra)
+			}
+			client := extensionsfake.NewClientset(objects...)
+			if test == "incomplete" {
+				client.PrependReactor("list", "customresourcedefinitions", func(k8stesting.Action) (bool, runtime.Object, error) {
+					return true, &apiextensionsv1.CustomResourceDefinitionList{ListMeta: metav1.ListMeta{Continue: "next"}, Items: []apiextensionsv1.CustomResourceDefinition{*live}}, nil
+				})
+			}
+			ds := &DataStore{dataEngineMode: types.DataEngineModeV2Only, extensionsClient: client}
+			if err := ds.ValidateDataEngineModeRestoreCRDs(t.Context(), candidate); (err == nil) != (test == "compatible") {
+				t.Fatalf("unexpected CRD compatibility result: %v", err)
+			}
+			for _, action := range client.Actions() {
+				if action.GetVerb() != "list" && action.GetVerb() != "get" {
+					t.Fatal("CRD validation wrote to the cluster")
+				}
+			}
+		})
+	}
+}
+
+func TestV2OnlyRestoreCRDUpdateBindsDeadlineSchemaAndReadback(t *testing.T) {
+	for _, scenario := range []string{"compatible", "expired", "schema-drift", "update-error", "readback-error", "readback-identity-drift", "stripped-receipt"} {
+		t.Run(scenario, func(t *testing.T) {
+			crd := &apiextensionsv1.CustomResourceDefinition{ObjectMeta: metav1.ObjectMeta{Name: "volumes.longhorn.io", UID: "uid", ResourceVersion: "1", Annotations: map[string]string{"restore-receipt": "expected"}}, Spec: apiextensionsv1.CustomResourceDefinitionSpec{Group: "longhorn.io"}}
+			live := crd.DeepCopy()
+			if scenario == "schema-drift" {
+				live.Spec.Group = "changed.io"
+			}
+			client := extensionsfake.NewClientset(live)
+			gets := 0
+			client.PrependReactor("get", "customresourcedefinitions", func(k8stesting.Action) (bool, runtime.Object, error) {
+				gets++
+				if gets == 2 && scenario == "readback-error" {
+					return true, nil, errors.New("unavailable")
+				}
+				if gets == 2 && scenario == "readback-identity-drift" {
+					changed := crd.DeepCopy()
+					changed.UID = "replacement"
+					return true, changed, nil
+				}
+				return false, nil, nil
+			})
+			if scenario == "update-error" {
+				client.PrependReactor("update", "customresourcedefinitions", func(k8stesting.Action) (bool, runtime.Object, error) {
+					return true, nil, errors.New("conflict")
+				})
+			}
+			if scenario == "stripped-receipt" {
+				client.PrependReactor("update", "customresourcedefinitions", func(action k8stesting.Action) (bool, runtime.Object, error) {
+					changed := action.(k8stesting.UpdateAction).GetObject().(*apiextensionsv1.CustomResourceDefinition).DeepCopy()
+					changed.Annotations = nil
+					if err := client.Tracker().Update(action.GetResource(), changed, ""); err != nil {
+						t.Fatal(err)
+					}
+					return true, changed, nil
+				})
+			}
+			ctx, cancel := context.WithCancel(t.Context())
+			defer cancel()
+			if scenario == "expired" {
+				cancel()
+			}
+			ds := &DataStore{dataEngineMode: types.DataEngineModeV2Only, extensionsClient: client}
+			_, err := ds.UpdateDataEngineModeRestoreCRD(ctx, crd)
+			if (err == nil) != (scenario == "compatible") {
+				t.Fatalf("unexpected bounded CRD update result: %v", err)
+			}
+			if scenario == "expired" && len(client.Actions()) != 0 {
+				t.Fatal("expired CRD update contacted the API")
+			}
+			if scenario == "schema-drift" {
+				for _, action := range client.Actions() {
+					if action.GetVerb() == "update" {
+						t.Fatal("schema drift permitted a CRD write")
+					}
+				}
+			}
+		})
+	}
+}
diff --git a/datastore/data_engine_mode_settings.go b/datastore/data_engine_mode_settings.go
new file mode 100644
index 0000000000000000000000000000000000000000..81b8f1b0cbb098e53600f11fca302e17c21a2016
--- /dev/null
+++ b/datastore/data_engine_mode_settings.go
@@ -0,0 +1,111 @@
+package datastore
+
+import (
+	"context"
+	"io"
+	"strings"
+	"time"
+
+	"github.com/cockroachdb/errors"
+	"go.yaml.in/yaml/v3"
+
+	corev1 "k8s.io/api/core/v1"
+	metav1 "k8s.io/apimachinery/pkg/apis/meta/v1"
+
+	"github.com/longhorn/longhorn-manager/types"
+)
+
+// ValidateDataEngineModeStartup checks raw chart intent and uncached storage
+// before upgrades or default-Setting writes. Missing members remain a separate
+// create-only bootstrap phase.
+func (s *DataStore) ValidateDataEngineModeStartup(ctx context.Context) error {
+	mode, err := types.ParseDataEngineMode(string(s.dataEngineMode))
+	if err != nil {
+		return err
+	}
+	if mode != types.DataEngineModeV2Only {
+		return nil
+	}
+	if ctx == nil || s.namespace == "" || s.lhClient == nil || s.kubeClient == nil {
+		return errors.New("v2-only startup requires a context, namespace and both API clients")
+	}
+	ctx, cancel := context.WithTimeout(ctx, 30*time.Second)
+	defer cancel()
+	readIntent := func() (*corev1.ConfigMap, error) {
+		configMap, err := s.kubeClient.CoreV1().ConfigMaps(s.namespace).Get(ctx, types.DefaultDefaultSettingConfigMapName, metav1.GetOptions{})
+		if err != nil {
+			return nil, errors.Wrap(err, "failed to read raw default Settings for v2-only startup")
+		}
+		if err := s.validateDataEngineModeCustomizedSettings(configMap); err != nil {
+			return nil, err
+		}
+		return configMap, nil
+	}
+	before, err := readIntent()
+	if err != nil {
+		return err
+	}
+	if err := ValidateDataEngineModeBootstrapState(ctx, mode, s.namespace, s.lhClient, s.kubeClient); err != nil {
+		return err
+	}
+	after, err := readIntent()
+	if err != nil {
+		return err
+	}
+	if before.UID != after.UID || before.ResourceVersion != after.ResourceVersion {
+		return errors.New("default Settings ConfigMap changed during v2-only startup validation")
+	}
+	return ctx.Err()
+}
+
+func (s *DataStore) InitializeDataEngineModeSettings(ctx context.Context) error {
+	return InitializeDataEngineModeSettings(ctx, s.dataEngineMode, s.namespace, s.lhClient, s.kubeClient)
+}
+
+func isDataEngineSetting(name types.SettingName) bool {
+	return name == types.SettingNameV1DataEngine || name == types.SettingNameV2DataEngine
+}
+
+func (s *DataStore) validateDataEngineModeSetting(name types.SettingName, value string) error {
+	mode, err := types.ParseDataEngineMode(string(s.dataEngineMode))
+	if err != nil {
+		return err
+	}
+	if mode == types.DataEngineModeV2Only && isDataEngineSetting(name) && value != v2OnlyEngineSettingValue(name) {
+		return errors.New("v2-only capability requires v1-data-engine=false and v2-data-engine=true")
+	}
+	return nil
+}
+
+func (s *DataStore) validateDataEngineModeCustomizedSettings(configMap *corev1.ConfigMap) error {
+	mode, err := types.ParseDataEngineMode(string(s.dataEngineMode))
+	if err != nil {
+		return err
+	}
+	if mode != types.DataEngineModeV2Only {
+		return nil
+	}
+	if configMap == nil || configMap.Name != types.DefaultDefaultSettingConfigMapName || configMap.Namespace != s.namespace || configMap.UID == "" || configMap.ResourceVersion == "" || configMap.DeletionTimestamp != nil {
+		return errors.New("v2-only mode requires an identified default Settings ConfigMap")
+	}
+	// The general default-Settings parser logs malformed input. Validate this
+	// capability boundary without echoing an archived or live ConfigMap body,
+	// and reject a second document rather than silently reading only the first.
+	raw := map[string]string{}
+	decoder := yaml.NewDecoder(strings.NewReader(configMap.Data[types.DefaultSettingYAMLFileName]))
+	if err := decoder.Decode(&raw); err != nil && err != io.EOF {
+		return errors.New("invalid raw default Settings document for v2-only mode")
+	}
+	var extra interface{}
+	if err := decoder.Decode(&extra); err != io.EOF {
+		return errors.New("multiple or invalid raw default Settings documents for v2-only mode")
+	}
+	for _, name := range []types.SettingName{types.SettingNameV1DataEngine, types.SettingNameV2DataEngine} {
+		if value, present := raw[string(name)]; present {
+			if err := s.validateDataEngineModeSetting(name, value); err != nil {
+				return errors.Wrap(err, "invalid raw engine intent in default Settings ConfigMap")
+			}
+		}
+	}
+	return nil
+}
