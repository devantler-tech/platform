new file mode 100644
index 0000000..1f007e8
--- /dev/null
+++ b/app/cmd/retirement.go
@@ -0,0 +1,124 @@
+package cmd
+
+import (
+	"context"
+	"errors"
+	"fmt"
+	"io"
+	"net"
+	"net/http"
+	"os"
+	"path/filepath"
+	"strings"
+	"syscall"
+	"time"
+
+	"github.com/urfave/cli/v3"
+
+	"github.com/longhorn/longhorn-instance-manager/pkg/process"
+)
+
+const (
+	platformRetirementState  = "/log/platform-v1-retirement"
+	platformRetirementSocket = "/run/longhorn-platform-retirement/process.sock"
+)
+
+func startPlatformV1Retirement(manager *process.Manager) (*http.Server, error) {
+	for _, directory := range []string{platformRetirementState, filepath.Dir(platformRetirementSocket)} {
+		if err := os.Mkdir(directory, 0o700); err != nil && !errors.Is(err, os.ErrExist) {
+			return nil, err
+		}
+	}
+	if err := manager.EnableDurableRetirement(platformRetirementState); err != nil {
+		return nil, err
+	}
+	return startRetirementSocket(platformRetirementSocket, manager.SealProcess)
+}
+
+func startRetirementSocket(socket string, seal func(string) (bool, error)) (*http.Server, error) {
+	directory, err := os.Lstat(filepath.Dir(socket))
+	if err != nil || !directory.IsDir() || directory.Mode().Perm() != 0o700 {
+		return nil, errors.New("retirement socket requires an owner-only directory")
+	}
+	owner, ok := directory.Sys().(*syscall.Stat_t)
+	if !ok || owner.Uid != uint32(os.Geteuid()) {
+		return nil, errors.New("retirement socket directory owner does not match the daemon")
+	}
+	listener, err := net.Listen("unix", socket)
+	if err != nil {
+		return nil, err
+	}
+	if err = os.Chmod(socket, 0o600); err != nil {
+		return nil, errors.Join(err, listener.Close())
+	}
+	handler := http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		if r.Method != http.MethodPost || r.URL.Path != "/seal" {
+			http.NotFound(w, r)
+			return
+		}
+		name, err := io.ReadAll(http.MaxBytesReader(w, r.Body, 253))
+		if err != nil || len(name) == 0 {
+			w.WriteHeader(http.StatusBadRequest)
+			return
+		}
+		complete, err := seal(string(name))
+		switch {
+		case err != nil:
+			w.WriteHeader(http.StatusPreconditionFailed)
+		case !complete:
+			w.WriteHeader(http.StatusConflict)
+		default:
+			w.WriteHeader(http.StatusNoContent)
+		}
+	})
+	server := &http.Server{Handler: handler, ReadHeaderTimeout: 3 * time.Second,
+		ReadTimeout: 5 * time.Second, WriteTimeout: 5 * time.Second, MaxHeaderBytes: 1024}
+	go func() { _ = server.Serve(listener) }()
+	return server, nil
+}
+
+func requestRetirement(ctx context.Context, socket, name string) (bool, error) {
+	dialer := net.Dialer{Timeout: 3 * time.Second}
+	transport := &http.Transport{DisableKeepAlives: true, DialContext: func(ctx context.Context, _, _ string) (net.Conn, error) {
+		return dialer.DialContext(ctx, "unix", socket)
+	}}
+	client := &http.Client{Transport: transport, Timeout: 6 * time.Second,
+		CheckRedirect: func(*http.Request, []*http.Request) error { return http.ErrUseLastResponse }}
+	request, err := http.NewRequestWithContext(ctx, http.MethodPost, "http://unix/seal", strings.NewReader(name))
+	if err != nil {
+		return false, err
+	}
+	response, err := client.Do(request)
+	if err != nil {
+		return false, err
+	}
+	defer response.Body.Close()
+	switch response.StatusCode {
+	case http.StatusNoContent:
+		return true, nil
+	case http.StatusConflict:
+		return false, nil
+	default:
+		return false, errors.New("local process retirement did not authorize cleanup")
+	}
+}
+
+func processRetirementCmd() *cli.Command {
+	return &cli.Command{
+		Name:  "seal-for-retirement",
+		Usage: "seal one process name through the local retirement socket",
+		Flags: []cli.Flag{&cli.StringFlag{Name: "name", Required: true}},
+		Action: func(ctx context.Context, c *cli.Command) error {
+			complete, err := requestRetirement(ctx, platformRetirementSocket, c.String("name"))
+			if err != nil {
+				return err
+			}
+			result := "PENDING"
+			if complete {
+				result = "SEALED"
+			}
+			_, err = fmt.Fprintln(c.Writer, result)
+			return err
+		},
+	}
+}
