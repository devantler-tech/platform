+++ b/app/cmd/retirement_test.go
@@ -0,0 +1,63 @@
+package cmd
+
+import (
+	"context"
+	"errors"
+	"os"
+	"path/filepath"
+	"strings"
+	"sync/atomic"
+	"testing"
+)
+
+func TestProcessRetirementSocketRestrictsAndReportsLocalRequests(t *testing.T) {
+	private := t.TempDir()
+	if err := os.Chmod(private, 0o700); err != nil {
+		t.Fatal(err)
+	}
+	socket := filepath.Join(private, "retirement.sock")
+	var calls atomic.Int32
+	server, err := startRetirementSocket(socket, func(name string) (bool, error) {
+		if name != "fixture-e-0" {
+			return false, errors.New("unexpected target")
+		}
+		return calls.Add(1) > 1, nil
+	})
+	if err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(func() {
+		if err := server.Close(); err != nil {
+			t.Error(err)
+		}
+	})
+	info, err := os.Lstat(socket)
+	if err != nil || info.Mode()&os.ModeSocket == 0 || info.Mode().Perm() != 0o600 {
+		t.Fatalf("socket is not owner-only: %v", err)
+	}
+	if sealed, err := requestRetirement(context.Background(), socket, "fixture-e-0"); err != nil || sealed {
+		t.Fatalf("in-flight child was acknowledged: %v", err)
+	}
+	if sealed, err := requestRetirement(context.Background(), socket, "fixture-e-0"); err != nil || !sealed {
+		t.Fatalf("completed seal was not acknowledged: %v", err)
+	}
+	if _, err := requestRetirement(context.Background(), socket, strings.Repeat("x", 254)); err == nil {
+		t.Fatal("oversized target was accepted")
+	}
+	if calls.Load() != 2 {
+		t.Fatal("oversized input reached the native retirement function")
+	}
+}
+
+func TestProcessRetirementSocketRejectsSharedDirectory(t *testing.T) {
+	dir := t.TempDir()
+	if err := os.Chmod(dir, 0o755); err != nil {
+		t.Fatal(err)
+	}
+	socket := filepath.Join(dir, "retirement.sock")
+	server, err := startRetirementSocket(socket, func(string) (bool, error) { return true, nil })
+	if err == nil {
+		_ = server.Close()
+		t.Fatal("retirement listener used a shared directory")
+	}
+}
