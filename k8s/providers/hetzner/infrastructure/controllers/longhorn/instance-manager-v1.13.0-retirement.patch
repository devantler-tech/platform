@@ -0,0 +1,47 @@
+package process
+
+import (
+	"errors"
+	"os"
+	"path/filepath"
+	"syscall"
+	"testing"
+)
+
+func TestRetiredBinaryCannotStart(t *testing.T) {
+	for name, retire := range map[string]func(*BinaryCommand){
+		"stop":   (*BinaryCommand).Stop,
+		"signal": func(c *BinaryCommand) { c.StopWithSignal(syscall.SIGINT) },
+		"kill":   (*BinaryCommand).Kill,
+	} {
+		t.Run(name, func(t *testing.T) {
+			marker := filepath.Join(t.TempDir(), "started")
+			command, err := NewBinaryCommand("sh", "-c", "printf started > \"$1\"", "sh", marker)
+			if err != nil {
+				t.Fatal(err)
+			}
+			retire(command)
+			if err = command.Run(); err == nil {
+				t.Error("retired command entered the native start path")
+			}
+			if _, err = os.Stat(marker); !errors.Is(err, os.ErrNotExist) {
+				t.Fatal("a native child executed after the retirement request")
+			}
+		})
+	}
+}
+
+func TestUnretiredBinaryStartsNormally(t *testing.T) {
+	marker := filepath.Join(t.TempDir(), "started")
+	command, err := NewBinaryCommand("sh", "-c", "printf started > \"$1\"", "sh", marker)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err = command.Run(); err != nil {
+		t.Fatal(err)
+	}
+	contents, err := os.ReadFile(marker)
+	if err != nil || string(contents) != "started" {
+		t.Fatalf("native active control failed: %v", err)
+	}
+}
diff --git a/pkg/process/retirement_manager_test.go b/pkg/process/retirement_manager_test.go
new file mode 100644
index 0000000..8aa4b70
--- /dev/null
+++ b/pkg/process/retirement_manager_test.go
@@ -0,0 +1,235 @@
+package process
+
+import (
+	"context"
+	"errors"
+	"os"
+	"sync"
+	"testing"
+	"time"
+
+	rpc "github.com/longhorn/types/pkg/generated/imrpc"
+)
+
+func TestSealedNameRejectsNewCreateAndWaitsForInFlightCreate(t *testing.T) {
+	ctx, cancel := context.WithTimeout(t.Context(), 5*time.Second)
+	defer cancel()
+	manager, err := NewManager(ctx, "30000-30010", t.TempDir())
+	if err != nil {
+		t.Fatal(err)
+	}
+	entered, release := make(chan struct{}), make(chan struct{})
+	allowReturn := sync.OnceFunc(func() { close(release) })
+	defer allowReturn()
+	manager.Executor = &MockExecutor{CreationHook: func(c *MockCommand) (*MockCommand, error) {
+		if c.Binary == "delayed-command" {
+			close(entered)
+			<-release
+		}
+		return nil, errors.New("fixture stops before a native child is created")
+	}}
+	request := &rpc.ProcessCreateRequest{Spec: &rpc.ProcessSpec{Name: "fixture-e-0", Binary: "delayed-command"}}
+	finished := make(chan struct{})
+	go func() {
+		defer close(finished)
+		_, _ = manager.ProcessCreate(ctx, request)
+	}()
+	select {
+	case <-entered:
+	case <-ctx.Done():
+		t.Fatal("first create did not reach the injected start point")
+	}
+	if stopped, err := manager.SealProcess(request.Spec.Name); err != nil || stopped {
+		t.Fatalf("sealing reported a pending create as retired: %v", err)
+	}
+	if _, err := manager.ProcessCreate(ctx, request); err == nil {
+		t.Fatal("a second create was admitted after sealing the name")
+	}
+	replacement := &rpc.ProcessReplaceRequest{Spec: request.Spec, TerminateSignal: "SIGHUP"}
+	if _, err := manager.ProcessReplace(ctx, replacement); err == nil {
+		t.Fatal("a replacement was admitted after sealing the name")
+	}
+	allowReturn()
+	select {
+	case <-finished:
+	case <-ctx.Done():
+		t.Fatal("first create did not return")
+	}
+	if stopped, err := manager.SealProcess(request.Spec.Name); err != nil || !stopped {
+		t.Fatalf("no-child create did not finish retiring: %v", err)
+	}
+	other := &rpc.ProcessCreateRequest{Spec: &rpc.ProcessSpec{Name: "unrelated-e-0", Binary: "unrelated-command"}}
+	if _, err := manager.ProcessCreate(ctx, other); err != nil {
+		t.Fatalf("sealing one name affected an unrelated create: %v", err)
+	}
+}
+
+func TestSealedNameWaitsForActualChildExit(t *testing.T) {
+	ctx, cancel := context.WithTimeout(t.Context(), 5*time.Second)
+	defer cancel()
+	manager, err := NewManager(ctx, "30000-30010", t.TempDir())
+	if err != nil {
+		t.Fatal(err)
+	}
+	const name = "fixture-r-0"
+	result, err := manager.ProcessCreate(ctx, &rpc.ProcessCreateRequest{
+		Spec: &rpc.ProcessSpec{Name: name, Binary: "sleep", Args: []string{"30"}},
+	})
+	if err != nil {
+		t.Fatal(err)
+	}
+	process := manager.findProcess(name)
+	t.Cleanup(process.Stop)
+	for !process.cmd.IsRunning() && ctx.Err() == nil {
+		time.Sleep(time.Millisecond)
+	}
+	if !process.cmd.IsRunning() {
+		t.Fatal("the real child never started")
+	}
+	if stopped, err := manager.SealProcess(name); err != nil || stopped {
+		t.Fatalf("sealing acknowledged a live child: %v", err)
+	}
+	if _, err = manager.ProcessDelete(ctx, &rpc.ProcessDeleteRequest{Name: name, Uuid: result.Status.Uuid}); err != nil {
+		t.Fatal(err)
+	}
+	for ctx.Err() == nil {
+		stopped, err := manager.SealProcess(name)
+		if err != nil {
+			t.Fatal(err)
+		}
+		if stopped {
+			return
+		}
+		time.Sleep(time.Millisecond)
+	}
+	t.Fatal("the manager never observed the native child exit")
+}
+
+func TestProcessSealSurvivesAnotherManagerEpoch(t *testing.T) {
+	ctx, cancel := context.WithTimeout(t.Context(), 5*time.Second)
+	defer cancel()
+	shared := t.TempDir()
+	if err := os.Chmod(shared, 0o700); err != nil {
+		t.Fatal(err)
+	}
+	makeManager := func() *Manager {
+		t.Helper()
+		manager, err := NewManager(ctx, "30000-30010", t.TempDir())
+		if err != nil {
+			t.Fatal(err)
+		}
+		if err = manager.EnableDurableRetirement(shared); err != nil {
+			t.Fatal(err)
+		}
+		manager.Executor = &MockExecutor{CreationHook: func(*MockCommand) (*MockCommand, error) {
+			return nil, errors.New("fixture must finish without a child")
+		}}
+		return manager
+	}
+	original := makeManager()
+	peer := makeManager()
+	const name = "fixture-e-0"
+	if done, err := original.SealProcess(name); err != nil || !done {
+		t.Fatalf("initial seal failed: %v", err)
+	}
+	for _, manager := range []*Manager{peer, makeManager()} {
+		if _, err := manager.ProcessCreate(ctx, &rpc.ProcessCreateRequest{
+			Spec: &rpc.ProcessSpec{Name: name, Binary: "fixture"},
+		}); err == nil {
+			t.Fatal("another manager epoch started the sealed name")
+		}
+	}
+	if _, err := peer.ProcessCreate(ctx, &rpc.ProcessCreateRequest{
+		Spec: &rpc.ProcessSpec{Name: "unrelated-e-0", Binary: "fixture"},
+	}); err != nil {
+		t.Fatalf("durable seal affected an unrelated name: %v", err)
+	}
+}
+
+func TestSealedNameWaitsForReplacementChild(t *testing.T) {
+	ctx, cancel := context.WithTimeout(t.Context(), 8*time.Second)
+	defer cancel()
+	manager, err := NewManager(ctx, "30000-30010", t.TempDir())
+	if err != nil {
+		t.Fatal(err)
+	}
+	const name = "fixture-e-0"
+	if _, err = manager.ProcessCreate(ctx, &rpc.ProcessCreateRequest{
+		Spec: &rpc.ProcessSpec{Name: name, Binary: "sleep", Args: []string{"30"}},
+	}); err != nil {
+		t.Fatal(err)
+	}
+	original := manager.findProcess(name)
+	t.Cleanup(original.Stop)
+	for !original.cmd.IsRunning() && ctx.Err() == nil {
+		time.Sleep(time.Millisecond)
+	}
+	if !original.cmd.IsRunning() {
+		t.Fatal("original process never started")
+	}
+
+	native, err := NewBinaryCommand("sleep", "30")
+	if err != nil {
+		t.Fatal(err)
+	}
+	delayed := &delayedBinary{BinaryCommand: native, entered: make(chan struct{}), release: make(chan struct{}), exited: make(chan struct{})}
+	release := sync.OnceFunc(func() { close(delayed.release) })
+	defer release()
+	manager.Executor = delayedExecutor{command: delayed}
+	result := make(chan error, 1)
+	go func() {
+		_, err := manager.ProcessReplace(ctx, &rpc.ProcessReplaceRequest{
+			Spec:            &rpc.ProcessSpec{Name: name, Binary: "fixture-replacement"},
+			TerminateSignal: "SIGHUP",
+		})
+		result <- err
+	}()
+	select {
+	case <-delayed.entered:
+	case <-ctx.Done():
+		t.Fatal("replacement never reached its delayed native start")
+	}
+	if complete, err := manager.SealProcess(name); err != nil || complete {
+		t.Fatalf("sealing acknowledged an in-flight replacement: %v", err)
+	}
+	select {
+	case err := <-result:
+		if err != nil {
+			t.Fatal(err)
+		}
+	case <-ctx.Done():
+		t.Fatal("replacement did not reach its terminal API response")
+	}
+	select {
+	case <-original.commandDone:
+	case <-ctx.Done():
+		t.Fatal("original child did not exit")
+	}
+	if complete, err := manager.SealProcess(name); err != nil || complete {
+		t.Fatalf("sealing ignored the replacement command that can still run: %v", err)
+	}
+
+	replacement := manager.findProcess(name)
+	t.Cleanup(replacement.Stop)
+	release()
+	for !native.IsRunning() && ctx.Err() == nil {
+		time.Sleep(time.Millisecond)
+	}
+	if !native.IsRunning() {
+		t.Fatal("native replacement did not start")
+	}
+	if _, err = manager.ProcessDelete(ctx, &rpc.ProcessDeleteRequest{Name: name, Uuid: replacement.UUID}); err != nil {
+		t.Fatal(err)
+	}
+	for ctx.Err() == nil {
+		complete, err := manager.SealProcess(name)
+		if err != nil {
+			t.Fatal(err)
+		}
+		if complete {
+			return
+		}
+		time.Sleep(time.Millisecond)
+	}
+	t.Fatal("the seal did not observe the replacement exit")
+}
diff --git a/pkg/process/retirement_process_test.go b/pkg/process/retirement_process_test.go
new file mode 100644
index 0000000..2419514
--- /dev/null
+++ b/pkg/process/retirement_process_test.go
@@ -0,0 +1,76 @@
+package process
+
+import (
+	"errors"
+	"os"
+	"path/filepath"
+	"sync"
+	"testing"
+	"time"
+
+	"github.com/longhorn/longhorn-instance-manager/pkg/util"
+)
+
+type delayedBinary struct {
+	*BinaryCommand
+	entered, release, exited chan struct{}
+}
+
+func (c *delayedBinary) Run() error {
+	close(c.entered)
+	<-c.release
+	defer close(c.exited)
+	return c.BinaryCommand.Run()
+}
+
+type delayedExecutor struct{ command *delayedBinary }
+
+func (e delayedExecutor) NewCommand(string, ...string) (Command, error) {
+	return e.command, nil
+}
+
+func TestStoppedProcessCannotLaunchDelayedChild(t *testing.T) {
+	dir := t.TempDir()
+	marker := filepath.Join(dir, "started")
+	command, err := NewBinaryCommand("sh", "-c", "printf started > \"$1\"", "sh", marker)
+	if err != nil {
+		t.Fatal(err)
+	}
+	delayed := &delayedBinary{BinaryCommand: command, entered: make(chan struct{}), release: make(chan struct{}), exited: make(chan struct{})}
+	release := sync.OnceFunc(func() { close(delayed.release) })
+	defer release()
+	logger, err := util.NewLonghornWriter("fixture", dir)
+	if err != nil {
+		t.Fatal(err)
+	}
+	process := &Process{State: StateStarting, Name: "fixture", lock: &sync.RWMutex{}, UpdateCh: make(chan *Process, 8),
+		logger: logger, executor: delayedExecutor{command: delayed}}
+	if err = process.Start(); err != nil {
+		t.Fatal(err)
+	}
+	select {
+	case <-delayed.entered:
+	case <-time.After(2 * time.Second):
+		t.Fatal("native command never reached its delayed start point")
+	}
+	process.Stop()
+	deadline := time.Now().Add(2 * time.Second)
+	for !process.IsStopped() && time.Now().Before(deadline) {
+		time.Sleep(time.Millisecond)
+	}
+	if !process.IsStopped() {
+		t.Fatal("stop never reached a terminal state")
+	}
+	release()
+	select {
+	case <-delayed.exited:
+	case <-time.After(2 * time.Second):
+		t.Fatal("delayed native command did not return")
+	}
+	if _, err = os.Stat(marker); !errors.Is(err, os.ErrNotExist) {
+		t.Fatal("the native child started after the owning process stopped")
+	}
+	if err = process.Start(); err == nil {
+		t.Fatal("the same stopped process accepted another start")
+	}
+}
