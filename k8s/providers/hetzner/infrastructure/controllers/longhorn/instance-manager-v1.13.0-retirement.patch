diff --git a/pkg/process/retirement.go b/pkg/process/retirement.go
new file mode 100644
index 0000000..0f64836
--- /dev/null
+++ b/pkg/process/retirement.go
@@ -0,0 +1,165 @@
+package process
+
+import (
+	"errors"
+	"os"
+	"regexp"
+	"syscall"
+
+	"google.golang.org/grpc/codes"
+	"google.golang.org/grpc/status"
+)
+
+var validRetirementName = regexp.MustCompile(`^[a-z0-9]([-a-z0-9.]*[a-z0-9])?$`)
+
+type processRetirement struct {
+	starting int
+	children int
+	sealed   bool
+}
+
+// SealProcess blocks further creates and replacements of this exact name in
+// this manager epoch. The caller can proceed only once all previously
+// admitted operations and their actual child commands have returned.
+func (pm *Manager) SealProcess(name string) (bool, error) {
+	if len(name) > 253 || !validRetirementName.MatchString(name) {
+		return false, status.Error(codes.InvalidArgument, "invalid process name")
+	}
+	pm.lock.Lock()
+	defer pm.lock.Unlock()
+	r := pm.retirementEntry(name)
+	r.sealed = true
+	if err := pm.persistRetirement(name); err != nil {
+		return false, status.Error(codes.FailedPrecondition, "process retirement is not durable")
+	}
+	return r.starting == 0 && r.children == 0, nil
+}
+
+// EnableDurableRetirement binds the seals to an owner-only directory before
+// the manager begins accepting requests.
+func (pm *Manager) EnableDurableRetirement(directory string) error {
+	info, err := os.Lstat(directory)
+	if err != nil || !info.IsDir() || info.Mode().Perm() != 0o700 {
+		return errors.New("retirement requires an owner-only directory")
+	}
+	owner, ok := info.Sys().(*syscall.Stat_t)
+	if !ok || owner.Uid != uint32(os.Geteuid()) {
+		return errors.New("retirement directory owner is not the manager")
+	}
+	root, err := os.OpenRoot(directory)
+	if err != nil {
+		return err
+	}
+	current, err := root.Stat(".")
+	if err != nil || !os.SameFile(info, current) {
+		return errors.Join(errors.New("retirement directory identity changed"), root.Close())
+	}
+	pm.lock.Lock()
+	defer pm.lock.Unlock()
+	if pm.retirementRoot != nil || len(pm.retirement) != 0 {
+		return errors.Join(errors.New("retirement directory must be configured before processing requests"), root.Close())
+	}
+	pm.retirementRoot = root
+	return nil
+}
+
+func (pm *Manager) storedRetirement(name string) (bool, error) {
+	if pm.retirementRoot == nil || len(name) > 253 || !validRetirementName.MatchString(name) {
+		return false, nil
+	}
+	info, err := pm.retirementRoot.Lstat(name)
+	if errors.Is(err, os.ErrNotExist) {
+		return false, nil
+	}
+	if err != nil || !info.Mode().IsRegular() || info.Mode().Perm() != 0o600 || info.Size() != 0 {
+		return false, errors.New("stored process retirement could not be verified")
+	}
+	return true, nil
+}
+
+func (pm *Manager) persistRetirement(name string) error {
+	if pm.retirementRoot == nil {
+		return nil
+	}
+	file, err := pm.retirementRoot.OpenFile(name, os.O_WRONLY|os.O_CREATE|os.O_EXCL, 0o600)
+	if errors.Is(err, os.ErrExist) {
+		stored, readErr := pm.storedRetirement(name)
+		if readErr != nil || !stored {
+			return errors.New("previous process retirement could not be verified")
+		}
+		file, err = pm.retirementRoot.Open(name)
+	}
+	if err != nil {
+		return err
+	}
+	if err = errors.Join(file.Sync(), file.Close()); err != nil {
+		return err
+	}
+	dir, err := pm.retirementRoot.Open(".")
+	if err != nil {
+		return err
+	}
+	return errors.Join(dir.Sync(), dir.Close())
+}
+
+func (pm *Manager) retirementEntry(name string) *processRetirement {
+	if pm.retirement == nil {
+		pm.retirement = make(map[string]*processRetirement)
+	}
+	r := pm.retirement[name]
+	if r == nil {
+		r = &processRetirement{}
+		pm.retirement[name] = r
+	}
+	return r
+}
+
+func (pm *Manager) beginProcessStart(name string) error {
+	pm.lock.Lock()
+	defer pm.lock.Unlock()
+	r := pm.retirementEntry(name)
+	stored, err := pm.storedRetirement(name)
+	if err != nil {
+		pm.discardRetirementEntry(name, r)
+		return status.Error(codes.FailedPrecondition, "process retirement state cannot be read")
+	}
+	if r.sealed || stored {
+		r.sealed = true
+		return status.Error(codes.FailedPrecondition, "process name is sealed for retirement")
+	}
+	r.starting++
+	return nil
+}
+
+func (pm *Manager) finishProcessStart(name string, p *Process) {
+	var done <-chan struct{}
+	if p != nil {
+		p.lock.RLock()
+		done = p.commandDone
+		p.lock.RUnlock()
+	}
+	pm.lock.Lock()
+	defer pm.lock.Unlock()
+	r := pm.retirement[name]
+	r.starting--
+	if done != nil {
+		r.children++
+		go pm.observeProcessExit(name, done)
+	}
+	pm.discardRetirementEntry(name, r)
+}
+
+func (pm *Manager) observeProcessExit(name string, done <-chan struct{}) {
+	<-done
+	pm.lock.Lock()
+	defer pm.lock.Unlock()
+	r := pm.retirement[name]
+	r.children--
+	pm.discardRetirementEntry(name, r)
+}
+
+func (pm *Manager) discardRetirementEntry(name string, r *processRetirement) {
+	if !r.sealed && r.starting == 0 && r.children == 0 {
+		delete(pm.retirement, name)
+	}
+}
diff --git a/pkg/process/retirement_command_test.go b/pkg/process/retirement_command_test.go
