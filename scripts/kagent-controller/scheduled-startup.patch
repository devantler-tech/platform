@@ -114,0 +116,11 @@ func (w *ActorWorkflow) Delete(ctx context.Context, session *apiv1.Session, forc
+// DeleteUnstarted is scheduler cleanup for a session with no accepted work.
+func (w *ActorWorkflow) DeleteUnstarted(ctx context.Context, session *apiv1.Session, lease database.ScheduledRunExecutionLease) (*apiv1.Session, error) {
+	ctx, cancel := context.WithTimeout(ctx, database.RuntimeOperationTimeout)
+	defer cancel()
+	operation, err := w.store.BeginUnstartedSessionDeletion(ctx, session.GetId(), lease)
+	if err != nil {
+		return nil, err
+	}
+	return w.execute(ctx, operation)
+}
