@@ -0,0 +1,14 @@
+package scheduling
+
+import "time"
+
+const (
+	// DispatchAttemptTimeout covers the router's cold-restore budget and
+	// admission overhead. It only bounds reconciliation before a task ID.
+	DispatchAttemptTimeout = 75 * time.Second
+	// DispatchLease reserves time to persist the result after the attempt.
+	DispatchLease = DispatchAttemptTimeout + 20*time.Second
+	// StartupTimeout lets a lost response settle before cleanup is attempted.
+	// Cleanup still checks the session's own dispatch reservation.
+	StartupTimeout = 3 * time.Minute
+)
