diff --git a/go/core/internal/database/scheduled_startup_test.go b/go/core/internal/database/scheduled_startup_test.go
new file mode 100644
index 0000000000000000000000000000000000000000..ef9ce900a791ef25d3d3eda6b75b12c04477fa91
--- /dev/null
+++ b/go/core/internal/database/scheduled_startup_test.go
@@ -0,0 +1,96 @@
+package database
+
+import (
+	"testing"
+
+	"github.com/a2aproject/a2a-go/v2/a2a"
+	"github.com/google/uuid"
+	"github.com/stretchr/testify/require"
+
+	apiv1 "github.com/kagent-dev/kagent/go/api/gen/kagent/api/v1"
+)
+
+func TestScheduledStartupCleanupFencesLateInputAndPreservesHistory(t *testing.T) {
+	db := setupTestDB(t)
+	ctx := t.Context()
+	client := NewClient(db, "public")
+	schedule, _ := createTestSchedule(t, client)
+	reserveSession := func(request string) (string, ScheduledRunExecutionLease) {
+		t.Helper()
+		execution, err := client.TriggerScheduledRun(ctx, uuid.MustParse(schedule.Id), schedule.Creator, request)
+		require.NoError(t, err)
+		leases, err := client.LeaseScheduledRunExecutions(ctx, 1)
+		require.NoError(t, err)
+		require.Len(t, leases, 1)
+		require.Equal(t, execution.Id, leases[0].Execution.Id)
+		linked, err := client.ReserveScheduledRunExecutionSession(ctx, uuid.MustParse(execution.Id), schedule.Creator)
+		require.NoError(t, err)
+		create, err := client.BeginSessionOperation(ctx, linked.SessionId, apiv1.RuntimeOperation_RUNTIME_OPERATION_CREATE, false)
+		require.NoError(t, err)
+		executor := uuid.New()
+		claimed, err := client.ClaimSessionOperation(ctx, linked.SessionId, create.ID, executor)
+		require.NoError(t, err)
+		require.True(t, claimed)
+		_, err = client.FinishSessionOperation(ctx, linked.SessionId, create.ID, executor, "actor.team", uuid.NewString(), "")
+		require.NoError(t, err)
+		_, err = client.BeginUnstartedSessionDeletion(ctx, linked.SessionId, leases[0].Lease)
+		require.ErrorIs(t, err, ErrConflict, "a pending execution is still eligible for its first dispatch")
+		require.NoError(t, client.ClaimScheduledRunDispatch(ctx, leases[0].Lease))
+		return linked.SessionId, leases[0].Lease
+	}
+
+	unused, lease := reserveSession("unused")
+	stale := lease
+	stale.Token = uuid.New()
+	_, err := client.BeginUnstartedSessionDeletion(ctx, unused, stale)
+	require.ErrorIs(t, err, ErrConflict, "an expired lease holder cannot claim cleanup")
+	dispatch := uuid.New()
+	require.NoError(t, client.ReserveSessionDispatch(ctx, unused, dispatch, "late"))
+	_, err = client.BeginUnstartedSessionDeletion(ctx, unused, lease)
+	require.Error(t, err, "a live dispatch still owns admission")
+	_, err = db.Exec(ctx, `UPDATE session SET dispatch_expires_at = clock_timestamp() - interval '1 second' WHERE id = $1`, unused)
+	require.NoError(t, err)
+
+	op, err := client.BeginUnstartedSessionDeletion(ctx, unused, lease)
+	require.NoError(t, err)
+	require.Equal(t, apiv1.RuntimeState_RUNTIME_STATE_DELETING, op.Instance.GetState())
+	_, err = client.CreateRuntimeTask(ctx, unused, taskMutationHash("late"), &a2a.Task{
+		ID: "late-task", ContextID: unused,
+		Status:  a2a.TaskStatus{State: a2a.TaskStateSubmitted},
+		History: []*a2a.Message{{ID: "late", Role: a2a.MessageRoleUser}},
+	}, dispatch.String())
+	require.Error(t, err, "cleanup must fence a late first task save")
+
+	used, usedLease := reserveSession("used")
+	task := &a2a.Task{
+		ID: "accepted-task", ContextID: used,
+		Status:  a2a.TaskStatus{State: a2a.TaskStateSubmitted},
+		History: []*a2a.Message{{ID: "accepted", Role: a2a.MessageRoleUser}},
+	}
+	_, err = client.CreateRuntimeTask(ctx, used, taskMutationHash("accepted"), task, "")
+	require.NoError(t, err)
+	task.Status.State = a2a.TaskStateCompleted
+	require.NoError(t, saveRuntimeTask(t, client, used, task, task, &SessionTaskSnapshot{
+		Atespace: "team-a", URI: "s3://snapshots/accepted", Fidelity: "SNAPSHOT_FIDELITY_VOLUMES",
+	}))
+	_, err = client.BeginUnstartedSessionDeletion(ctx, used, usedLease)
+	require.ErrorIs(t, err, ErrConflict, "a completed task still protects its session")
+	saved, err := client.GetSessionTask(ctx, used, string(task.ID), nil)
+	require.NoError(t, err)
+	require.Equal(t, a2a.TaskStateCompleted, saved.Status.State)
+}
+
+func TestScheduledStartupLeaseOutlivesColdRestoreAndResultWrite(t *testing.T) {
+	db := setupTestDB(t)
+	client := NewClient(db, "public")
+	schedule, _ := createTestSchedule(t, client)
+	execution, err := client.TriggerScheduledRun(t.Context(), uuid.MustParse(schedule.Id), schedule.Creator, "cold-start")
+	require.NoError(t, err)
+	leases, err := client.LeaseScheduledRunExecutions(t.Context(), 1)
+	require.NoError(t, err)
+	require.Len(t, leases, 1)
+	var seconds float64
+	err = db.QueryRow(t.Context(), `SELECT EXTRACT(EPOCH FROM next_attempt_at - clock_timestamp())::double precision FROM scheduled_run_execution WHERE id = $1`, execution.Id).Scan(&seconds)
+	require.NoError(t, err)
+	require.Greater(t, seconds, float64(80))
+}
diff --git a/go/core/internal/database/session_deletion.go b/go/core/internal/database/session_deletion.go
index 7b7b22dd467b2c622cac102e7661f81729c13628..e96c87919abdf669deb6d014017df0a725d609f2 100644
--- a/go/core/internal/database/session_deletion.go
+++ b/go/core/internal/database/session_deletion.go
@@ -4,0 +5 @@ import (
+	"errors"
@@ -21,0 +23,43 @@ const (
+// BeginUnstartedSessionDeletion closes dispatch admission only for a session
+// that has never accepted work. The check and deletion claim share the lock
+// used by the first task save, so a concurrent or late input cannot be lost.
+func (c *Client) BeginUnstartedSessionDeletion(ctx context.Context, sessionID string, lease ScheduledRunExecutionLease) (*SessionOperation, error) {
+	var operation *SessionOperation
+	err := c.withTx(ctx, func(tx pgx.Tx) error {
+		// Follow execution/session lock order used by session reservation.
+		_, err := queryOne(ctx, tx, `
+			SELECT true FROM scheduled_run_execution
+			WHERE id = $1 AND session_id = $2 AND lease_token = $3
+			    AND next_attempt_at > clock_timestamp() AND task_id IS NULL
+			    AND state = 'SCHEDULED_RUN_EXECUTION_STATE_RUNNING'
+			FOR UPDATE
+		`, pgx.RowTo[bool], lease.ExecutionID, sessionID, lease.Token)
+		if err != nil {
+			if errors.Is(err, pgx.ErrNoRows) {
+				return ErrConflict
+			}
+			return err
+		}
+		row, err := lockSession(ctx, tx, sessionID)
+		if err != nil {
+			return notFoundOr(err)
+		}
+		used, err := queryOne(ctx, tx, `
+			SELECT EXISTS (SELECT 1 FROM session_task WHERE history_id = $1)
+			    OR EXISTS (SELECT 1 FROM session_task_event WHERE history_id = $1)
+			    OR EXISTS (SELECT 1 FROM session_checkpoint WHERE source_session_id = $2)
+		`, pgx.RowTo[bool], row.HistoryID, row.ID)
+		if err != nil {
+			return err
+		}
+		if used {
+			return fmt.Errorf("session has task or checkpoint history: %w", ErrConflict)
+		}
+		// Keep the tombstone, as for explicit deletion. The scheduled
+		// execution retains the reason that its startup failed.
+		operation, err = beginSessionDeletion(ctx, tx, row, sessionDeletionUserRequested, false)
+		return err
+	})
+	return operation, err
+}
+
