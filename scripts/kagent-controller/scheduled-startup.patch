index 0000000000000000000000000000000000000000..1efe70de91bb0ff360daabfbd7ae9fe50b305e89
--- /dev/null
+++ b/go/core/internal/controller/scheduledrun/startup_test.go
@@ -0,0 +1,196 @@
+package scheduledrun
+
+import (
+	"context"
+	"errors"
+	"iter"
+	"testing"
+	"testing/synctest"
+	"time"
+
+	a2a "github.com/a2aproject/a2a-go/v2/a2a"
+	"github.com/stretchr/testify/require"
+	"google.golang.org/protobuf/types/known/timestamppb"
+
+	apiv1 "github.com/kagent-dev/kagent/go/api/gen/kagent/api/v1"
+	"github.com/kagent-dev/kagent/go/core/internal/database"
+	"github.com/kagent-dev/kagent/go/core/internal/scheduling"
+	sessionsvc "github.com/kagent-dev/kagent/go/core/internal/service/session"
+)
+
+type startupGateway struct {
+	taskLookupGateway
+	delay time.Duration
+	err   error
+	sends int
+}
+
+func (g *startupGateway) SendStreamingMessage(ctx context.Context, _ *a2a.SendMessageRequest) iter.Seq2[a2a.Event, error] {
+	return func(yield func(a2a.Event, error) bool) {
+		g.sends++
+		timer := time.NewTimer(g.delay)
+		defer timer.Stop()
+		select {
+		case <-ctx.Done():
+			yield(nil, ctx.Err())
+		case <-timer.C:
+			if g.err != nil {
+				yield(nil, g.err)
+				return
+			}
+			yield(&a2a.Task{ID: "accepted-task", Status: a2a.TaskStatus{State: a2a.TaskStateWorking}}, nil)
+		}
+	}
+}
+
+type startupStore struct {
+	scopedControllerStore
+	execution *apiv1.ScheduledRunExecution
+	progress  database.ScheduledRunExecutionProgress
+}
+
+func (s *startupStore) LeaseScheduledRunExecutions(context.Context, int) ([]database.LeasedScheduledRunExecution, error) {
+	return []database.LeasedScheduledRunExecution{{Execution: s.execution}}, nil
+}
+
+func (s *startupStore) UpdateScheduledRunExecution(_ context.Context, _ database.ScheduledRunExecutionLease, progress database.ScheduledRunExecutionProgress) error {
+	s.progress = progress
+	return nil
+}
+
+type startupCleanup struct {
+	controllerTestCleanup
+	calls int
+	err   error
+}
+
+func (w *startupCleanup) DeleteUnstarted(_ context.Context, session *apiv1.Session, _ database.ScheduledRunExecutionLease) (*apiv1.Session, error) {
+	w.calls++
+	return session, w.err
+}
+
+func newStartupTest() (*startupStore, *startupGateway, *startupCleanup) {
+	store := &startupStore{
+		scopedControllerStore: scopedControllerStore{session: &apiv1.Session{
+			Id: "session", State: apiv1.RuntimeState_RUNTIME_STATE_READY,
+			Operation: apiv1.RuntimeOperation_RUNTIME_OPERATION_NONE,
+			CreatedAt: timestamppb.Now(),
+		}},
+		execution: &apiv1.ScheduledRunExecution{
+			Id: "execution", Creator: "owner", SessionId: "session", Prompt: "maintenance",
+			State:     apiv1.ScheduledRunExecutionState_SCHEDULED_RUN_EXECUTION_STATE_PENDING,
+			CreatedAt: timestamppb.Now(),
+			Deadline:  timestamppb.New(time.Now().Add(24 * time.Hour)),
+		},
+	}
+	gateway := &startupGateway{taskLookupGateway: taskLookupGateway{
+		listTasks: func(*a2a.ListTasksRequest) (*a2a.ListTasksResponse, error) {
+			return &a2a.ListTasksResponse{}, nil
+		},
+	}}
+	return store, gateway, &startupCleanup{}
+}
+
+func TestScheduledColdStartHasTimeToAcceptTask(t *testing.T) {
+	synctest.Test(t, func(t *testing.T) {
+		store, gateway, workflow := newStartupTest()
+		gateway.delay = 19 * time.Second
+		c := NewController(store, workflow, gateway, time.Second)
+
+		require.NoError(t, c.tick(t.Context()))
+		require.Equal(t, "accepted-task", store.progress.TaskID)
+		require.Equal(t, apiv1.ScheduledRunExecutionState_SCHEDULED_RUN_EXECUTION_STATE_RUNNING, store.progress.State)
+		require.Zero(t, workflow.calls)
+		require.Equal(t, 1, gateway.sends)
+	})
+}
+
+func TestScheduledPendingExecutionStillDispatchesAfterQueueDelay(t *testing.T) {
+	synctest.Test(t, func(t *testing.T) {
+		store, gateway, workflow := newStartupTest()
+		store.execution.CreatedAt = timestamppb.New(time.Now().Add(-time.Hour))
+		store.session.CreatedAt = timestamppb.New(time.Now().Add(-time.Hour))
+		gateway.delay = 19 * time.Second
+		c := NewController(store, workflow, gateway, time.Second)
+
+		require.NoError(t, c.tick(t.Context()))
+		require.Equal(t, "accepted-task", store.progress.TaskID)
+		require.Equal(t, 1, gateway.sends)
+		require.Zero(t, workflow.calls)
+	})
+}
+
+func TestScheduledQueueDelayDoesNotExpireNewlyReservedRuntime(t *testing.T) {
+	store, gateway, workflow := newStartupTest()
+	store.execution.CreatedAt = timestamppb.New(time.Now().Add(-time.Hour))
+	gateway.err = errors.New("response lost")
+	c := NewController(store, workflow, gateway, time.Second)
+	lease := database.LeasedScheduledRunExecution{Execution: store.execution}
+
+	require.ErrorIs(t, c.reconcile(t.Context(), lease), gateway.err)
+	require.NoError(t, c.reconcile(t.Context(), lease))
+	require.Equal(t, apiv1.ScheduledRunExecutionState_SCHEDULED_RUN_EXECUTION_STATE_RUNNING, lease.Execution.GetState())
+	require.Equal(t, 1, gateway.sends)
+	require.Zero(t, workflow.calls)
+}
+
+func TestScheduledRefusalReclaimsWorkerWithoutResending(t *testing.T) {
+	store, gateway, workflow := newStartupTest()
+	gateway.err = sessionsvc.ErrSendNotAccepted
+	workflow.err = database.ErrConflict
+	c := NewController(store, workflow, gateway, time.Second)
+	lease := database.LeasedScheduledRunExecution{Execution: store.execution}
+
+	require.Error(t, c.reconcile(t.Context(), lease))
+	require.NotEmpty(t, lease.Execution.GetFailureReason())
+	require.ErrorIs(t, c.reconcile(t.Context(), lease), database.ErrConflict)
+	workflow.err = nil
+	require.NoError(t, c.reconcile(t.Context(), lease))
+	require.Equal(t, apiv1.ScheduledRunExecutionState_SCHEDULED_RUN_EXECUTION_STATE_FAILED, lease.Execution.GetState())
+	require.Empty(t, lease.Execution.GetTaskId())
+	require.Equal(t, 2, workflow.calls)
+	require.Equal(t, 1, gateway.sends)
+}
+
+func TestScheduledAmbiguousStartWaitsForFencedCleanup(t *testing.T) {
+	store, gateway, workflow := newStartupTest()
+	gateway.err = errors.New("response lost")
+	c := NewController(store, workflow, gateway, time.Second)
+	lease := database.LeasedScheduledRunExecution{Execution: store.execution}
+
+	require.ErrorIs(t, c.reconcile(t.Context(), lease), gateway.err)
+	require.NoError(t, c.reconcile(t.Context(), lease))
+	require.Zero(t, workflow.calls)
+	require.Equal(t, apiv1.ScheduledRunExecutionState_SCHEDULED_RUN_EXECUTION_STATE_RUNNING, lease.Execution.GetState())
+
+	store.session.CreatedAt = timestamppb.New(time.Now().Add(-5 * time.Minute))
+	workflow.err = database.ErrConflict
+	require.ErrorIs(t, c.reconcile(t.Context(), lease), database.ErrConflict)
+	require.Equal(t, apiv1.ScheduledRunExecutionState_SCHEDULED_RUN_EXECUTION_STATE_RUNNING, lease.Execution.GetState())
+	workflow.err = nil
+	require.NoError(t, c.reconcile(t.Context(), lease))
+	require.Equal(t, apiv1.ScheduledRunExecutionState_SCHEDULED_RUN_EXECUTION_STATE_FAILED, lease.Execution.GetState())
+	require.Equal(t, 1, gateway.sends)
+}
+
+func TestScheduledAcceptedHistoryWinsAfterStartupDeadline(t *testing.T) {
+	store, gateway, workflow := newStartupTest()
+	gateway.err = errors.New("response lost")
+	c := NewController(store, workflow, gateway, time.Second)
+	lease := database.LeasedScheduledRunExecution{Execution: store.execution}
+	require.ErrorIs(t, c.reconcile(t.Context(), lease), gateway.err)
+
+	store.session.CreatedAt = timestamppb.New(time.Now().Add(-5 * time.Minute))
+	gateway.listTasks = func(*a2a.ListTasksRequest) (*a2a.ListTasksResponse, error) {
+		return &a2a.ListTasksResponse{Tasks: []*a2a.Task{{
+			ID:      "recovered-task",
+			Status:  a2a.TaskStatus{State: a2a.TaskStateWorking},
+			History: []*a2a.Message{{ID: scheduling.MessageIDPrefix + "execution"}},
+		}}}, nil
+	}
+	require.NoError(t, c.reconcile(t.Context(), lease))
+	require.Equal(t, "recovered-task", lease.Execution.GetTaskId())
+	require.Equal(t, apiv1.ScheduledRunExecutionState_SCHEDULED_RUN_EXECUTION_STATE_RUNNING, lease.Execution.GetState())
+	require.Zero(t, workflow.calls)
+	require.Equal(t, 1, gateway.sends)
+}
