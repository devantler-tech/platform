FROM debian:trixie-slim@sha256:7378260c0a098d27ac206225db5e7d92b8c7c84ea7afccc86eeb513756bbd392

# Stream the mailbox without a second full archive. The upstream program and
# licence are checksum-pinned to imapsync 2.314 at its reviewed source revision.
RUN apt-get update && apt-get install --no-install-recommends -y \
    ca-certificates libauthen-ntlm-perl libcrypt-openssl-pkcs12-perl \
    libcrypt-openssl-rsa-perl libdata-uniqid-perl libdigest-hmac-perl \
    libencode-imaputf7-perl libfile-copy-recursive-perl libfile-tail-perl \
    libio-compress-perl libio-socket-ssl-perl libio-tee-perl libjson-webtoken-perl \
    libmail-imapclient-perl libreadonly-perl libregexp-common-perl \
    libsys-meminfo-perl libterm-readkey-perl libtest-deep-perl \
    libtest-mockobject-perl libtest-pod-perl libunicode-string-perl liburi-perl \
    libwww-perl procps && rm -rf /var/lib/apt/lists/*
# checkov:skip=CKV_DOCKER_4:ADD verifies the checksum of one pinned upstream file; COPY cannot fetch it.
ADD --chmod=0555 --checksum=sha256:89faed96f7c389723ddd7e78a00421b90d5b85bf79407fcf1b11209f3d4d7416 https://raw.githubusercontent.com/imapsync/imapsync/8895966244fb161cc68f2c8427a8f6326a7f2ab0/imapsync /usr/local/bin/imapsync
# checkov:skip=CKV_DOCKER_4:ADD verifies the checksum of the pinned upstream licence.
ADD --chmod=0444 --checksum=sha256:ff6c1f3ae704d82872e86dd19275e03bfb61a2c9ce5835b6d6989910d88635cf https://raw.githubusercontent.com/imapsync/imapsync/8895966244fb161cc68f2c8427a8f6326a7f2ab0/LICENSE /usr/local/share/licenses/imapsync/LICENSE
COPY --chmod=0555 private-mail-bootstrap /usr/local/bin/private-mail-bootstrap
RUN test "$(imapsync --version)" = 2.314
USER 2000:2000
ENV HOME=/tmp
WORKDIR /tmp
HEALTHCHECK NONE
ENTRYPOINT ["/usr/local/bin/private-mail-bootstrap", "history"]
