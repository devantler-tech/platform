{
  "apiVersion": "cilium.io/v2",
  "kind": "CiliumNetworkPolicy",
  "metadata": {
    "name": "allow-dns",
    "namespace": "longhorn-db-proof-umami-db-1234",
    "uid": "22222222-2222-4222-8222-222222222222"
  },
  "spec": {
    "endpointSelector": {},
    "egress": [
      {
        "toEndpoints": [
          {
            "matchLabels": {
              "k8s:io.kubernetes.pod.namespace": "kube-system",
              "k8s-app": "kube-dns"
            }
          }
        ],
        "toPorts": [
          {
            "ports": [
              {
                "port": "53",
                "protocol": "UDP"
              },
              {
                "port": "53",
                "protocol": "TCP"
              }
            ]
          }
        ]
      }
    ]
  }
}
