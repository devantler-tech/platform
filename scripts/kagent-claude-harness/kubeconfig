# The platform cluster, read-only, through the lane's cluster-reader proxy
# (k8s/providers/hetzner/apps/agentic-engineer/deployment-cluster-reader.yaml). The proxy holds the
# identity, so there is no credential here. Its one context targets the cluster named prod, which
# is how the engineer's prod-kube-context.sh recognises the platform cluster.
apiVersion: v1
kind: Config
clusters:
  - name: prod
    cluster:
      server: http://cluster-reader.agentic-engineer.svc.cluster.local:8001
users:
  - name: cluster-reader
    user: {}
contexts:
  - name: cluster-reader@prod
    context:
      cluster: prod
      user: cluster-reader
current-context: cluster-reader@prod
